  "skchr_amiya3_2": {
    "skillId": "skchr_amiya3_2",
    "iconId": null,
    "hidden": false,
    "levels": [
      {
        "name": "慈悲愿景",
        "rangeId": null,
        "description": "立刻对攻击范围内所有敌人造成进行一次攻击力为<@ba.vup>{atk_scale:0%}</>的攻击并使目标在<@ba.vup>{amiya3_s_2[debuff].duration}</>秒内攻击速度<@ba.vup>{amiya3_s_2[debuff].attack_speed}</>，移动速度<@ba.vup>{amiya3_s_2[debuff].move_speed:0%}</>，该次攻击每击中一个敌人获得攻击力<@ba.vup>+{atk:0%}</>（最多叠加<@ba.vup>{max_stack_cnt}</>次），接下来的伤害类型变为<@ba.vup>真实</>且可以同时攻击<@ba.vup>2</>名敌人；<@ba.rem>整场战斗中该技能只能释放一次</>",
