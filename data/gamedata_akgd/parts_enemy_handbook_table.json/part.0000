    "enemy_10148_nsmos": {
      "enemyId": "enemy_10148_nsmos",
      "enemyIndex": "AS05",
      "enemyTags": null,
      "sortId": 1099,
      "name": "啸天吸尘器",
      "enemyLevel": "NORMAL",
      "description": "其他家用电器飞起来或许没什么意义，但会飞的吸尘器绝对是划时代的发明。现在，它连天花板都能吸了。\n小心！如果它从你头顶掠过的时候吸住了你的头发，请立刻按照说明书自救！",
      "attackType": null,
      "ability": null,
