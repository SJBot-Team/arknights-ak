    "enemy_10149_nscan": {
      "enemyId": "enemy_10149_nscan",
      "enemyIndex": "AS07",
      "enemyTags": null,
      "sortId": 1101,
      "name": "掀天汽水桶",
      "enemyLevel": "ELITE",
      "description": "以飞天为卖点的汽水桶，在上市的第三天就因太过危险而被烟酒施术单元以及源石制品管理局取缔。\n或许日后，在哥伦比亚航空航天博物馆里，会有一顶被洞穿的帽子，用以证明飞行技术的发展曾误入怎样的歧途。\n",
      "attackType": null,
      "ability": null,
      "isInvalidKilled": false,
      "overrideKillCntInfos": {},
      "hideInHandbook": false,
      "hideInStage": true,
      "abilityList": [
        {
          "text": "飞行单位",
          "textFormat": "NORMAL"
        },
        {
          "text": "移动时逐渐加速，但会持续损失生命，被阻挡后的首次攻击造成基于移动速度的额外伤害，并吹走目标所在地块的热气球和强力热气球",
          "textFormat": "NORMAL"
        }
      ],
      "linkEnemies": [],
