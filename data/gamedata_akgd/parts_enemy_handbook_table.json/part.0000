    "enemy_10151_nspace": {
      "enemyId": "enemy_10151_nspace",
      "enemyIndex": "AS11",
      "enemyTags": null,
      "sortId": 1105,
      "name": "行天卫生间",
      "enemyLevel": "ELITE",
      "description": "如果一间移动设施能避开车流，在任何交通情况下都能及时抵达客户面前，它最该承载什么功能？\n沃尔沃特科钦斯基行天卫生间，给出了仅生产半个月就停产的灾难性答案。再怎么说，花五百金券呼叫卫生间，还是太奢侈了。",
      "attackType": null,
      "ability": null,
      "isInvalidKilled": false,
      "overrideKillCntInfos": {},
