    "enemy_10150_nsheat": {
      "enemyId": "enemy_10150_nsheat",
      "enemyIndex": "AS09",
      "enemyTags": null,
      "sortId": 1103,
      "name": "炙烤螺旋桨",
      "enemyLevel": "ELITE",
      "description": "“螺旋桨天堂”大量采用的浮空动力装置，动力强劲，浮空稳定，性能十分优秀。\n但它的散热实在是太差了。装载了它的浮空平台，一年四季都热得像盛夏。\n",
      "attackType": null,
      "ability": null,
      "isInvalidKilled": false,
      "overrideKillCntInfos": {},
      "hideInHandbook": false,
      "hideInStage": true,
      "abilityList": [
