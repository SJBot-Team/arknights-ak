    "enemy_10151_nspace_2": {
      "enemyId": "enemy_10151_nspace_2",
      "enemyIndex": "AS12",
      "enemyTags": null,
      "sortId": 1106,
      "name": "行天救护车",
      "enemyLevel": "ELITE",
      "description": "沃尔沃特科钦斯基的研发部门痛定思痛，将失败的行天卫生间改造为了救护车。\n他们的发明还是早了时代一步，“螺旋桨天堂”之外可不是到处都有停机坪的。再怎么说，用钳子把病人抓进舱内，还是太粗暴了。",
