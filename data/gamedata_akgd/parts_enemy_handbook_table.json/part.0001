    "enemy_6027_bqthie": {
      "enemyId": "enemy_6027_bqthie",
      "enemyIndex": "DL27",
      "enemyTags": null,
      "sortId": 1606,
      "name": "飞檐客-叶无轻",
      "enemyLevel": "BOSS",
      "description": "在玉门出没的轻功高手，我们还未彻底搞清楚她的最终目的，不过从她的行为举止来看，似乎是个遵守道义之人。她穿越屋檐与街巷，轻若飞羽，目光却无比锐利深沉。只可怜身如一叶，无关重轻。",
      "attackType": null,
      "ability": null,
      "isInvalidKilled": false,
      "overrideKillCntInfos": {},
      "hideInHandbook": false,
      "hideInStage": true,
      "abilityList": [
        {
          "text": "常态不移动，每隔一段时间或损失一定生命值时，使用钩爪飞行到下一个高台，飞行过程中被视作空中单位",
          "textFormat": "NORMAL"
        },
        {
          "text": "每隔一段时间，将“无可置疑的罪证”藏进我方预备区，并减少部署费用",
          "textFormat": "NORMAL"
        },
        {
          "text": "每隔一段时间，销毁一张“无可置疑的罪证”，并发动一次强力攻击",
          "textFormat": "NORMAL"
        },
        {
          "text": "每存在一张“无可置疑的罪证”，自身的攻击力提升，获得物理和法术闪避",
          "textFormat": "NORMAL"
        },
        {
          "text": "自身未被阻挡时，攻击速度大幅提升",
          "textFormat": "NORMAL"
        }
      ],
      "linkEnemies": [],
      "damageType": [
        "PHYSIC"
      ],
      "invisibleDetail": false
    },
    "enemy_6028_cosgia": {
      "enemyId": "enemy_6028_cosgia",
      "enemyIndex": "DL28",
      "enemyTags": null,
      "sortId": 1607,
      "name": "“高亢群歌”",
      "enemyLevel": "BOSS",
      "description": "已经废弃许久的“留声机”，在荒野中孤独地待了很久，直到兽群的高歌让这里再次恢复生机。多亏了音乐鉴赏家的改造，它才能够重新启动，带领兽群齐声高唱，但鉴赏家们各自独特的音乐观念和水平参差不齐的源石回路改造技术，终于还是让它的程序陷入了癫狂。",
      "attackType": null,
      "ability": null,
      "isInvalidKilled": false,
      "overrideKillCntInfos": {},
      "hideInHandbook": false,
      "hideInStage": true,
      "abilityList": [
        {
          "text": "第一形态",
          "textFormat": "TITLE"
        },
        {
          "text": "伪装成被占领的L-44“留声机”，无法被攻击",
          "textFormat": "NORMAL"
        },
        {
          "text": "特定时间起身进入第二形态，并在原地留下“留声机”底座，若伪装的L-44“留声机”被我方占领，会提前起身",
          "textFormat": "NORMAL"
        },
        {
          "text": "第二形态",
          "textFormat": "TITLE"
        },
        {
          "text": "危险等级每提升一级，获得一个能吸收物理与法术伤害的屏障",
          "textFormat": "NORMAL"
        }
      ],
      "linkEnemies": [],
      "damageType": [
        "PHYSIC"
      ],
      "invisibleDetail": false
    },
    "enemy_6029_solzac": {
      "enemyId": "enemy_6029_solzac",
      "enemyIndex": "DL29",
      "enemyTags": null,
      "sortId": 1608,
      "name": "“晨音”",
      "enemyLevel": "BOSS",
      "description": "化为器伥的编钟。其主人生前是一名乐师，去世前委托杜小姐将编钟送给自己的朋友。被盗走后，偶然受到岁相影响化作器伥。不知主人已死，想要回到主人身边而四处徘徊，摇摇晃晃发出的声响令人神伤。",
      "attackType": null,
      "ability": null,
      "isInvalidKilled": false,
      "overrideKillCntInfos": {},
      "hideInHandbook": false,
      "hideInStage": true,
      "abilityList": [
        {
          "text": "初始形态",
          "textFormat": "TITLE"
        },
        {
          "text": "每损失一定比例生命值，选择一名我方干员向其投掷<“木衣”>，<“木衣”>存在时该干员始终眩晕",
          "textFormat": "NORMAL"
        },
        {
          "text": "复活形态",
          "textFormat": "TITLE"
        },
        {
          "text": "生命值降为0后保持无敌并分裂出大量<“鸣啭”>，场上不存在<“鸣啭”>时【复活形态】结束",
          "textFormat": "NORMAL"
        },
        {
          "text": "【复活形态】结束时“晨音”生命值不为0则回到初始形态",
          "textFormat": "NORMAL"
        },
        {
          "text": "从【复活形态】回到初始形态后攻击力提升",
          "textFormat": "NORMAL"
        }
      ],
      "linkEnemies": [
        "enemy_6030_frgzac",
        "enemy_6031_visfrg"
