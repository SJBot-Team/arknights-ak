      "isInvalidKilled": false,
      "overrideKillCntInfos": {},
      "hideInHandbook": false,
      "hideInStage": true,
      "abilityList": [
        {
          "text": "被击倒后短暂消失，之后蜕变至下一形态",
          "textFormat": "NORMAL"
        },
        {
          "text": "每次蜕变依次获得：防御力提升/移动速度提升/攻击力提升且造成伤害回复生命",
          "textFormat": "NORMAL"
        },
        {
          "text": "【捕食】蜕变前对若干个其他海嗣的【残骸】进行捕食，以使自身下一阶段获得对应的【定向进化】特性，同时击倒残骸附近的我方干员并使其暂时无法再部署",
          "textFormat": "NORMAL"
        }
      ],
      "linkEnemies": [
        "enemy_1230_dsbudr_4",
        "enemy_1231_dsrunr_4",
        "enemy_1232_dssalr_4",
        "enemy_1233_dsshtr_4",
        "enemy_1234_dsubrl_4",
        "enemy_1235_dsbskr_4"
      ],
      "damageType": [
        "PHYSIC"
      ],
      "invisibleDetail": false
    },
    "enemy_1530_white": {
      "enemyId": "enemy_1530_white",
      "enemyIndex": "KRE",
      "enemyTags": null,
      "sortId": 1424,
      "name": "白垩，“尘世遗骸”",
      "enemyLevel": "BOSS",
      "description": "被源石外壳层层包裹的白垩，其外形在莱塔尼亚唤起的只有恐惧。他阻止了尘世之音吞噬他人，自己却被尘世之音所吞噬。他试图拯救在场的所有人，拯救他的方法却只剩下一种。",
      "attackType": null,
      "ability": null,
      "isInvalidKilled": false,
      "overrideKillCntInfos": {},
      "hideInHandbook": false,
      "hideInStage": true,
      "abilityList": [
        {
          "text": "攻击造成溅射伤害且被阻挡时施加<$ba.stun>晕眩</>",
          "textFormat": "NORMAL"
        },
        {
          "text": "第一形态",
          "textFormat": "TITLE"
        },
        {
          "text": "【共振过载】令重整束流造成持续伤害",
          "textFormat": "NORMAL"
        },
        {
          "text": "【虚无悲叹】依次攻击全场目标并失去大量生命值，处于重整束流上时攻击速度下降",
          "textFormat": "NORMAL"
        },
        {
          "text": "【最后的休止符】防御和法术抗性较高，首次被击倒时暂时变为友方，随后进入第二形态",
          "textFormat": "NORMAL"
        },
        {
          "text": "第二形态",
          "textFormat": "TITLE"
        },
        {
          "text": "失去防御和法术抗性加成，攻击和技能增强",
          "textFormat": "NORMAL"
        }
      ],
      "linkEnemies": [],
      "damageType": [
        "MAGIC"
      ],
      "invisibleDetail": false
    },
    "enemy_1531_bbrain": {
      "enemyId": "enemy_1531_bbrain",
      "enemyIndex": "BBR",
      "enemyTags": null,
      "sortId": 1425,
      "name": "“唤醒”",
      "enemyLevel": "BOSS",
      "description": "多萝西亲手制造的“梦境”，在这里，人们不必再忍受跋涉之苦。科技无法做到的事情，爱与希望可以。",
      "attackType": null,
      "ability": null,
      "isInvalidKilled": false,
      "overrideKillCntInfos": {},
      "hideInHandbook": false,
      "hideInStage": true,
      "abilityList": [
        {
          "text": "无法移动",
          "textFormat": "NORMAL"
        },
        {
          "text": "“唤醒”受到伤害时，将50%的伤害转移给场上其他多萝西实验体",
          "textFormat": "NORMAL"
        },
        {
          "text": "第一形态",
          "textFormat": "TITLE"
        },
        {
          "text": "每隔一段时间将自己转移至指定地块并施放【破碎愿景】，对场上所有单位造成一次巨大物理伤害，该伤害将由所有友方单位平均分摊",
          "textFormat": "NORMAL"
        },
        {
          "text": "每隔一段时间，向左右两个方向施放【旅程】，对首个击中的单位造成物理伤害",
          "textFormat": "NORMAL"
        },
        {
          "text": "第二形态",
          "textFormat": "TITLE"
        },
        {
          "text": "攻击力提升",
          "textFormat": "NORMAL"
        },
        {
          "text": "立刻激活场上所有<R系列动力装甲>",
          "textFormat": "NORMAL"
        },
        {
          "text": "【破碎愿景】还能使处于高台的单位<$ba.stun>晕眩</>",
          "textFormat": "NORMAL"
        },
        {
          "text": "“唤醒”会向周围4个方向施放【旅程】",
          "textFormat": "NORMAL"
        }
      ],
      "linkEnemies": [],
      "damageType": [
        "PHYSIC"
      ],
      "invisibleDetail": false
    },
    "enemy_1532_minima": {
      "enemyId": "enemy_1532_minima",
      "enemyIndex": "CST",
      "enemyTags": null,
      "sortId": 1426,
      "name": "“物欲拮抗者”",
      "enemyLevel": "BOSS",
      "description": "试图保护斯第奇·画布的施工用机械，误以为斯第奇即将遭受袭击。在解释原委之前，先用力量决出个高下吧。",
      "attackType": null,
      "ability": null,
      "isInvalidKilled": false,
      "overrideKillCntInfos": {},
      "hideInHandbook": false,
      "hideInStage": true,
      "abilityList": [
        {
          "text": "初始形态",
          "textFormat": "TITLE"
        },
        {
          "text": "飞行单位",
          "textFormat": "NORMAL"
        },
        {
          "text": "在场时所有机械敌人变得更强",
          "textFormat": "NORMAL"
        },
        {
          "text": "攻击会派出小无人机在一段时间内对目标持续造成法术伤害，优先攻击没有被小无人机锁定的目标",
          "textFormat": "NORMAL"
        },
        {
          "text": "周期性刷新可以抵挡物理与法术伤害的屏障，屏障存在期间攻击范围内的其他敌人获得<$ba.invisible>隐匿</>",
          "textFormat": "NORMAL"
        },
        {
          "text": "周期性锁定身边人数最多的我方单位不断对其周围造成法术伤害",
          "textFormat": "NORMAL"
        },
        {
          "text": "周期性锁定身边人数最少的我方单位不断对其周围造成<$ba.stun>晕眩</>",
          "textFormat": "NORMAL"
        },
        {
          "text": "生命值降为0时，斯第奇会出现",
          "textFormat": "NORMAL"
        },
        {
          "text": "斯第奇形态",
          "textFormat": "TITLE"
        },
        {
          "text": "出场时<$ba.stun>晕眩</>一段时间",
          "textFormat": "NORMAL"
        },
        {
          "text": "不进行攻击，无法被阻挡",
          "textFormat": "NORMAL"
        }
      ],
      "linkEnemies": [],
      "damageType": [
        "MAGIC"
      ],
      "invisibleDetail": false
    },
    "enemy_1533_stmkgt": {
      "enemyId": "enemy_1533_stmkgt",
      "enemyIndex": "LYN",
      "enemyTags": null,
      "sortId": 1427,
      "name": "“最后的蒸汽骑士”",
      "enemyLevel": "BOSS",
      "description": "蒸汽骑士是维多利亚的荣耀，代表着维多利亚的最强战力和授予士兵的最高荣誉。最后一位蒸汽骑士于尘封的废墟中站起，为守护他心中的维多利亚而发起冲锋。",
      "attackType": null,
      "ability": null,
      "isInvalidKilled": false,
      "overrideKillCntInfos": {},
      "hideInHandbook": false,
      "hideInStage": true,
      "abilityList": [
        {
          "text": "出场阶段",
          "textFormat": "TITLE"
        },
        {
          "text": "攻击和移动速度降低，释放【蒸汽增压】后解除",
          "textFormat": "NORMAL"
        },
        {
          "text": "第一形态",
          "textFormat": "TITLE"
        },
        {
          "text": "【蒸汽增压】攻击和移动速度提升，且免疫控制，结束时<$ba.stun>晕眩</>",
          "textFormat": "NORMAL"
        },
        {
          "text": "【怒守】蓄力攻击，造成更高的三次伤害",
          "textFormat": "NORMAL"
        },
        {
          "text": "【誓死】每损失一定生命值后起飞，锁定我方生命上限最高的单位，对其周围生命比例最高的单位造成多次法术伤害",
          "textFormat": "NORMAL"
        },
        {
          "text": "第二形态",
          "textFormat": "TITLE"
        },
        {
          "text": "防御和法术抗性降低",
          "textFormat": "NORMAL"
        },
        {
          "text": "永久处于【蒸汽增压】",
          "textFormat": "NORMAL"
        },
        {
          "text": "【誓死】额外锁定一个目标",
          "textFormat": "NORMAL"
        }
      ],
      "linkEnemies": [],
      "damageType": [
        "PHYSIC"
      ],
      "invisibleDetail": false
    },
    "enemy_1535_wlfmster": {
      "enemyId": "enemy_1535_wlfmster",
      "enemyIndex": "ZA",
      "enemyTags": null,
      "sortId": 1428,
      "name": "扎罗，“狼之主”",
      "enemyLevel": "BOSS",
      "description": "狼之主，自荒野中诞生，却将目光投向人世。自视甚高，机关算尽，然功亏一篑，满盘皆输。如今，该有人承受他的怒火了。",
      "attackType": null,
      "ability": null,
      "isInvalidKilled": false,
      "overrideKillCntInfos": {},
      "hideInHandbook": false,
      "hideInStage": true,
      "abilityList": [
        {
          "text": "使血债账款逐渐增加",
          "textFormat": "NORMAL"
        },
        {
          "text": "第一形态",
          "textFormat": "TITLE"
        },
        {
          "text": "受到伤害降低，不可被<$ba.stun>晕眩</>",
          "textFormat": "NORMAL"
        },
        {
          "text": "【溶血骇惧】使三名我方单位被恐惧吞噬，不可主动撤退，攻速大幅降低，并逐渐加速失去生命值；受影响单位在“狼之主”损失一定比例生命时，会恢复正常",
          "textFormat": "NORMAL"
        },
        {
          "text": "第一形态生命值降为0后，获得【远古威慑】，周围我方单位降低攻击速度，并缓慢回复生命值",
          "textFormat": "NORMAL"
        },
        {
          "text": "第二形态",
          "textFormat": "TITLE"
        },
        {
          "text": "不再拥有减伤，且不再释放【溶血骇惧】",
          "textFormat": "NORMAL"
        },
        {
          "text": "攻击变为远程二连击，且攻击力提升",
          "textFormat": "NORMAL"
        },
        {
          "text": "每隔一段时间释放，【狂暴怒嗥】，使血债账款快速上升",
          "textFormat": "NORMAL"
        }
      ],
      "linkEnemies": [],
      "damageType": [
        "PHYSIC"
      ],
      "invisibleDetail": false
    },
    "enemy_1536_ncrmcr": {
      "enemyId": "enemy_1536_ncrmcr",
      "enemyIndex": "EB",
      "enemyTags": null,
      "sortId": 1429,
      "name": "“领袖”",
      "enemyLevel": "BOSS",
      "description": "深池的“领袖”，焚烧生命的德拉克，一个令人恐惧的影子。不要被她困住。",
      "attackType": null,
      "ability": null,
      "isInvalidKilled": false,
      "overrideKillCntInfos": {},
      "hideInHandbook": false,
      "hideInStage": true,
      "abilityList": [
        {
          "text": "【新生】在场时，部分敌人被击倒后会变为<余烬>继续作战",
          "textFormat": "NORMAL"
        },
        {
          "text": "第一形态",
          "textFormat": "TITLE"
        },
        {
          "text": "【主宰】对一名目标释放焦竭之火，使其无法攻击、释放技能，焦竭之火消逝或附着目标撤退时对十字范围内所有我方单位造成法术伤害与<$ba.dt.burning>灼燃损伤</>",
          "textFormat": "NORMAL"
        },
        {
          "text": "【予取予夺】献祭至多5名逐火战士，并根据献祭数获得相当于自身最大生命值一定比例的物理/法术屏障，屏障持续一段时间",
          "textFormat": "NORMAL"
        },
        {
          "text": "第二形态",
          "textFormat": "TITLE"
        },
        {
          "text": "攻击力提升",
          "textFormat": "NORMAL"
        },
        {
          "text": "立即点燃场上所有芦苇丛",
          "textFormat": "NORMAL"
        },
        {
          "text": "近战攻击造成两次攻击力一定比例的伤害",
          "textFormat": "NORMAL"
        },
        {
          "text": "远程攻击和【主宰】可以额外选择一个目标",
          "textFormat": "NORMAL"
        }
      ],
      "linkEnemies": [
        "enemy_1288_duskls",
        "enemy_1288_duskls_2"
      ],
      "damageType": [
        "MAGIC"
      ],
      "invisibleDetail": false
    },
    "enemy_1538_ymmons": {
      "enemyId": "enemy_1538_ymmons",
      "enemyIndex": "YA01",
      "enemyTags": null,
      "sortId": 1430,
      "name": "“睚”",
      "enemyLevel": "BOSS",
      "description": "巨兽“睚”的代理人。据司岁台古卷记载，千年前炎国所围猎的巨兽之一“睚”，拥有“裁错春秋”的神奇能力。伤口永难愈合，祂舔舐着屈辱、愤怒与不解......祂回到了熟悉的炎土。",
      "attackType": null,
      "ability": null,
      "isInvalidKilled": false,
      "overrideKillCntInfos": {},
      "hideInHandbook": false,
      "hideInStage": true,
      "abilityList": [
        {
          "text": "在经过的地块生成“无念之冬”，“无念之冬”持续召唤敌人",
          "textFormat": "NORMAL"
        },
        {
          "text": "第一形态",
          "textFormat": "TITLE"
        },
        {
          "text": "【春生】被阻挡时召唤蜃景，在经过的地块生成“无念之冬”，一段时间后未被击败则“睚”传送到蜃景的位置",
          "textFormat": "NORMAL"
        },
        {
          "text": "第二形态",
          "textFormat": "TITLE"
        },
        {
          "text": "攻击范围扩大，攻击变为远程攻击",
          "textFormat": "NORMAL"
        },
        {
          "text": "获得<$ba.float>近地悬浮</>",
          "textFormat": "NORMAL"
        },
        {
          "text": "【秋荣】在场上召唤妄境，妄境在经过的地块生成“无念之冬”，拥有和“睚”相似的能力。“睚”被击败时，妄境死亡；妄境死亡时，“睚”丢失部分最大生命值",
          "textFormat": "NORMAL"
        },
        {
          "text": "【裁剪春秋】“睚”和妄境对自身周围单位造成一次范围伤害，随后交换位置和行进路线",
          "textFormat": "NORMAL"
        },
        {
          "text": "【天地如自】“睚”和妄境对自身周围单位造成一次范围伤害",
          "textFormat": "NORMAL"
        }
      ],
      "linkEnemies": [
        "enemy_1312_ymillu",
        "enemy_1538_ymmons_2",
        "enemy_1538_ymmons_3"
      ],
      "damageType": [
        "MAGIC"
      ],
      "invisibleDetail": false
    },
