    "enemy_6005_llstone": {
      "enemyId": "enemy_6005_llstone",
      "enemyIndex": "DL5",
      "enemyTags": null,
      "sortId": 1584,
      "name": "圆岩巨像",
      "enemyLevel": "BOSS",
      "description": "原是为了最大化榨取矿场价值，以矿场废料构建的源石技艺造物。但这座巨像似乎意识到自己与矿石同根同源，极为抗拒挖掘工作，最后甚至转而攻击开矿的人类。它已袭击了许多矿场，人们畏惧地称呼它为“矿场杀手矿”。",
      "attackType": null,
      "ability": null,
