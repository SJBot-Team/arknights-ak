    "enemy_6025_tinker": {
      "enemyId": "enemy_6025_tinker",
      "enemyIndex": "DL25",
      "enemyTags": null,
      "sortId": 1604,
      "name": "怨恨祭坛",
      "enemyLevel": "BOSS",
      "description": "笼罩着萨卡兹巫术的战争祭坛，被遗弃在战场残迹之中，不知何时被激活了，震荡着大地，威胁着靠近的生灵。它不为存活，不为被铭记，只为战斗到最后一刻——有那些造物环绕在它的周围，它一定不会感到孤单。",
      "attackType": null,
      "ability": null,
      "isInvalidKilled": false,
      "overrideKillCntInfos": {},
      "hideInHandbook": false,
      "hideInStage": true,
      "abilityList": [
        {
          "text": "自身生命值首次低于60%时，祭坛会进入防御模式，获得一段时间的法术物理减伤，并立即召唤巫术石球",
          "textFormat": "NORMAL"
        },
        {
          "text": "每隔一段时间发射大量全图打击的巫术流弹对我方单位造成物理伤害，优先攻击距离较近的2名我方单位",
          "textFormat": "NORMAL"
        },
        {
          "text": "每隔一段时间，在自身周围四格召唤出“巫术石球”",
          "textFormat": "NORMAL"
        }
      ],
      "linkEnemies": [
