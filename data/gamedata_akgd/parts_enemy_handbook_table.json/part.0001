    "enemy_2118_dylbhm": {
      "enemyId": "enemy_2118_dylbhm",
      "enemyIndex": "YI",
      "enemyTags": null,
      "sortId": 1555,
      "name": "易",
      "enemyLevel": "BOSS",
      "description": "揉梁染柱，聚楼生阁，采云泥以为物，取相合以成对。",
      "attackType": null,
      "ability": null,
      "isInvalidKilled": false,
      "overrideKillCntInfos": {},
      "hideInHandbook": false,
      "hideInStage": true,
      "abilityList": [
        {
          "text": "第一形态",
          "textFormat": "TITLE"
        },
        {
          "text": "初始处于“晦”属性，同时攻击2名目标，优先选择与自身晦明属性相反的单位",
          "textFormat": "NORMAL"
        },
        {
          "text": "【相合】每隔一段时间，进入施法状态改变自身的晦明属性",
          "textFormat": "NORMAL"
        },
        {
          "text": "【承梁】每隔一段时间，从地图的两侧不断召唤<梁>",
          "textFormat": "NORMAL"
        },
        {
          "text": "第二形态",
          "textFormat": "TITLE"
        },
        {
          "text": "【相合】每隔一段时间，进入施法状态改变自身的晦明属性并获得屏障",
          "textFormat": "NORMAL"
        },
        {
          "text": "【承梁】每隔一段时间，从地图的两侧不断召唤更多<梁>",
          "textFormat": "NORMAL"
        }
      ],
      "linkEnemies": [
