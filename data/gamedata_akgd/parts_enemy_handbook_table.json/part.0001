    "enemy_6013_smith": {
      "enemyId": "enemy_6013_smith",
      "enemyIndex": "DL13",
      "enemyTags": null,
      "sortId": 1592,
      "name": "老妈的“逆女”",
      "enemyLevel": "BOSS",
      "description": "前约翰老妈员工。虽然不知道这几年她经历了什么，但能看出她对老妈大家庭没什么好感。此刻她正挥舞着施工队建造的大量武器，在老妈的新地块上胡乱破坏。",
      "attackType": null,
      "ability": null,
      "isInvalidKilled": false,
      "overrideKillCntInfos": {},
      "hideInHandbook": false,
