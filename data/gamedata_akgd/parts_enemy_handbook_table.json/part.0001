      "enemyIndex": "BB",
      "enemyTags": null,
      "sortId": 1413,
      "name": "“进化的本质”",
      "enemyLevel": "BOSS",
      "description": "不应行于这片大地的狂人，不应存于彼端世界的奇物，二者的结合诞生出了这一超越生物常理的“进化”之节点。它的存在本质与泰拉的一切相悖，它不该活着，它不能活着。",
      "attackType": null,
      "ability": null,
      "isInvalidKilled": false,
      "overrideKillCntInfos": {},
      "hideInHandbook": false,
      "hideInStage": true,
      "abilityList": [
        {
          "text": "无法移动",
          "textFormat": "NORMAL"
        },
        {
          "text": "每过一段时间或生命低于一定比例时自身会进化",
          "textFormat": "NORMAL"
        },
        {
          "text": "周期性分裂<畸变赘生物>或<畸变恶性瘤>",
          "textFormat": "NORMAL"
        },
        {
          "text": "周期性对场上所有我方单位造成大量真实伤害",
          "textFormat": "NORMAL"
        },
        {
          "text": "初生形态",
          "textFormat": "TITLE"
        },
        {
          "text": "受到来自左侧单位造成的物理或法术伤害大幅降低",
          "textFormat": "NORMAL"
        },
        {
          "text": "进化形态",
          "textFormat": "TITLE"
        },
        {
          "text": "受到来自右侧单位造成的物理或法术伤害大幅降低",
          "textFormat": "NORMAL"
        },
        {
          "text": "完美形态",
          "textFormat": "TITLE"
        },
        {
          "text": "受到的物理与法术伤害极大幅降低但自身每秒失去生命值",
          "textFormat": "NORMAL"
        }
      ],
      "linkEnemies": [
        "enemy_1137_plasm",
        "enemy_1138_tumor"
      ],
      "damageType": [
        "PHYSIC"
      ],
      "invisibleDetail": false
    },
    "enemy_1520_empgrd": {
      "enemyId": "enemy_1520_empgrd",
      "enemyIndex": "EMG",
      "enemyTags": null,
      "sortId": 1414,
      "name": "“皇帝的利刃”，追猎者",
      "enemyLevel": "BOSS",
      "description": "他曾盘剥北原邪魔，将异种隔绝于文明之外；亦手刃王公贵族，令荣光不蒙上叛乱尘埃。每一位内卫都是一个国度，他们脚下的大地皆是乌萨斯的国土。",
      "attackType": null,
      "ability": null,
      "isInvalidKilled": false,
      "overrideKillCntInfos": {},
      "hideInHandbook": false,
      "hideInStage": true,
      "abilityList": [
        {
          "text": "第一形态",
          "textFormat": "TITLE"
        },
        {
          "text": "每损失一定比例生命值释放永久地面效果【国度】，大幅度降低目标攻击速度并减少自身受到的物理或法术伤害（优先选择不在【国度】中且期间累计造成伤害最高的我方单位）",
          "textFormat": "NORMAL"
        },
        {
          "text": "【坍缩恐惧】对周围造成法术伤害，若目标在【国度】中会被强制击倒",
          "textFormat": "NORMAL"
        },
        {
          "text": "生命值首次降为0时对整个战场释放【坍缩恐惧】并进入第二形态",
          "textFormat": "NORMAL"
        },
        {
          "text": "第二形态",
          "textFormat": "TITLE"
        },
        {
          "text": "攻击力提升，可进行近战攻击造成更高伤害",
          "textFormat": "NORMAL"
        },
        {
          "text": "每损失更少的生命比例就释放【国度】",
          "textFormat": "NORMAL"
        }
      ],
      "linkEnemies": [],
      "damageType": [
        "PHYSIC"
      ],
      "invisibleDetail": false
    },
    "enemy_1521_dslily": {
      "enemyId": "enemy_1521_dslily",
      "enemyIndex": "SVK",
      "enemyTags": null,
      "sortId": 1415,
      "name": "盐风主教昆图斯",
      "enemyLevel": "BOSS",
      "description": "混入灾后伊比利亚的深海教会成员之一，真诚地用自己的理念篡改了律法，追求着个体的完美姿态，却根本无法参透海洋的意愿。话说回来，谁又能呢？",
