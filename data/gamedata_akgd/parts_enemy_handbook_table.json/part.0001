      "enemyTags": null,
      "sortId": 1589,
      "name": "“年轻人”桑德尔",
      "enemyLevel": "BOSS",
      "description": "上了年纪的雷姆必拓地下拳手，绰号来自他的出道之战，当时年轻力壮的他凭借着蛮勇战胜了饿着肚子比赛的老拳王。多年后，他败在更年轻的对手手下，愤而出走荒野。他凭借着老年人的经验与狡猾混成了荒野上的拳赛组织者，甚至做起了抢夺移动城市地块充当黑拳竞技场的美梦，浑然不知成败的关键从来都没能握在自己手中。",
      "attackType": null,
      "ability": null,
      "isInvalidKilled": false,
      "overrideKillCntInfos": {},
      "hideInHandbook": false,
      "hideInStage": true,
      "abilityList": [
        {
          "text": "被阻挡时受来自阻挡者以外的伤害降低",
          "textFormat": "NORMAL"
        },
        {
          "text": "生命下降到一定比例时会被击倒并下场休息，生命全部恢复后再次开始行动且攻击速度提升",
          "textFormat": "NORMAL"
        }
      ],
      "linkEnemies": [],
      "damageType": [
        "PHYSIC"
      ],
      "invisibleDetail": false
    },
    "enemy_6011_planty": {
      "enemyId": "enemy_6011_planty",
      "enemyIndex": "DL11",
      "enemyTags": null,
      "sortId": 1590,
      "name": "“自然的妥协”",
      "enemyLevel": "BOSS",
      "description": "一种新近发现的生命形式，有可靠记录以来体型最大的源石虫与花卉的共生形态。能通过散布花粉促进植物的生长和源石虫的繁殖，甚至还能在空中缓慢飞行。一些学者认为其飞行能力是低智能生物主动操控复杂源石技艺的新证据，而更多人坚称这不过是一种特定条件下自然发生的现象。这一问题至今没有定论，因为还没有哪位不要命的生物学家敢靠近它。",
      "attackType": null,
      "ability": null,
      "isInvalidKilled": false,
      "overrideKillCntInfos": {},
      "hideInHandbook": false,
      "hideInStage": true,
      "abilityList": [
        {
          "text": "飞行经过地块时消耗生命使其被植物覆盖，生命降低至一半后坠落至地面",
          "textFormat": "NORMAL"
        },
        {
          "text": "【生长激素】若处于飞行状态，将周围的地块被植物覆盖；之后从所有被植物覆盖的地块召唤<小型共生体>",
          "textFormat": "NORMAL"
        },
        {
          "text": "【落叶激素】调度干员时，攻击场上防御力最高的单位，并将【改性植物激素】放入待部署区",
          "textFormat": "NORMAL"
        }
      ],
      "linkEnemies": [
        "enemy_6012_plants"
      ],
      "damageType": [
        "PHYSIC"
      ],
      "invisibleDetail": false
    },
    "enemy_6012_plants": {
      "enemyId": "enemy_6012_plants",
      "enemyIndex": "DL12",
      "enemyTags": null,
      "sortId": 1591,
      "name": "小型共生体",
      "enemyLevel": "NORMAL",
      "description": "和“自然的妥协”一起出现的共生体。难以分清到底是其生物学上的后代，还是被花粉沾染并同化的源石虫。也许两者兼而有之？",
      "attackType": null,
