    "enemy_8008_eltswd": {
      "enemyId": "enemy_8008_eltswd",
      "enemyIndex": "SFR04",
      "enemyTags": null,
      "sortId": 1636,
      "name": "矢量战术装备",
      "enemyLevel": "ELITE",
      "description": "罗德岛工程部的尖端设计，为本次矢量突破训练量身打造的战术装备。\n实体化的思绪会带来重压，也会带来力量。",
      "attackType": null,
      "ability": null,
      "isInvalidKilled": false,
      "overrideKillCntInfos": {},
      "hideInHandbook": false,
      "hideInStage": true,
      "abilityList": [
        {
          "text": "更容易受到攻击，被攻击时对周围的我方造成一定的真实伤害",
          "textFormat": "NORMAL"
        },
        {
          "text": "持续使周围的我方陷入<$ba.stun>晕眩</>",
          "textFormat": "NORMAL"
        },
        {
          "text": "被其他敌人触碰时消失，该敌人的最大生命和攻击力提升，且被击倒后原地生成【矢量战术装备】",
          "textFormat": "NORMAL"
        },
        {
          "text": "被击破后生成力场，力场中的我方的最大生命和攻击力提升，受到的物理和法术伤害降低",
          "textFormat": "NORMAL"
        },
        {
          "text": "在场一段时间后自爆，造成大范围高额法术伤害",
          "textFormat": "NORMAL"
        }
      ],
      "linkEnemies": [
        "enemy_8007_eltrsm"
      ],
      "damageType": [
        "MAGIC"
      ],
      "invisibleDetail": false
    },
    "enemy_8009_eltufo": {
      "enemyId": "enemy_8009_eltufo",
      "enemyIndex": "SFR05",
      "enemyTags": null,
      "sortId": 1637,
      "name": "“迷迭香”的无人机",
      "enemyLevel": "ELITE",
      "description": "罗德岛工程部的尖端设计，为本次矢量突破训练特别定制的无人机。\n迷迭香很喜欢它的颜色。",
      "attackType": null,
      "ability": null,
      "isInvalidKilled": false,
      "overrideKillCntInfos": {},
      "hideInHandbook": false,
      "hideInStage": true,
      "abilityList": [
        {
          "text": "飞行单位",
          "textFormat": "NORMAL"
        },
        {
          "text": "只能在力场中被攻击",
          "textFormat": "NORMAL"
        },
        {
          "text": "攻击造成范围伤害",
          "textFormat": "NORMAL"
        },
        {
          "text": "攻击2次后，下一次攻击会<$ba.stun>晕眩</>所有目标",
          "textFormat": "NORMAL"
        },
        {
          "text": "被击破后原地留下补给，该补给将在“迷迭香”，虚实之握触发【思维崩毁】后激活，使大范围内的我方受到的物理和法术伤害降低",
          "textFormat": "NORMAL"
        }
      ],
      "linkEnemies": [
