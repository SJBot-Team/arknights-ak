    "enemy_9008_acbunn": {
      "enemyId": "enemy_9008_acbunn",
      "enemyIndex": "SP03",
      "enemyTags": null,
      "sortId": 1724,
      "name": "假想敌：骨刺",
      "enemyLevel": "ELITE",
      "description": "参照源石晶簇的结构而设计的假想敌。金属机械的构造使误差与瑕疵难以避免，但至少晶簇那危险而尖锐的印象得以保留。必须在模拟的战斗中克服深层的恐惧本能。",
      "attackType": null,
