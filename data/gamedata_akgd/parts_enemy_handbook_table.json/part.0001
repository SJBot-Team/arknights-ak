    "enemy_1587_ubbplwq": {
      "enemyId": "enemy_1587_ubbplwq",
      "enemyIndex": "PAV",
      "enemyTags": null,
      "sortId": 1479,
      "name": "巴普洛维奇，枢密官",
      "enemyLevel": "BOSS",
      "description": "一个坚信自己从头到尾没有做错任何事的人。像他这样的人，在乌萨斯帝国议会的下议院里还坐着一百来个。",
      "attackType": null,
      "ability": null,
      "isInvalidKilled": false,
      "overrideKillCntInfos": {},
      "hideInHandbook": false,
      "hideInStage": true,
      "abilityList": [
        {
          "text": "【帝国公仆豁免法案】受到的物理和法术伤害大幅降低",
          "textFormat": "NORMAL"
        },
        {
          "text": "【圣骏堡舆论廓清条例】被警戒塔发现的我方干员撤退或死亡则被关押至禁闭所，关押状态下无法再部署；关卡中禁闭所被击破后再生",
          "textFormat": "NORMAL"
        },
        {
          "text": "【枢密官人身安全条款】攻击范围内存在我方单位时，强制使警戒塔转向该单位",
          "textFormat": "NORMAL"
        },
        {
          "text": "“帝国良心”",
          "textFormat": "TITLE"
        },
        {
          "text": "【自发动员】周期性进行演讲，演讲时失去伤害减免效果，持续在自身周围召唤敌人，并赋予范围内敌人战斗强化效果",
          "textFormat": "NORMAL"
        },
        {
          "text": "【前线视察】演讲时，将<“私人安全顾问”>召回身边",
          "textFormat": "NORMAL"
        },
        {
          "text": "“乱流砥柱”",
          "textFormat": "TITLE"
        },
        {
          "text": "【自发动员】召唤更强力的单位",
          "textFormat": "NORMAL"
        },
        {
          "text": "【口径辩论】呼叫火力支援，对警戒区域进行一次轰炸，对范围内的我方单位造成攻击力一定比例的法术伤害和<$ba.dt.burning>灼燃损伤</>，并使地块处于<被照亮>的状态一段时间，照亮期间地块上单位的伪装工具失效并持续受到<$ba.dt.burning>灼燃损伤</>",
          "textFormat": "NORMAL"
        },
        {
          "text": "【封锁区和平治理计划】6分钟后，对全体单位进行一次致命轰炸",
          "textFormat": "NORMAL"
        }
      ],
      "linkEnemies": [
        "enemy_1588_ubbphw"
      ],
      "damageType": [
        "PHYSIC"
      ],
      "invisibleDetail": false
    },
    "enemy_1588_ubbphw": {
      "enemyId": "enemy_1588_ubbphw",
      "enemyIndex": "PMC",
      "enemyTags": null,
      "sortId": 1480,
      "name": "“私人安全顾问”",
      "enemyLevel": "ELITE",
      "description": "隶属于“二十二号仓库”安保公司的雇员。他曾想过要摆脱这家公司，但又怕自己立马会变成昔日同事的下一个任务目标。\n比起成为管道里一具无名的尸体，他宁愿充当那些香气熏人的贵族的私兵。至少，他没被分配给格罗莫夫那个臭气熏天的蠢货。",
      "attackType": null,
      "ability": null,
      "isInvalidKilled": false,
      "overrideKillCntInfos": {},
      "hideInHandbook": false,
      "hideInStage": true,
      "abilityList": [
        {
          "text": "<巴普洛维奇，枢密官>演讲时进行贴身护卫，<巴普洛维奇，枢密官>死亡后退场",
          "textFormat": "NORMAL"
        },
        {
          "text": "警戒触发后，增加移动速度并在较大范围内寻找触发警戒的单位",
          "textFormat": "NORMAL"
        },
        {
          "text": "周围敌人受到的物理和法术伤害降低",
          "textFormat": "NORMAL"
        }
      ],
      "linkEnemies": [
        "enemy_1587_ubbplwq"
      ],
      "damageType": [
        "PHYSIC"
      ],
      "invisibleDetail": false
    },
    "enemy_1590_muama": {
      "enemyId": "enemy_1590_muama",
      "enemyIndex": "ALC",
      "enemyTags": null,
      "sortId": 1481,
      "name": "AMa-10",
      "enemyLevel": "BOSS",
      "description": "“保护你自己，AMa-10，生存才是生命诞生时便拥有的本能。”彼时，她还不明白，究竟是什么，会值得用永恒的生命做交换。",
      "attackType": null,
      "ability": null,
      "isInvalidKilled": false,
      "overrideKillCntInfos": {},
      "hideInHandbook": false,
      "hideInStage": true,
      "abilityList": [
        {
          "text": "无法移动，无法被传送",
          "textFormat": "NORMAL"
        },
        {
          "text": "攻击同一目标时攻击力逐渐提升",
          "textFormat": "NORMAL"
        },
        {
          "text": "【防火墙】自身周围8格的边界拥有“防火墙”，受到来自“防火墙”外的物理与法术伤害大幅降低；“防火墙”内无法直接部署我方单位",
          "textFormat": "NORMAL"
        },
        {
          "text": "【刷新】每隔一段时间将自己转移至指定地块，并重新生成“防火墙”",
          "textFormat": "NORMAL"
        },
        {
          "text": "【信息洪流】对一个方向内三格发射信息洪流，使首个击中的单位<$ba.stun>晕眩</>一段时间，期间持续受到真实伤害",
          "textFormat": "NORMAL"
        }
      ],
      "linkEnemies": [
        "enemy_1591_mutwin",
