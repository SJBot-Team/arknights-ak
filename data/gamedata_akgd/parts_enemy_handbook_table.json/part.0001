    "enemy_2143_shwksc": {
      "enemyId": "enemy_2143_shwksc",
      "enemyIndex": "ABT",
      "enemyTags": null,
      "sortId": 1568,
      "name": "埃尔伯特",
      "enemyLevel": "BOSS",
      "description": "面相凶恶、性格古怪的莱塔尼亚教授。他将对源石技艺和学术的狂热与才华全都献给了赫尔昏佐伦，换来的却只是不屑一顾。莱塔尼亚的学术名流纷纷与他划清界限，他的成就已经被人遗忘，只有黑流树海记得。",
      "attackType": null,
      "ability": null,
      "isInvalidKilled": false,
      "overrideKillCntInfos": {},
      "hideInHandbook": false,
      "hideInStage": true,
      "abilityList": [
        {
          "text": "持续释放沿地面移动的<“火种”>，遇到我方近战单位后爆炸，对周围造成法术伤害和<$ba.dt.apoptosis>凋亡损伤</>，其伤害随移动距离减小",
          "textFormat": "NORMAL"
        },
        {
          "text": "周期性朝目标点传送一定距离",
          "textFormat": "NORMAL"
        },
        {
          "text": "退场后留下法杖，增加场上敌人的攻击速度和移动速度",
          "textFormat": "NORMAL"
        }
      ],
      "linkEnemies": [],
      "damageType": [
        "MAGIC"
      ],
      "invisibleDetail": false
    },
    "enemy_2144_shwks2": {
