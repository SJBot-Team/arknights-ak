      "enemyTags": null,
      "sortId": 1544,
      "name": "坎某人",
      "enemyLevel": "BOSS",
      "description": "行走于园林的神秘商人兼鲍老板下属，只要典籍里存在的，他就贩卖。",
      "attackType": null,
