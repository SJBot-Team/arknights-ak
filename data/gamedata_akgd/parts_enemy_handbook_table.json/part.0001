        "NO_DAMAGE"
      ],
      "invisibleDetail": false
    },
    "enemy_6022_m2cnt": {
      "enemyId": "enemy_6022_m2cnt",
      "enemyIndex": "DL22",
      "enemyTags": null,
      "sortId": 1601,
      "name": "“织郁伯爵”",
      "enemyLevel": "BOSS",
      "description": "莱塔尼亚边境城镇的领主，一位郁郁不得志的落魄贵族。他无比渴望自己编织的乐律能被赏识，响彻莱塔尼亚。然而知音难觅，他也日渐封闭、痴狂，身陷自己的“阴郁法术”直至疯魔。现在，他正将这些乐章编织在自己的法术之中，妄图将阴郁的音律传播至远方，以唤起更多的共鸣。",
      "attackType": null,
      "ability": null,
      "isInvalidKilled": false,
      "overrideKillCntInfos": {},
      "hideInHandbook": false,
      "hideInStage": true,
      "abilityList": [
        {
          "text": "受到的物理及法术伤害大幅降低",
          "textFormat": "NORMAL"
        },
        {
          "text": "在场的<啸叫音响>数量越多，攻击力越高",
          "textFormat": "NORMAL"
        },
        {
          "text": "场上的<啸叫音响>被摧毁时，自身受到一定真实伤害",
          "textFormat": "NORMAL"
        },
        {
          "text": "出场及释放【哀恸赋格】时，立即将一个<啸叫音响>放入待部署区，生命值低于一半时改为放入两个",
          "textFormat": "NORMAL"
        },
        {
          "text": "【哀恸赋格】停止攻击并持续施法，期间取消<啸叫音响>的无敌状态，并对自身和场上所有<啸叫音响>周围持续造成法术伤害；待部署区的<啸叫音响>在施法期间也会持续消耗部署费用",
          "textFormat": "NORMAL"
        }
      ],
      "linkEnemies": [],
      "damageType": [
        "MAGIC"
      ],
      "invisibleDetail": false
    },
    "enemy_6023_crane": {
      "enemyId": "enemy_6023_crane",
      "enemyIndex": "DL23",
      "enemyTags": null,
      "sortId": 1602,
      "name": "“贪婪捕手”",
      "enemyLevel": "BOSS",
      "description": "盒牌工业的秘密武器，“任性生物”的天敌，长得有点像抓娃娃机。现在，它的操控程序陷入了混乱，正失控地冲向多索雷斯街头，用它那些可以伸长的抓手到处捡拾好东西。离远一点，千万不要被闪烁着的霓虹灯广告吸引，别像那些贪婪的人一样被吞进它的肚子里！",
      "attackType": null,
      "ability": null,
      "isInvalidKilled": false,
      "overrideKillCntInfos": {},
      "hideInHandbook": false,
      "hideInStage": true,
      "abilityList": [
        {
          "text": "周围有领袖以外的敌人时会将其装载为乘客（最多5个），攻击时投掷1名乘客，自身被击败时释放出全部乘客",
          "textFormat": "NORMAL"
        },
        {
          "text": "装载乘客时，攻击力、防御力、生命值大幅提升",
          "textFormat": "NORMAL"
        },
        {
          "text": "装载<“特别任性的生物”>后会立即释放出全部乘客，并晕眩较长一段时间",
          "textFormat": "NORMAL"
        },
        {
          "text": "【右右上左就这一抓】停止移动一段时间，期间攻击范围和攻击速度大幅提升；立即吸引最近的数名敌人到自身当前位置",
          "textFormat": "NORMAL"
        },
        {
          "text": "【赠品兑换】偷偷束缚当前攻击力最高的一名干员，使其无法攻击和释放技能，直至其离开战场。效果结束时将一个含有<“特别任性的生物”>的<黏黏的赠品>放入待部署区",
          "textFormat": "NORMAL"
        }
      ],
      "linkEnemies": [
        "enemy_6024_crnbug"
      ],
      "damageType": [
        "PHYSIC"
      ],
      "invisibleDetail": false
    },
