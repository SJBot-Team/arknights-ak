    "enemy_8001_flmlod": {
      "enemyId": "enemy_8001_flmlod",
      "enemyIndex": "SFR01",
      "enemyTags": null,
      "sortId": 1643,
      "name": "熔戈者，护王余火",
      "enemyLevel": "BOSS",
      "description": "从谴罚氏族中最年轻的将领，到最后一位炎魔。面对围攻，他戍守在君王的遗骨前三天三夜。终于，在最后的火光中，他见到了那许诺里的故乡。",
      "attackType": null,
      "ability": null,
      "isInvalidKilled": false,
      "overrideKillCntInfos": {},
      "hideInHandbook": true,
      "hideInStage": false,
      "abilityList": [
        {
          "text": "第一形态",
          "textFormat": "TITLE"
        },
        {
          "text": "【镇压】用缠身恶焰使全屏内一名干员无法行动并持续受到法术伤害，若该干员在缠身恶焰存在时被击倒或撤退则会被缠身恶焰封印，需要消灭缠身恶焰才能再次部署该干员",
          "textFormat": "NORMAL"
        },
        {
          "text": "【偿还】生命值降为0时，立即使周围所有干员被缠身恶焰缠绕，自身每隔一段时间会以一个我方单位为目标释放<凝缩热力>（如果没有我方单位在场则向保护目标点释放）",
          "textFormat": "NORMAL"
        },
        {
          "text": "<凝缩热力>熔戈者释放的飞行火焰，防御力较低，持续对周围我方造成法术伤害和灼燃损伤；飞行至目标所在位置或目标离场时，自爆并造成大范围法术伤害，进入保护目标点时扣除关卡生命值",
          "textFormat": "NORMAL"
        }
      ],
      "linkEnemies": [
        "enemy_8006_flmgd",
        "enemy_8002_flmchn",
        "enemy_8003_flmchn2",
        "enemy_8004_flmspr",
        "enemy_8005_flmspr2"
      ],
      "damageType": [
        "PHYSIC",
        "MAGIC"
      ],
      "invisibleDetail": false
    },
