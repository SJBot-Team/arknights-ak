      ],
      "invisibleDetail": false
    },
    "enemy_18007_lhbque": {
      "enemyId": "enemy_18007_lhbque",
      "enemyIndex": "IL07",
      "enemyTags": null,
      "sortId": 1720,
      "name": "斑斓虫",
      "enemyLevel": "BOSS",
      "description": "颚虫种群中稀少的王虫，巨锹虫是她的卫士，小颚虫是她的子民，接受到其信息素的颚虫会不顾一切地执行指令。通常一个种群中只会有一只王虫，若有新王虫出现，老王虫会自我退化。而其被称作斑斓虫的原因，在激怒她后便可知晓。",
      "attackType": null,
      "ability": null,
      "isInvalidKilled": false,
      "overrideKillCntInfos": {},
      "hideInHandbook": false,
      "hideInStage": true,
      "abilityList": [
        {
          "text": "在场时，所有<小颚虫>被击倒后，对周围我方单位造成大量物理伤害",
          "textFormat": "NORMAL"
        },
        {
          "text": "周期性召唤一个<巨锹虫>",
          "textFormat": "NORMAL"
        },
        {
          "text": "场上每有一个<巨锹虫>，都会使自身获得一定比例的物理法术伤害减免",
          "textFormat": "NORMAL"
        },
        {
          "text": "第一形态",
          "textFormat": "TITLE"
        },
        {
          "text": "首次被击倒后，立即召唤两个<巨锹虫>，缓慢回复生命值，一段时间后切换至第二形态",
          "textFormat": "NORMAL"
        },
        {
          "text": "第二形态",
          "textFormat": "TITLE"
        },
        {
          "text": "变为飞行单位，攻击间隔大幅缩短，移动速度提高，攻击力大幅提高",
          "textFormat": "NORMAL"
        },
        {
          "text": "使场上其他感染生物最大生命值大幅提高",
          "textFormat": "NORMAL"
        }
      ],
      "linkEnemies": [
        "enemy_18002_lhbetl",
        "enemy_18004_lhbmom"
      ],
      "damageType": [
        "PHYSIC"
      ],
      "invisibleDetail": false
    },
    "enemy_18008_lhbbos": {
      "enemyId": "enemy_18008_lhbbos",
      "enemyIndex": "IL08",
      "enemyTags": null,
      "sortId": 1721,
      "name": "“老尖牙”",
      "enemyLevel": "BOSS",
      "description": "生物与人一样会遭受感染，当生命步入末期时，再高傲的猎手也终将躺倒在地，化作尘齑。然而，在罗德岛沉没，造物主苏醒的时刻之后，有一些亘古不变的常理，也悄然发生了变化。",
      "attackType": null,
      "ability": null,
      "isInvalidKilled": false,
      "overrideKillCntInfos": {},
      "hideInHandbook": false,
      "hideInStage": true,
      "abilityList": [
        {
          "text": "第一形态",
          "textFormat": "TITLE"
        },
        {
          "text": "<$ba.invisible>隐匿</>，攻击造成十字溅射伤害",
          "textFormat": "NORMAL"
        },
        {
          "text": "每当生命值降低一定比例后，在自身周围满足部署条件的地块生成【源石晶簇】",
          "textFormat": "NORMAL"
        },
        {
          "text": "首次被击倒后，缓慢回复生命值，一段时间后切换至第二形态",
          "textFormat": "NORMAL"
        },
        {
          "text": "第二形态",
          "textFormat": "TITLE"
        },
        {
          "text": "进入第二形态后，立即清空场上可撤退地块，并在一段时间内不断将玩家可部署的干员和地块随机部署至可部署的位置，且朝向随机",
          "textFormat": "NORMAL"
        },
        {
          "text": "失去<$ba.invisible>隐匿</>，进行远程攻击，并造成法术伤害",
          "textFormat": "NORMAL"
        },
        {
          "text": "每次攻击时，场上的【源石晶簇】会对周围的我方单位造成伤害",
          "textFormat": "NORMAL"
        }
      ],
      "linkEnemies": [],
      "damageType": [
        "PHYSIC",
        "MAGIC"
      ],
      "invisibleDetail": false
    },
    "enemy_9006_actoxi": {
