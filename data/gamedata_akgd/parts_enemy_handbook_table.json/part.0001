    "enemy_6015_ictruck": {
      "enemyId": "enemy_6015_ictruck",
      "enemyIndex": "DL15",
      "enemyTags": null,
      "sortId": 1594,
      "name": "“超甜微笑”",
      "enemyLevel": "BOSS",
      "description": "为确保冰淇淋供应而生产的产销一体全自动冰淇淋车，由于操作人员往燃料箱里误倒入了糖浆而失控，占领了核心控制平台并四处喷涂冰淇淋。它时刻搅拌着体内的奶浆，准备冲任何出现在视野中的顾客展露微笑。",
      "attackType": null,
      "ability": null,
      "isInvalidKilled": false,
      "overrideKillCntInfos": {},
      "hideInHandbook": false,
      "hideInStage": true,
      "abilityList": [
        {
          "text": "只能被阻挡数大于等于3的单位阻挡",
          "textFormat": "NORMAL"
        },
        {
          "text": "每隔一段时间，优先以高台干员为目标放出一个<甜蜜派送机>",
          "textFormat": "NORMAL"
        },
        {
          "text": "登场一段时间后，未被阻挡时周期性加快全场敌人的攻击速度与移动速度",
          "textFormat": "NORMAL"
        },
        {
          "text": "周期性进入狂飙模式，此时不可被阻挡且经过我方单位时冲撞造成物理伤害",
          "textFormat": "NORMAL"
        },
        {
          "text": "狂飙模式下冲撞5次阻挡数大于等于4的干员后停机，短时间内自身停止行动并获得<$ba.fragile>脆弱</>、且使全场敌人晕眩",
          "textFormat": "NORMAL"
        }
      ],
      "linkEnemies": [
        "enemy_6017_icdrone"
      ],
      "damageType": [
        "PHYSIC"
      ],
      "invisibleDetail": false
    },
    "enemy_6016_splash": {
      "enemyId": "enemy_6016_splash",
      "enemyIndex": "DL16",
      "enemyTags": null,
      "sortId": 1595,
      "name": "干渴者",
      "enemyLevel": "BOSS",
      "description": "它曾经有过身为伊比利亚人的名字，直至它将那个名字投入大海，消失于深渊。然而拥抱海水并不足以滋润它干涸的咽喉，血管中奔流的澄红液体具备同等的诱惑，于是它重返陆地。它渴望更多。",
      "attackType": null,
      "ability": null,
      "isInvalidKilled": false,
      "overrideKillCntInfos": {},
      "hideInHandbook": false,
      "hideInStage": true,
      "abilityList": [
        {
          "text": "攻击额外造成<$ba.dt.neural>神经损伤</>",
          "textFormat": "NORMAL"
        },
        {
          "text": "防御力与法术抗性很高，但会因<汲取体>被完全治愈而降低",
          "textFormat": "NORMAL"
        },
        {
          "text": "每隔一段时间喷吐污物，将<汲取体>放入待部署区并攻击整个战场上的数个干员；随危险等级升高会有更多干员被攻击",
          "textFormat": "NORMAL"
        },
        {
          "text": "每损失一定生命值，立刻晕眩场上数名干员并释放一个与自身已损失生命值量相等的屏障；屏障持续期间若未击破屏障，屏障结束后场上所有干员受到大量神经损伤",
          "textFormat": "NORMAL"
        },
        {
          "text": "第二次及以后释放屏障时，若上一次屏障没有被击破，晕眩更多干员；该效果可叠加数次，在屏障被击破时重置",
          "textFormat": "NORMAL"
        }
      ],
      "linkEnemies": [],
      "damageType": [
        "MAGIC"
      ],
      "invisibleDetail": false
    },
