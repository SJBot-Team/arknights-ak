    "enemy_9017_achunt": {
      "enemyId": "enemy_9017_achunt",
      "enemyIndex": "SP12",
      "enemyTags": null,
      "sortId": 1733,
      "name": "假想敌：铳",
      "enemyLevel": "BOSS",
      "description": "被源石占据重塑的圣卫铳骑，是根据源石灾难在全泰拉爆发的想象而设计的假想敌之一。源石在大地上蔓延，夺去一切我们尊崇的事物并取而代之，当所有的秩序被粉碎，它即是秩序。\n",
      "attackType": null,
      "ability": null,
      "isInvalidKilled": false,
      "overrideKillCntInfos": {},
      "hideInHandbook": false,
      "hideInStage": true,
      "abilityList": [
        {
          "text": "优先攻击防御力最高的单位",
          "textFormat": "NORMAL"
        },
        {
          "text": "攻击时附带<$ba.dt.erosion>侵蚀损伤</>",
          "textFormat": "NORMAL"
        },
        {
          "text": "无法被阻挡",
          "textFormat": "NORMAL"
        },
        {
          "text": "对同一个目标进行攻击时，攻击速度逐渐提升",
          "textFormat": "NORMAL"
        },
        {
          "text": "【最终之罚】停止攻击，移动速度大幅提升，向全场防御力最高的单位冲锋。对经过的单位造成物理伤害",
          "textFormat": "NORMAL"
        },
        {
          "text": "隐秘核心",
          "textFormat": "TITLE"
        },
        {
          "text": "【未尽的告解】在模拟中达成特定条件并进入隐秘核心回合时，场上出现<“碎铳之簧”>，同时<假想敌：铳>受到的物理与法术伤害大幅降低",
          "textFormat": "NORMAL"
        },
        {
          "text": "【盲信之誓】与场上所有<“碎铳之簧”>连结，<“碎铳之簧”>受到伤害时以一定比例传递给<假想敌：铳>，处于【盲信之誓】连结上的我方单位每秒受到物理伤害",
          "textFormat": "NORMAL"
        },
        {
          "text": "【末日布道】持续召唤场上所有<“碎铳之簧”>向自身移动，<“碎铳之簧”>移动速度大幅提升并免疫伤害，对经过的我方单位造成物理伤害",
          "textFormat": "NORMAL"
        }
      ],
      "linkEnemies": [
        "enemy_9018_actrpa"
      ],
      "damageType": [
        "PHYSIC"
      ],
      "invisibleDetail": false
    },
    "enemy_9018_actrpa": {
      "enemyId": "enemy_9018_actrpa",
      "enemyIndex": "SP13",
      "enemyTags": null,
      "sortId": 1734,
      "name": "“碎铳之簧”",
      "enemyLevel": "ELITE",
      "description": "被源石占据重塑的告解车，它将成为圣卫铳骑的子弹，忠实地执行其意志，无论那意志的本质是什么。",
      "attackType": null,
      "ability": null,
      "isInvalidKilled": false,
      "overrideKillCntInfos": {},
      "hideInHandbook": false,
      "hideInStage": true,
      "abilityList": [
        {
          "text": "【未竟的祷祝】初始持有以下一种特殊护盾；护盾生效时，自身无法被阻挡；护盾消失一定时间后，重新获得对应护盾",
          "textFormat": "NORMAL"
        },
        {
          "text": "元素护盾：受到的物理与法术伤害大幅降低，自身<$ba.dt.element>元素损伤</>爆发时，护盾消失。持有此护盾时，周期性发射一枚可以造成<$ba.dt.element>元素损伤</>并弹射数次的子弹，子弹在弹跳后伤害逐渐降低",
          "textFormat": "NORMAL"
        },
        {
          "text": "法术护盾：获得一定量的法术屏障，屏障存在时自身受到的物理伤害大幅降低。持有此护盾时，受到物理伤害时对来源造成物理伤害和<$ba.dt.erosion>侵蚀损伤</>",
          "textFormat": "NORMAL"
        },
        {
          "text": "频次护盾：受到数次伤害后消失。持有此护盾时，周期性进行十连击",
          "textFormat": "NORMAL"
        }
      ],
      "linkEnemies": [
        "enemy_9017_achunt"
      ],
      "damageType": [
        "PHYSIC"
      ],
      "invisibleDetail": false
    },
