    "enemy_6032_fxdjj": {
      "enemyId": "enemy_6032_fxdjj",
      "enemyIndex": "DL32",
      "enemyTags": null,
      "sortId": 1611,
      "name": "“绝对安保”试做型 ",
      "enemyLevel": "BOSS",
      "description": "多索雷斯某家初创公司为克里斯达尔艺术馆量身定做的安保机器人，他们欠下许多外债，指望靠这笔生意一炮而红。雷内尔曾承诺会在收货后三天内付清货款，可直到那家公司被催债人用推土机夷为平地，雷内尔都没掏出一分钱，他甚至没有拆封这台耗费大量心血的机器——也许他只是想看着那群聪明人被逼疯，谁知道呢？",
      "attackType": null,
      "ability": null,
      "isInvalidKilled": false,
      "overrideKillCntInfos": {},
      "hideInHandbook": false,
      "hideInStage": true,
      "abilityList": [
        {
          "text": "只能被阻挡数大于等于3的单位阻挡",
          "textFormat": "NORMAL"
        },
        {
          "text": "持有护盾，始终面朝我方最后部署的单位，大幅降低来自正面的物理和法术伤害",
          "textFormat": "NORMAL"
        },
        {
          "text": "受到来自护盾方向的攻击时，使危险等级加快提升",
          "textFormat": "NORMAL"
        },
        {
          "text": "移动到特定位置时，在自身所在位置留下一个“绝对助手”，其面朝方向和自身相同，攻击力不断提升，攻击造成物理溅射伤害",
          "textFormat": "NORMAL"
        },
        {
          "text": "每当危险等级提升或损失一定比例生命时，会停止攻击并开始蓄力，蓄力一定时间后对所有我方单位发起一次特殊攻击，对位于自身护盾背面的单位造成更高伤害，且施加<$ba.stun>晕眩</>效果",
          "textFormat": "NORMAL"
        }
      ],
      "linkEnemies": [],
      "damageType": [
        "PHYSIC"
      ],
      "invisibleDetail": false
    },
    "enemy_6033_skagod": {
      "enemyId": "enemy_6033_skagod",
      "enemyIndex": "DL33",
      "enemyTags": null,
      "sortId": 1612,
      "name": "冰滚兽 ",
      "enemyLevel": "BOSS",
      "description": "已经看不出本来模样的巨型野兽。似乎是某种穴居动物，对挖掘巢穴有着巨大的热情，视力很差，全身覆有坚冰鳞片，行动时会将自身缩成一团，以翻滚的方式移动。",
      "attackType": null,
      "ability": null,
      "isInvalidKilled": false,
      "overrideKillCntInfos": {},
      "hideInHandbook": false,
      "hideInStage": true,
      "abilityList": [
        {
          "text": "拥有<$ba.buffres>抵抗</>且获得基于当前移动速度的物理法术闪避",
          "textFormat": "NORMAL"
        },
        {
          "text": "【旋风冲击】缩成一团并根据当前的移动速度向前冲击一段距离，使穿过格点周围的干员<$ba.stun>晕眩</>数秒，并对其造成与自身移动速度相关的物理伤害，技能期间免疫大部分控制效果，技能结束后永久获得移动速度提升，<$ba.stun>晕眩</>效果会根据技能释放次数而增强",
          "textFormat": "NORMAL"
        },
        {
          "text": "未被阻挡时会逐渐加速进入“翻滚形态”，进入“翻滚形态”后的首次攻击会立刻释放【旋风冲击】",
          "textFormat": "NORMAL"
        },
        {
          "text": "被阻挡超过一段时间后，立刻释放【旋风冲击】",
          "textFormat": "NORMAL"
        },
        {
          "text": "每次危险等级提升或损失一定生命值时，立刻刷新【旋风冲击】的冷却时间",
          "textFormat": "NORMAL"
        }
      ],
      "linkEnemies": [],
      "damageType": [
        "PHYSIC"
      ],
      "invisibleDetail": false
    },
    "enemy_6034_vampir": {
      "enemyId": "enemy_6034_vampir",
      "enemyIndex": "DL34",
      "enemyTags": null,
      "sortId": 1613,
      "name": "“枯槁者”维奇科",
      "enemyLevel": "BOSS",
      "description": "带领着团伙占据废弃园区的犯罪组织领袖，一个拥有工程师背景的疯狂罪犯。他将自己的身体作为实验平台，为自己嵌装了能够利用源石能源短时飞行的机械翼装。然而，为了满足翼装和身体的能量需求，他不仅疯狂地抢占源石，更残忍地吸取他人的生命力来保证自身肉体的存续。眼下，这个危险的疯子正成为整个地区最令人恐惧的存在。",
      "attackType": null,
      "ability": null,
      "isInvalidKilled": false,
      "overrideKillCntInfos": {},
      "hideInHandbook": false,
      "hideInStage": true,
      "abilityList": [
        {
          "text": "在我方医疗干员攻击范围内时，每秒受到其一定攻击力的真实伤害",
          "textFormat": "NORMAL"
        },
        {
          "text": "【降临】飞行至一名我方干员上空持续攻击一段时间，每次造成伤害恢复攻击伤害一定比例的生命值，并使攻击速度提升（有上限）；若目标被击倒则获得高额的物理和法术闪避，持续至下次释放该技能",
          "textFormat": "NORMAL"
        },
        {
          "text": "生命值首次降至一半以下时攻击永久附带一定攻击力的法术伤害，并立即释放一次【降临】",
          "textFormat": "NORMAL"
        }
      ],
      "linkEnemies": [],
      "damageType": [
        "PHYSIC"
      ],
      "invisibleDetail": false
    },
