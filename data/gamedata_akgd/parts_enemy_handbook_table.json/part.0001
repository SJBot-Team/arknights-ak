      "ability": null,
      "isInvalidKilled": false,
      "overrideKillCntInfos": {},
      "hideInHandbook": false,
      "hideInStage": true,
      "abilityList": [
        {
          "text": "第一形态",
          "textFormat": "TITLE"
        },
        {
          "text": "使周围所有敌人最大生命值提高",
          "textFormat": "NORMAL"
        },
        {
          "text": "周围有其他敌人时，周期性为周围3名敌人回复一定生命值",
          "textFormat": "NORMAL"
        },
        {
          "text": "首次被击倒后，缓慢回复生命值，一段时间后切换至第二形态，期间周围敌人无法被击倒",
          "textFormat": "NORMAL"
        },
        {
          "text": "第二形态",
          "textFormat": "TITLE"
        },
        {
          "text": "停止治疗其他敌人",
          "textFormat": "NORMAL"
        },
        {
          "text": "周期性对周围我方单位造成法术伤害，并附带一定比例的<$ba.dt.neural>神经损伤</>",
          "textFormat": "NORMAL"
        }
      ],
