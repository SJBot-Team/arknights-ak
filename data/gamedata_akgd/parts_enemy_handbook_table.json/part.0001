    "enemy_10137_pycvol": {
      "enemyId": "enemy_10137_pycvol",
      "enemyIndex": "TD17",
      "enemyTags": null,
      "sortId": 1487,
      "name": "“异兽”熔火蜗",
      "enemyLevel": "BOSS",
      "description": "本代“异兽”，统治熔岩地带的王者。拥有“诅咒”的力量，想要将雪山改造成自己的巢穴。",
      "attackType": null,
      "ability": null,
      "isInvalidKilled": false,
      "overrideKillCntInfos": {},
      "hideInHandbook": false,
      "hideInStage": true,
      "abilityList": [
        {
          "text": "最多同时攻击四个目标，击中目标时会造成灼烧，持续损失生命值",
          "textFormat": "NORMAL"
        },
        {
          "text": "生命值降至一半时攻击速度大幅提升",
          "textFormat": "NORMAL"
        },
        {
          "text": "被阻挡时会进行自爆造成高额伤害",
          "textFormat": "NORMAL"
        },
        {
          "text": "可诅咒周围地块，使处于地块上的敌人移动速度提升；御龙技能以被诅咒的地块为目标时效果会更好",
          "textFormat": "NORMAL"
        }
      ],
      "linkEnemies": [],
      "damageType": [
        "MAGIC"
      ],
      "invisibleDetail": false
    },
    "enemy_1573_pyczog": {
      "enemyId": "enemy_1573_pyczog",
      "enemyIndex": "ZIN",
      "enemyTags": null,
      "sortId": 1488,
      "name": "“雷之主”",
      "enemyLevel": "BOSS",
      "description": "前代“异兽”，缠绕雷电的身姿令其得名“雷之主”。据称其狩猎时通过聚集无数雷光虫，可令身缠电力获得飞跃性提升，并变化为“超带电状态”。 ",
      "attackType": null,
      "ability": null,
      "isInvalidKilled": false,
      "overrideKillCntInfos": {},
      "hideInHandbook": false,
      "hideInStage": true,
      "abilityList": [
        {
          "text": "蓄电状态",
          "textFormat": "TITLE"
        },
        {
          "text": "【蓄电】原地进行蓄电，每次蓄电成功后会增加1层蓄电层数。达到一定层数后，进入超带电状态",
          "textFormat": "NORMAL"
        },
        {
          "text": "【雷鸣咆哮】使以自身为中心一定半径范围内的所有单位<$ba.stun>晕眩</>一段时间",
          "textFormat": "NORMAL"
        },
        {
          "text": "【雷光飞扑】蓄力后，跳跃到一定范围内我方单位较多的区域，对一定范围内的我方单位造成伤害。随后蓄力并跳跃到一定范围内我方单位攻击范围覆盖较少的区域，进行2次【蓄电】",
          "textFormat": "NORMAL"
        },
        {
          "text": "【苍雷猛进】蓄力锁定一定范围内的一名我方单位，以其为目标冲刺，若撞上高台会停止冲刺。对经过的我方单位造成伤害。随后进行2次【蓄电】",
          "textFormat": "NORMAL"
        },
        {
          "text": "【追踪雷光弹】蓄力后，跳跃到一定范围内我方单位攻击范围覆盖较少的区域，发射三个造成法术伤害的雷光弹。随后进行2次【蓄电】",
          "textFormat": "NORMAL"
        },
        {
          "text": "超带电状态",
          "textFormat": "TITLE"
        },
        {
          "text": "【苍雷之铠】免疫<$ba.palsy>麻痹</>，获得<$ba.buffres>抵抗</>",
          "textFormat": "NORMAL"
        },
        {
          "text": "【雷光逸散】受到一定伤害或进入御龙后，回到蓄电状态",
          "textFormat": "NORMAL"
        },
        {
          "text": "【真·雷鸣咆哮】使以自身为中心一定半径范围内的所有单位<$ba.stun>晕眩</>一段时间，获得持续一段时间的攻击力提升",
          "textFormat": "NORMAL"
        },
        {
          "text": "【连环重雷叩击】蓄力后，跳跃到一定范围内我方单位较多的区域，对一定范围内的我方单位造成3次伤害",
          "textFormat": "NORMAL"
        },
        {
          "text": "【缠雷突进】蓄力锁定一定范围内的一名我方单位，以其为目标冲刺，若撞上高台会停止冲刺。对经过的我方单位造成伤害",
          "textFormat": "NORMAL"
        },
        {
          "text": "【扩散雷光弹】蓄力后，跳跃到一定范围内我方单位攻击范围覆盖较少的区域，发射六个造成法术伤害的雷光弹",
          "textFormat": "NORMAL"
        },
        {
          "text": "御龙状态",
          "textFormat": "TITLE"
        },
        {
          "text": "【御龙·苍雷猛进】放置“御龙：雷狼龙”后，“雷之主”会朝目标方向冲刺。冲刺期间若撞到高台会对自身造成大量伤害。若御龙期间撞击了2次高台，则“雷之主”会倒地一段时间，期间防御力和法术抗性下降，且受到一定伤害后尾巴会被切断",
          "textFormat": "NORMAL"
        }
      ],
      "linkEnemies": [],
      "damageType": [
        "MAGIC"
      ],
      "invisibleDetail": false
    },
