    "enemy_18006_lhprie": {
      "enemyId": "enemy_18006_lhprie",
      "enemyIndex": "IL06",
      "enemyTags": null,
      "sortId": 1719,
      "name": "恩慈祷者",
      "enemyLevel": "BOSS",
      "description": "她的虔诚与仁爱有口皆碑，无数人因其施以援手而得以幸存。然而心灵的坚韧敌不过生理的转变，当她从棺椁中醒来时，她所拯救的，也将由她吃食。",
