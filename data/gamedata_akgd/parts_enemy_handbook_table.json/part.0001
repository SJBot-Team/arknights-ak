      "enemyIndex": "HRS",
      "enemyTags": null,
      "sortId": 1569,
      "name": "“异端”埃尔伯特",
      "enemyLevel": "BOSS",
      "description": "面相凶恶但性格温和的莱塔尼亚教授。他流亡至辛嘉斯王朝，尝试以一场大型实验证明他的学说，却酿成大祸而被指为异端，再次流亡至哥伦比亚。所幸，他得到了几名好学生，他们或许将会继承他的学识与疯狂。",
      "attackType": null,
      "ability": null,
      "isInvalidKilled": false,
      "overrideKillCntInfos": {},
      "hideInHandbook": false,
