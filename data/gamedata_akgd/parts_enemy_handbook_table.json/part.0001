    "enemy_1579_nstmom": {
      "enemyId": "enemy_1579_nstmom",
      "enemyIndex": "VOV",
      "enemyTags": null,
      "sortId": 1472,
      "name": "女妖河谷的拂哀菈",
      "enemyLevel": "BOSS",
      "description": "只要能再做些什么，为河谷，为女妖，为那个孩子。",
      "attackType": null,
      "ability": null,
      "isInvalidKilled": false,
      "overrideKillCntInfos": {},
      "hideInHandbook": false,
      "hideInStage": true,
      "abilityList": [
        {
          "text": "攻击造成物理伤害，并对目标周围大范围内的我方单位、热气球和强力热气球造成一定溅射伤害",
          "textFormat": "NORMAL"
        },
        {
          "text": "【归于遗忘】依次锁定最多2名我方单位造成逐渐提高的法术伤害；若其撤退或被击倒，则在技能剩余时间内使其所在“可浮空区块”额外抵消2层浮力；优先锁定地面单位",
          "textFormat": "NORMAL"
        },
        {
          "text": "【归于遗忘】结束后一段时间内，攻击力、防御力和法术抗性降低；技能锁定的目标数越多，持续时间越久",
          "textFormat": "NORMAL"
        },
        {
          "text": "生命值首次降为0时，使场地升入天空并重生",
          "textFormat": "NORMAL"
        },
        {
          "text": "升空阶段",
          "textFormat": "TITLE"
        },
        {
          "text": "场地永久变化：强制击倒处于地面的所有单位；处于地面的地块和“可浮空区块”立即损毁",
          "textFormat": "NORMAL"
        },
        {
          "text": "初始攻击力、防御力和法术抗性提高；免疫<$ba.stun>晕眩</>、<$ba.frozen>冻结</>、<$ba.fear>恐惧</>；【归于遗忘】额外锁定1名目标",
          "textFormat": "NORMAL"
        }
      ],
      "linkEnemies": [],
      "damageType": [
        "PHYSIC",
        "MAGIC"
      ],
      "invisibleDetail": false
    },
    "enemy_1580_mnchrn": {
      "enemyId": "enemy_1580_mnchrn",
      "enemyIndex": "XAN",
      "enemyTags": null,
      "sortId": 1473,
      "name": "赞索斯，复仇者",
      "enemyLevel": "BOSS",
      "description": "无论将来要面对的是什么，在此时此刻，他都要堂堂正正地向萨尔贡人，向他的同胞，向所有人发出他的质问。",
      "attackType": null,
      "ability": null,
      "isInvalidKilled": false,
      "overrideKillCntInfos": {},
      "hideInHandbook": false,
      "hideInStage": true,
      "abilityList": [
        {
          "text": "攻击为三连击",
          "textFormat": "NORMAL"
        },
        {
          "text": "【质问】未被阻挡超过10秒后，移动速度大幅提升",
          "textFormat": "NORMAL"
        },
        {
          "text": "【枯涸的河道】未被阻挡时，防御力与法术抗性大幅提升，攻击力逐渐提升（10秒后达到最大值）",
          "textFormat": "NORMAL"
        },
        {
          "text": "【破灭的想象】每次攻击损失【枯涸的河道】中增长的攻击力",
          "textFormat": "NORMAL"
        },
        {
          "text": "【郁结的恨意】首次倒下后召唤<“无数的伊萨科斯”>，随后生命值大幅提升，攻击造成物理溅射伤害，【破灭的想象】不再生效",
          "textFormat": "NORMAL"
        },
        {
          "text": "<“无数的伊萨科斯”>被击倒后受到相当于其最大生命值的真实伤害并<$ba.stun>晕眩</>，【枯涸的河道】不再生效",
          "textFormat": "NORMAL"
        }
      ],
      "linkEnemies": [
        "enemy_1581_mnchrs"
      ],
      "damageType": [
        "PHYSIC"
      ],
      "invisibleDetail": false
    },
    "enemy_1581_mnchrs": {
      "enemyId": "enemy_1581_mnchrs",
      "enemyIndex": "XAN",
      "enemyTags": null,
      "sortId": 1474,
      "name": "“无数的伊萨科斯”",
      "enemyLevel": "BOSS",
      "description": "为了保护脚下这片土地，他们尸骨无存。",
      "attackType": null,
      "ability": null,
      "isInvalidKilled": false,
      "overrideKillCntInfos": {},
      "hideInHandbook": false,
      "hideInStage": true,
      "abilityList": [
        {
          "text": "攻击为三连击，并造成物理溅射伤害",
          "textFormat": "NORMAL"
        },
        {
          "text": "【神谕示显】闪避来自非入戏状态我方单位的物理和法术伤害",
          "textFormat": "NORMAL"
        },
        {
          "text": "【“苦痛”】<“无数的伊萨科斯”>停止攻击，无敌，引导并汲取一定范围内喷泉水池的水量",
          "textFormat": "NORMAL"
        },
        {
          "text": "【“希望”】在【“苦痛”】引导结束后立即施放，无敌，在一段时间内对所有未处于入戏状态的我方单位造成数次法术伤害",
          "textFormat": "NORMAL"
        }
      ],
      "linkEnemies": [
        "enemy_1580_mnchrn"
      ],
      "damageType": [
        "PHYSIC"
      ],
      "invisibleDetail": false
    },
    "enemy_1582_suisho": {
      "enemyId": "enemy_1582_suisho",
      "enemyIndex": "SUI1",
      "enemyTags": null,
      "sortId": 1475,
      "name": "岁",
      "enemyLevel": "BOSS",
      "description": "大炎最后射落的神明，复立于对手面前。祂仰起头，望穿自太古至终末的所有时间，却未尝真正走入这人间。",
      "attackType": null,
      "ability": null,
      "isInvalidKilled": false,
      "overrideKillCntInfos": {},
      "hideInHandbook": false,
      "hideInStage": true,
      "abilityList": [
        {
          "text": "巨大的身躯横亘在场上，四个部位共享生命值且依序释放技能，单个部位受到过高伤害时，会抬起并脱离战斗",
          "textFormat": "NORMAL"
        },
        {
          "text": "部位释放技能时会抬起，无法被攻击且不再使所在地块不可部署，不可通行",
          "textFormat": "NORMAL"
        },
        {
          "text": "部位被镇岁柱影响后，会削弱对应属性以及对应部位的技能，岁全盛时拥有额外的高额属性且受到的物理与法术伤害减少",
          "textFormat": "NORMAL"
        },
        {
          "text": "【十方怼怒】抬起岁·首，一段时间后对最北边的友方单位喷吐一口火焰，造成法术伤害与<$ba.dt.burning>灼燃损伤</>，火焰随后向南爆开，使范围内持续灼烧，造成法术伤害与<$ba.dt.burning>灼燃损伤</>并引爆<“未熄”>，持续一段时间",
          "textFormat": "NORMAL"
        },
        {
          "text": "【柱折维绝】生命值低于一定比例时，召唤额外敌人且4个部位立即同时释放【十方怼怒】、【掩月】、【蔽日】、【天倾地陷】",
          "textFormat": "NORMAL"
        },
        {
          "text": "被镇岁柱削弱后，岁的攻击力降低，且【十方怼怒】的范围减少",
          "textFormat": "NORMAL"
        }
      ],
      "linkEnemies": [
        "enemy_10172_sheart",
        "enemy_1583_suizzh",
        "enemy_1584_suiyzh",
        "enemy_1585_suiwei"
      ],
      "damageType": [
        "MAGIC"
      ],
      "invisibleDetail": false
    },
    "enemy_1583_suizzh": {
      "enemyId": "enemy_1583_suizzh",
      "enemyIndex": "SUI2",
      "enemyTags": null,
      "sortId": 1476,
      "name": "岁·左爪",
      "enemyLevel": "BOSS",
      "description": "-",
      "attackType": null,
      "ability": null,
      "isInvalidKilled": false,
      "overrideKillCntInfos": {},
      "hideInHandbook": false,
      "hideInStage": true,
      "abilityList": [
        {
          "text": "【掩月】与【蔽日】共同释放，抬起岁·左爪，一段时间后，以最东的友方单位为目标爪击，对范围内的所有友方单位造成一次高额物理伤害",
          "textFormat": "NORMAL"
        },
        {
          "text": "被镇岁柱削弱后，岁的法术抗性降低，且左爪不再释放【掩月】",
