    "enemy_9022_acdumm": {
      "enemyId": "enemy_9022_acdumm",
      "enemyIndex": "SP17",
      "enemyTags": null,
      "sortId": 1738,
      "name": "假想敌：弦",
      "enemyLevel": "ELITE",
      "description": "由源石创造再现的“巫王之声”，是根据源石灾难在全泰拉爆发的想象而设计的假想敌之一。源石从没有边际的海洋中打捞起一道暗影，重新赋予它身躯与弦音。那片静止的海洋囊括了一切，唯独没有那道暗影在帕维永中窥见的未来。",
      "attackType": null,
      "ability": null,
      "isInvalidKilled": false,
      "overrideKillCntInfos": {},
      "hideInHandbook": false,
      "hideInStage": true,
      "abilityList": [
        {
          "text": "永久无敌；在<假想敌：管>被击倒后同时离场",
          "textFormat": "NORMAL"
        },
        {
          "text": "在场时，持续召唤【金黄的悲号】形态<“余音”>",
          "textFormat": "NORMAL"
        },
        {
          "text": "优先攻击【金黄的悲号】形态<“余音”>",
          "textFormat": "NORMAL"
        },
        {
          "text": "【断弦之奏】选择场上所有【金黄的悲号】形态<“余音”>，以其为中心造成一次大范围法术伤害和<$ba.dt.apoptosis>凋亡损伤</>，并转换目标<“余音”>形态",
          "textFormat": "NORMAL"
        }
      ],
      "linkEnemies": [
        "enemy_9021_acduml",
        "enemy_9023_acdums"
      ],
      "damageType": [
        "MAGIC"
      ],
      "invisibleDetail": false
    },
    "enemy_9023_acdums": {
      "enemyId": "enemy_9023_acdums",
      "enemyIndex": "SP18",
      "enemyTags": null,
      "sortId": 1739,
      "name": "“余音”",
      "enemyLevel": "NORMAL",
      "description": "残余的节拍，暗淡的回响。由谁指挥，为何颂唱？",
      "attackType": null,
      "ability": null,
      "isInvalidKilled": false,
      "overrideKillCntInfos": {},
      "hideInHandbook": false,
      "hideInStage": true,
      "abilityList": [
        {
          "text": "需要数次攻击击倒",
          "textFormat": "NORMAL"
        },
        {
          "text": "只能被阻挡数大于等于2的单位阻挡",
          "textFormat": "NORMAL"
        },
        {
          "text": "【复调】：在【金黄的悲号】与【暗色的喟叹】形态之间转换",
          "textFormat": "NORMAL"
        },
        {
          "text": "【金黄的悲号】形态时攻击速度提升，受到数次伤害后转换为【暗色的喟叹】形态",
          "textFormat": "NORMAL"
        },
        {
          "text": "【暗色的喟叹】形态时移动速度下降，攻击力提升，受到数次伤害后转换为【金黄的悲号】形态",
          "textFormat": "NORMAL"
        },
        {
          "text": "受到伤害时以自身为中心造成一次范围法术伤害和<$ba.dt.apoptosis>凋亡损伤</>",
          "textFormat": "NORMAL"
        },
        {
          "text": "全场所有<“余音”>周期性一同进行一次合奏造成范围法术伤害和<$ba.dt.apoptosis>凋亡损伤</>",
          "textFormat": "NORMAL"
        }
      ],
      "linkEnemies": [
        "enemy_9021_acduml",
        "enemy_9022_acdumm"
      ],
      "damageType": [
        "MAGIC"
      ],
      "invisibleDetail": false
    },
    "enemy_9013_acstmk_2": {
      "enemyId": "enemy_9013_acstmk_2",
      "enemyIndex": "SP08",
      "enemyTags": null,
      "sortId": 1740,
      "name": "假想敌：胄",
      "enemyLevel": "BOSS",
      "description": "被源石完全侵蚀的蒸汽甲胄，是根据源石灾难在全泰拉爆发的想象而设计的假想敌之一。源石在大地上蔓延，曾经的勇气、信念与荣耀皆归于晶尘，只留被晶簇撕裂的甲胄仍向那余晖落幕之地前行。\n将出现于隐秘核心回合并展开最终攻势。",
      "attackType": null,
      "ability": null,
      "isInvalidKilled": false,
      "overrideKillCntInfos": {},
      "hideInHandbook": true,
      "hideInStage": true,
      "abilityList": [
        {
          "text": "随机选择目标进行法术攻击",
          "textFormat": "NORMAL"
        },
        {
          "text": "生命值低于一定比例时，受到的物理与法术伤害降低，且【灭顶之灾】额外发射<刺胄之弹>",
          "textFormat": "NORMAL"
        },
        {
          "text": "【灭顶之灾】选择范围内攻击力最高的干员，对其发射一枚<刺胄之弹>，<刺胄之弹>到达目标位置时爆炸，使目标及周围8格单位<$ba.stun>晕眩</>且每秒受到物理伤害；<刺胄之弹>飞行时需要数次攻击击破",
          "textFormat": "NORMAL"
        },
        {
          "text": "【死亡集群】周期性召唤无人机单位",
          "textFormat": "NORMAL"
        },
        {
          "text": "隐秘核心",
          "textFormat": "TITLE"
        },
        {
          "text": "【旧日的剑与锤】在模拟中达成特定条件并进入隐秘核心回合时，<假想敌：胄>将展现它的完全形态",
          "textFormat": "NORMAL"
        }
      ],
      "linkEnemies": [],
      "damageType": [
        "PHYSIC",
        "MAGIC"
      ],
      "invisibleDetail": false
    },
    "enemy_9017_achunt_2": {
      "enemyId": "enemy_9017_achunt_2",
      "enemyIndex": "SP12",
      "enemyTags": null,
      "sortId": 1741,
      "name": "假想敌：铳",
      "enemyLevel": "BOSS",
      "description": "被源石占据重塑的圣卫铳骑，是根据源石灾难在全泰拉爆发的想象而设计的假想敌之一。源石在大地上蔓延，夺去一切我们尊崇的事物并取而代之，当所有的秩序被粉碎，它即是秩序。\n将出现于隐秘核心回合并展开最终攻势。",
      "attackType": null,
      "ability": null,
      "isInvalidKilled": false,
      "overrideKillCntInfos": {},
      "hideInHandbook": true,
      "hideInStage": true,
      "abilityList": [
        {
          "text": "优先攻击防御力最高的单位",
          "textFormat": "NORMAL"
        },
        {
          "text": "攻击时附带<$ba.dt.erosion>侵蚀损伤</>",
          "textFormat": "NORMAL"
        },
        {
          "text": "无法被阻挡",
          "textFormat": "NORMAL"
        },
        {
          "text": "对同一个目标进行攻击时，攻击速度逐渐提升",
          "textFormat": "NORMAL"
        },
        {
          "text": "【最终之罚】停止攻击，移动速度大幅提升，向全场防御力最高的单位冲锋。对经过的单位造成物理伤害",
          "textFormat": "NORMAL"
        },
        {
          "text": "隐秘核心",
          "textFormat": "TITLE"
        },
        {
          "text": "【未尽的告解】在模拟中达成特定条件并进入隐秘核心回合时，场上出现<“碎铳之簧”>，同时<假想敌：铳>受到的物理与法术伤害极大幅降低",
          "textFormat": "NORMAL"
        },
        {
          "text": "【盲信之誓】与场上所有<“碎铳之簧”>连结，<“碎铳之簧”>受到伤害时以一定比例传递给<假想敌：铳>和场上其他<“碎铳之簧”>，处于【盲信之誓】连结上的我方单位每秒受到物理伤害",
          "textFormat": "NORMAL"
        },
        {
          "text": "【末日布道】持续召唤场上所有<“碎铳之簧”>向自身移动，<“碎铳之簧”>移动速度大幅提升并免疫伤害，对经过的我方单位造成物理伤害",
          "textFormat": "NORMAL"
        }
      ],
      "linkEnemies": [
        "enemy_9018_actrpa"
      ],
      "damageType": [
        "PHYSIC"
      ],
      "invisibleDetail": false
    },
    "enemy_9021_acduml_2": {
      "enemyId": "enemy_9021_acduml_2",
      "enemyIndex": "SP16",
      "enemyTags": null,
      "sortId": 1742,
      "name": "假想敌：管",
      "enemyLevel": "BOSS",
      "description": "由源石创造再现的“女皇之声”，是根据源石灾难在全泰拉爆发的想象而设计的假想敌之一。源石在大地上蔓延，淹没一切赞美与斥责。晶体棱面泛起的余音，不过是源石的另一个名字。\n将出现于隐秘核心回合并展开最终攻势。",
      "attackType": null,
      "ability": null,
      "isInvalidKilled": false,
      "overrideKillCntInfos": {},
      "hideInHandbook": true,
      "hideInStage": true,
      "abilityList": [
        {
          "text": "在场时持续召唤【暗色的喟叹】形态<“余音”>；生命值低于一定比例时，召唤间隔缩短",
          "textFormat": "NORMAL"
        },
        {
          "text": "优先攻击【暗色的喟叹】形态<“余音”>",
          "textFormat": "NORMAL"
        },
        {
          "text": "【裂管之奏】选择场上所有【暗色的喟叹】形态<“余音”>进行一次三连击，造成范围法术伤害和<$ba.dt.apoptosis>凋亡损伤</>",
          "textFormat": "NORMAL"
        },
        {
          "text": "隐秘核心",
          "textFormat": "TITLE"
        },
        {
          "text": "在模拟中达成特定条件并进入隐秘核心回合时，<假想敌：弦>将与<假想敌：管>同时登场",
          "textFormat": "NORMAL"
        }
      ],
      "linkEnemies": [
        "enemy_9022_acdumm",
        "enemy_9023_acdums"
      ],
      "damageType": [
        "MAGIC"
      ],
      "invisibleDetail": false
    },
    "enemy_9032_aclionk": {
      "enemyId": "enemy_9032_aclionk",
      "enemyIndex": "ALS",
      "enemyTags": null,
      "sortId": 1743,
      "name": "阿利斯泰尔，帝国余晖",
      "enemyLevel": "BOSS",
      "description": "帝国最后的余晖，生锈冠冕下的幽灵。反驳他，反驳维多利亚无上的荣光与权力，他会审视，他可以宽恕。",
      "attackType": null,
      "ability": null,
      "isInvalidKilled": false,
      "overrideKillCntInfos": {},
      "hideInHandbook": true,
      "hideInStage": true,
      "abilityList": [
        {
          "text": "生命值降至一半及以下时，防御力及法术抗性提升，【莫非王土】每次活化两件装备",
          "textFormat": "NORMAL"
        },
        {
          "text": "【斥退】战斗经过较长时间后，对全场我方单位造成法术溅射伤害, 并扣除所有目标生命",
          "textFormat": "NORMAL"
        },
        {
          "text": "【王权号令】锁定一个我方单位及其周围四格，对范围内目标造成一次高额物理伤害并在此范围内的地块上生成随机装备",
          "textFormat": "NORMAL"
        },
        {
          "text": "【莫非王土】场上存在装备时，使一件装备活化，不同的装备将产生不同效果。",
          "textFormat": "NORMAL"
        }
      ],
      "linkEnemies": [
        "enemy_10028_vtswd",
        "enemy_10029_vtshld",
        "enemy_10030_vtwand"
      ],
      "damageType": [
        "PHYSIC"
      ],
      "invisibleDetail": false
    },
    "enemy_9033_acdeer": {
      "enemyId": "enemy_9033_acdeer",
      "enemyIndex": "SAM",
      "enemyTags": null,
      "sortId": 1744,
      "name": "“萨米的意志”",
      "enemyLevel": "BOSS",
      "description": "因萨米的一个念想从土石和冰雪中诞生，在这个念想得到满足前，它将在此矗立，阻挡一切生灵的去路。",
      "attackType": null,
      "ability": null,
      "isInvalidKilled": false,
      "overrideKillCntInfos": {},
      "hideInHandbook": true,
      "hideInStage": true,
      "abilityList": [
        {
          "text": "【冰凌】攻击时对整列的我方单位造成物理伤害",
          "textFormat": "NORMAL"
        },
        {
          "text": "【自然涌动】使一名我方单位<$ba.stun>晕眩</>并持续受到法术伤害",
          "textFormat": "NORMAL"
        },
        {
          "text": "生命值低于一半时，受到的物理和法术伤害降低，【冰凌】和【自然涌动】额外选择一个目标",
          "textFormat": "NORMAL"
        }
      ],
      "linkEnemies": [],
