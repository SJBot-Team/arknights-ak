    "enemy_10232_aglina": {
      "enemyId": "enemy_10232_aglina",
      "enemyIndex": "AG",
      "enemyTags": null,
      "sortId": 1209,
      "name": "信使安洁莉娜",
      "enemyLevel": "ELITE",
      "description": "罗德岛的信使安洁莉娜。\n这场比赛的热闹程度超乎想象，但她相信自己能够处理好这一切，因为她已经是一个成熟的信使啦！",
      "attackType": null,
      "ability": null,
      "isInvalidKilled": false,
      "overrideKillCntInfos": {},
      "hideInHandbook": false,
      "hideInStage": true,
      "abilityList": [
        {
          "text": "飞行友好单位",
          "textFormat": "NORMAL"
        },
        {
          "text": "优先拾取场上<浮空信件>并投进<邮箱>",
          "textFormat": "NORMAL"
        },
        {
          "text": "每隔一段时间及投入<浮空信件>后，会选择多名场上我方干员，回复其一定技力并使其攻击速度提升一段时间",
          "textFormat": "NORMAL"
        },
        {
          "text": "会攻击自身周围数名敌人，使其<$ba.levitate>浮空</>及<$ba.sluggish>停顿</>一段时间",
          "textFormat": "NORMAL"
        },
        {
          "text": "投满<邮箱>时，会立即攻击自身周围所有敌人，使其<$ba.levitate>浮空</>及<$ba.sluggish>停顿</>较长时间。每次投满<邮箱>，会使自身选择我方干员数量、回复其技力及提高其攻速数值永久提升。会使自身攻击敌人数量、<$ba.levitate>浮空</>及<$ba.sluggish>停顿</>敌人时间永久提升",
          "textFormat": "NORMAL"
        }
      ],
