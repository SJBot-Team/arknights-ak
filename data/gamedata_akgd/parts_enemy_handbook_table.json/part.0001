    "enemy_9012_acloon": {
      "enemyId": "enemy_9012_acloon",
      "enemyIndex": "SP07",
      "enemyTags": null,
      "sortId": 1728,
      "name": "“炎佑”",
      "enemyLevel": "ELITE",
      "description": "炎国天师能够施展机关术，令凡铁俗木借火势而翔空，化作满天星火，护佑山水百姓。遇节庆则为宣瑞之明灯，遇争战则为除恶之雄兵。",
      "attackType": null,
      "ability": null,
      "isInvalidKilled": true,
      "overrideKillCntInfos": {},
      "hideInHandbook": false,
      "hideInStage": true,
      "abilityList": [
        {
          "text": "战斗开始时，“炎佑”获得等于当前场地所有炎盟约干员一定比例的攻击力与生命值",
          "textFormat": "NORMAL"
        },
        {
          "text": "同时攻击数个目标，攻击附带攻击力一定比例的<$ba.dt.burning2>灼燃损伤</>且周围的敌方单位受到一定比例的<$ba.elementfragile>元素脆弱</>",
          "textFormat": "NORMAL"
        },
        {
          "text": "【祛恶之焰】对攻击范围内的一名敌人持续喷射火焰，每秒造成攻击力一定比例的法术伤害，同时对目标周围至多数个敌人也造成伤害",
          "textFormat": "NORMAL"
        }
      ],
      "linkEnemies": [],
      "damageType": [
        "MAGIC"
      ],
      "invisibleDetail": false
    },
    "enemy_9013_acstmk": {
      "enemyId": "enemy_9013_acstmk",
      "enemyIndex": "SP08",
      "enemyTags": null,
      "sortId": 1729,
      "name": "假想敌：胄",
      "enemyLevel": "BOSS",
      "description": "被源石完全侵蚀的蒸汽甲胄，是根据源石灾难在全泰拉爆发的想象而设计的假想敌之一。源石在大地上蔓延，曾经的勇气、信念与荣耀皆归于晶尘，只留被晶簇撕裂的甲胄仍向那余晖落幕之地前行。",
      "attackType": null,
      "ability": null,
      "isInvalidKilled": false,
      "overrideKillCntInfos": {},
      "hideInHandbook": false,
      "hideInStage": true,
      "abilityList": [
        {
          "text": "随机选择目标发射射线造成法术伤害",
          "textFormat": "NORMAL"
        },
        {
          "text": "【灭顶之灾】选择攻击力最高的干员对其发射一枚<刺胄之弹>，<刺胄之弹>到达目标位置时爆炸使目标及周围8格单位<$ba.stun>晕眩</>较长时间且每秒受到物理伤害；<刺胄之弹>飞行时对其造成数次攻击可将其击破",
          "textFormat": "NORMAL"
        },
        {
          "text": "生命值低于一定比例时，受到的物理与法术伤害降低，【灭顶之灾】额外发射<刺胄之弹>",
          "textFormat": "NORMAL"
        },
        {
          "text": "【死亡集群】周期性召唤无人机单位",
          "textFormat": "NORMAL"
        },
        {
          "text": "隐秘核心",
          "textFormat": "TITLE"
        },
        {
          "text": "【旧日的剑与锤】在模拟中达成特定条件并进入隐秘核心回合时，<假想敌：胄>将获得<“斩胄之剑”>和<“破胄之锤”>以完全形态登场",
          "textFormat": "NORMAL"
        },
        {
          "text": "<“斩胄之剑”>和<“破胄之锤”>初始无敌；被击落时受到伤害以一定比例传递给<假想敌：胄>",
          "textFormat": "NORMAL"
        },
        {
          "text": "<“斩胄之剑”>和<“破胄之锤”>周期性飞向场上攻击力最低的一名干员并自爆，使目标及其周围8格的干员<$ba.stun>晕眩</>，每秒受到物理伤害，随后返回<假想敌：胄>身边；飞行途中失去无敌且受到一定次数伤害后会被击落；被击落后，视为地面单位且受到的伤害增加",
          "textFormat": "NORMAL"
        }
      ],
      "linkEnemies": [],
      "damageType": [
        "PHYSIC",
        "MAGIC"
      ],
      "invisibleDetail": false
    },
    "enemy_9014_acstma": {
