    "enemy_6018_carrier": {
      "enemyId": "enemy_6018_carrier",
      "enemyIndex": "DL18",
      "enemyTags": null,
      "sortId": 1597,
      "name": "“无根之怨”",
      "enemyLevel": "BOSS",
      "description": "农业无人机的空中指挥中心。多年来，它兢兢业业地养育实验田里的作物，逐渐把自己当成了它们的同类，却因自己漂浮无根而落寞。被载入了恶意程序后，这份落寞扭曲成了对地上生灵的怨恨。",
      "attackType": null,
      "ability": null,
      "isInvalidKilled": false,
      "overrideKillCntInfos": {},
      "hideInHandbook": false,
      "hideInStage": true,
      "abilityList": [
        {
          "text": "飞行单位",
          "textFormat": "NORMAL"
        },
        {
          "text": "每隔一段时间于自身位置召唤数个无人机单位",
          "textFormat": "NORMAL"
        },
        {
          "text": "自身周围存在无人机单位时，获得<$ba.invisible>隐匿</>",
          "textFormat": "NORMAL"
        },
        {
          "text": "【“怨恨撒播”】立即召唤数架<播种无人机>，并使自身一定范围内的所有无人机获得一定攻击力和生命值，持续一段时间。技能结束时，若范围内没有<播种无人机>，则停止移动并获得一段时间<$ba.fragile>脆弱</>",
          "textFormat": "NORMAL"
        }
      ],
