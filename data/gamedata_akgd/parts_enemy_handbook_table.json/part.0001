    "enemy_2147_shophm": {
      "enemyId": "enemy_2147_shophm",
      "enemyIndex": "TL",
      "enemyTags": null,
      "sortId": 1572,
      "name": "洛伦茨，扰动之谬",
      "enemyLevel": "BOSS",
      "description": "哥伦比亚“源阶方”项目的首席科学家，前项目负责人罗伯特的女儿——托妮·洛伦茨。仇恨、悔意与爱化作流散的数据，又如流沙聚合，她已经在过去的时间里见到了太多。现在，通向唯一结果的路在她面前展开，而她将亲手按下终结一切的按钮。",
      "attackType": null,
      "ability": null,
      "isInvalidKilled": false,
      "overrideKillCntInfos": {},
      "hideInHandbook": false,
      "hideInStage": true,
      "abilityList": [
        {
          "text": "试图向<源阶方>移动，到达终点时摧毁<源阶方>，扣除30点目标生命，并使全场单位持续受到真实伤害",
          "textFormat": "NORMAL"
        },
        {
          "text": "【象限封锁】封锁附近的地面，使其永久无法部署我方单位",
          "textFormat": "NORMAL"
        },
        {
          "text": "被击倒时，使<源阶方>解除无敌并开始行动",
          "textFormat": "NORMAL"
        }
      ],
      "linkEnemies": [
        "enemy_2148_shorbb"
      ],
      "damageType": [
        "MAGIC"
      ],
      "invisibleDetail": false
    },
    "enemy_2148_shorbb": {
      "enemyId": "enemy_2148_shorbb",
      "enemyIndex": "OFT",
      "enemyTags": null,
      "sortId": 1573,
      "name": "源阶方",
      "enemyLevel": "BOSS",
      "description": "两代洛伦茨研究的最终成果，启动后将会把源石蕴含的能量转化成第三相态，造成不可估量的信息污染与篡改。没有人知道这种规模的源石能量全部被激活的后果，也没有人想知道。",
      "attackType": null,
      "ability": null,
      "isInvalidKilled": false,
      "overrideKillCntInfos": {},
      "hideInHandbook": false,
      "hideInStage": true,
      "abilityList": [
        {
          "text": "初始无敌，<洛伦茨，扰动之谬>被击杀后解除无敌并开始行动，召唤数个<源阶方模块>",
          "textFormat": "NORMAL"
        },
        {
          "text": "受到的物理和法术伤害减少，如果伤害来自左右两侧则进一步减少",
          "textFormat": "NORMAL"
        },
        {
          "text": "【失链裂变】对全场我方单位造成法术伤害，自身生命值小于一半时冷却时间降低",
          "textFormat": "NORMAL"
        },
        {
          "text": "召唤源阶粒素，自身生命值小于一半时，召唤更多源阶粒素",
          "textFormat": "NORMAL"
        },
        {
          "text": "<源阶方模块>全部消失后，自身重新进入无敌，<洛伦茨，扰动之谬>返回战场",
          "textFormat": "NORMAL"
        }
      ],
      "linkEnemies": [
        "enemy_2147_shophm"
      ],
      "damageType": [
        "MAGIC"
      ],
      "invisibleDetail": false
    },
    "enemy_2150_shchmr": {
      "enemyId": "enemy_2150_shchmr",
      "enemyIndex": "CBV",
      "enemyTags": null,
      "sortId": 1574,
      "name": "玻利瓦尔，症结之核",
      "enemyLevel": "BOSS",
      "description": "我们终究会和自己最丑陋的部分相伴一生，并始终尝试战胜它们，或者被它们吞噬。",
      "attackType": null,
      "ability": null,
      "isInvalidKilled": false,
      "overrideKillCntInfos": {},
      "hideInHandbook": false,
      "hideInStage": true,
      "abilityList": [
        {
          "text": "第一形态",
          "textFormat": "TITLE"
        },
        {
          "text": "攻击会降低目标的防御力",
          "textFormat": "NORMAL"
        },
        {
          "text": "【灾厄之口】生命值降为0时释放：暂时离场，立刻摧毁场上的“危朽”或“崩解”，长时间封锁待部署区单位；\n选中全场生命值最高的干员，持续对其周围造成高额真实伤害，并对全场其余目标造成较少法术伤害；\n被选中目标离场会延长【灾厄之口】的持续时间；技能结束后进入下一形态",
          "textFormat": "NORMAL"
        },
        {
          "text": "第二形态",
          "textFormat": "TITLE"
        },
        {
          "text": "【未熄之地】对一名目标发射火球造成法术伤害，在目标周围留下造成持续法术伤害的火焰，优先选取未处于火中的目标",
          "textFormat": "NORMAL"
        },
        {
          "text": "生命值降为0时，再次释放【灾厄之口】，技能结束后返回场上并转为下一形态",
          "textFormat": "NORMAL"
        },
        {
          "text": "第三形态",
          "textFormat": "TITLE"
        },
        {
          "text": "周期性起飞一段时间，起飞时不进行普通攻击但会频繁释放【未熄之地】",
          "textFormat": "NORMAL"
        },
        {
          "text": "经过较长时间后，再次释放【灾厄之口】",
          "textFormat": "NORMAL"
        }
      ],
      "linkEnemies": [],
      "damageType": [
        "PHYSIC",
        "MAGIC"
      ],
      "invisibleDetail": false
    },
