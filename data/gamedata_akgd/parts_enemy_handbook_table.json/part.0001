    "enemy_1527_martyr": {
      "enemyId": "enemy_1527_martyr",
      "enemyIndex": "AND",
      "enemyTags": null,
      "sortId": 1421,
      "name": "“殉道者”，安多恩",
      "enemyLevel": "BOSS",
      "description": "为了提出一个问题不惜与拉特兰为敌的萨科塔，为了得到一个答案甘愿踏上苦难之路的寻路者。他不愤怒，不悲伤，不归咎上天，不苛求他人。安多恩只是走在自己的道路上，直到尽头。",
      "attackType": null,
      "ability": null,
      "isInvalidKilled": false,
      "overrideKillCntInfos": {},
      "hideInHandbook": false,
      "hideInStage": true,
      "abilityList": [
        {
          "text": "无法被阻挡",
          "textFormat": "NORMAL"
        },
        {
          "text": "携带弹药时攻击力提升，弹药上限：5",
          "textFormat": "NORMAL"
        },
        {
          "text": "攻击目标后弹药会弹射至目标周围的下一个单位，最多弹射5次，弹药对“冰淇淋机”造成额外伤害",
          "textFormat": "NORMAL"
        },
        {
          "text": "第一形态",
          "textFormat": "TITLE"
        },
        {
          "text": "【光赐于苦】每损失一定比例生命值释放永久地面效果，处于该范围中的所有敌方单位受到的物理或法术伤害减少并获得50%的物理及法术闪避",
          "textFormat": "NORMAL"
        },
        {
          "text": "第二形态",
          "textFormat": "TITLE"
        },
        {
          "text": "首次死亡后进入第二形态，攻击力提升",
          "textFormat": "NORMAL"
        },
        {
          "text": "【皆为尘土】安多恩停止攻击，从左到右扫描整个地图，锁定最多5个单位，扫描后对锁定的目标发动一次强大的物理攻击并使弹药数量恢复至上限。",
          "textFormat": "NORMAL"
        },
        {
          "text": "每损失更少的生命比例就释放【光赐于苦】",
          "textFormat": "NORMAL"
        }
      ],
      "linkEnemies": [],
      "damageType": [
        "PHYSIC"
      ],
      "invisibleDetail": false
    },
    "enemy_1528_manfri": {
