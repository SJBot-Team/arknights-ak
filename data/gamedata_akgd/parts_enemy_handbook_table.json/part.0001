    "enemy_1593_musnake": {
      "enemyId": "enemy_1593_musnake",
      "enemyIndex": "E0B",
      "enemyTags": null,
      "sortId": 1484,
      "name": "“终始”",
      "enemyLevel": "BOSS",
      "description": "没有绝对的起点，没有绝对的终点，在自我吞噬中自我孕育，它以此走向长久的闭合。直到今日，这个圆环断出拒不愈合的缺口，而她，将成为缺口上的起点。",
      "attackType": null,
      "ability": null,
      "isInvalidKilled": false,
      "overrideKillCntInfos": {},
      "hideInHandbook": false,
      "hideInStage": true,
      "abilityList": [
        {
          "text": "每失去一定生命值，获得无敌，期间若完成指定交互则受到伤害并<$ba.stun>晕眩</>一段时间，否则回复一定生命值",
          "textFormat": "NORMAL"
        },
        {
          "text": "【防火墙】自身周围的边界拥有“防火墙”，受到来自“防火墙”外的物理与法术伤害大幅降低",
          "textFormat": "NORMAL"
        },
        {
          "text": "【信息洪流】对固定方向发射信息洪流，使首个击中的单位<$ba.stun>晕眩</>一段时间，期间持续受到真实伤害",
          "textFormat": "NORMAL"
        },
        {
          "text": "【中断】战斗经过较长时间后，消失，并扣除50点目标生命",
          "textFormat": "NORMAL"
        },
        {
          "text": "无法被传送",
          "textFormat": "NORMAL"
        }
      ],
      "linkEnemies": [
        "enemy_1590_muama",
        "enemy_1591_mutwin"
      ],
      "damageType": [
        "NO_DAMAGE"
      ],
      "invisibleDetail": false
    },
    "enemy_1595_agbmes": {
      "enemyId": "enemy_1595_agbmes",
      "enemyIndex": "MM01",
      "enemyTags": null,
      "sortId": 1485,
      "name": "“酣睡飞行员”",
      "enemyLevel": "BOSS",
      "description": "有史以来人们见过的最大的一只有袋鼷兽！它盘踞在收集到的宝物之中，睡得格外舒心。\n吵醒它会怎么样？或者说......它真的能被吵醒吗？它怎么边睡边飞啊！",
      "attackType": null,
      "ability": null,
      "isInvalidKilled": false,
      "overrideKillCntInfos": {},
      "hideInHandbook": false,
      "hideInStage": true,
      "abilityList": [
        {
          "text": "【怎么不见了......】可以携带多封<浮空信件>，每携带一封<浮空信件>，防御力和法术抗性提升",
          "textFormat": "NORMAL"
        },
        {
          "text": "【搜罗宝物】持续施法，吸收场上的<浮空信件>及<“超惊喜信件”>",
          "textFormat": "NORMAL"
        },
        {
          "text": "【巡回偷袭】变为飞行状态一段时间。飞行状态下会持续轰炸自身所在位置的地面和高台，造成范围物理伤害。受到阻挡数秒后会立即降落。",
          "textFormat": "NORMAL"
        },
        {
          "text": "【叽，大意了！】降落时会瘫痪一段时间，瘫痪期间每受到一定次数伤害会掉落一封<浮空信件>",
          "textFormat": "NORMAL"
        },
        {
          "text": "【超惊喜派送】选择多名我方单位，在其所在位置投放<“超惊喜信件”>",
          "textFormat": "NORMAL"
        },
        {
          "text": "生命值首次降为0时，对三名我方非<$ba.liftoff>起飞</>单位所在行进行地毯式轰炸。重生后获得【领地宣示！】技能",
          "textFormat": "NORMAL"
        },
        {
          "text": "【领地宣示！】选择数名我方非<$ba.liftoff>起飞</>单位，对其所在行进行地毯式轰炸",
          "textFormat": "NORMAL"
        }
      ],
      "linkEnemies": [
        "enemy_1596_agbmal"
      ],
      "damageType": [
        "PHYSIC"
      ],
      "invisibleDetail": false
    },
    "enemy_1596_agbmal": {
      "enemyId": "enemy_1596_agbmal",
      "enemyIndex": "MM02",
      "enemyTags": null,
      "sortId": 1486,
      "name": "“超惊喜信件”",
      "enemyLevel": "NORMAL",
      "description": "看起来金光闪闪的信封，让人好奇里面放的究竟是什么。\n悄悄打开看一下......嗖——嘣！",
      "attackType": null,
      "ability": null,
      "isInvalidKilled": false,
