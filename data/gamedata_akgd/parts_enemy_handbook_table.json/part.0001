    "enemy_1523_mandra": {
      "enemyId": "enemy_1523_mandra",
      "enemyIndex": "MD",
      "enemyTags": null,
      "sortId": 1417,
      "name": "蔓德拉",
      "enemyLevel": "BOSS",
      "description": "深池部队的头领之一，操纵岩石的术师。她来自维多利亚的阴影深处，誓要将过去从贵族们手下受过的屈辱悉数奉还。",
