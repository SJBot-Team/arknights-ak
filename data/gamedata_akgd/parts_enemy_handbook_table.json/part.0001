        {
          "text": "【崩坍】对若干我方单位造成物理伤害",
          "textFormat": "NORMAL"
        },
        {
          "text": "【断裂生殖】召唤子代缠绕我方单位使其<$ba.stun>晕眩</>",
          "textFormat": "NORMAL"
        },
        {
          "text": "【物种爆发】战斗经过较长时间后扣除所有目标生命",
          "textFormat": "NORMAL"
        }
      ],
      "linkEnemies": [],
