    "enemy_9009_acfort": {
      "enemyId": "enemy_9009_acfort",
      "enemyIndex": "SP04",
      "enemyTags": null,
      "sortId": 1725,
      "name": "假想敌：黑云",
      "enemyLevel": "ELITE",
      "description": "参照源石尘降前出现的天灾云而设计的假想敌。天灾是文明长久的敌人，天灾云之下的源石聚合体是死亡的象征。必须在模拟的战斗中找到应对天灾的更多方法。",
      "attackType": null,
      "ability": null,
      "isInvalidKilled": false,
      "overrideKillCntInfos": {},
      "hideInHandbook": false,
      "hideInStage": true,
      "abilityList": [
        {
          "text": "周期性束缚并吞噬数个非精英领袖飞行敌人，并回复等量弹药",
          "textFormat": "SILENCE"
        },
        {
          "text": "一次性消耗所有弹药对目标造成大量物理伤害",
          "textFormat": "SILENCE"
        }
      ],
      "linkEnemies": [],
      "damageType": [
        "PHYSIC"
      ],
