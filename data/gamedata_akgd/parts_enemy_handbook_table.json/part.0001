    "enemy_8016_misery": {
      "enemyId": "enemy_8016_misery",
      "enemyIndex": "SFR12",
      "enemyTags": null,
      "sortId": 1655,
      "name": "“Misery”，静默之刃",
      "enemyLevel": "BOSS",
      "description": "以Misery的战力极限为模本构拟的突破训练官。\n擅长空间源石技艺的潜行者，他悠闲把玩手中匕首的姿态亦是牵制对手注意力的策略之一。注意，他不太喜欢“刺客”这个称呼。",
      "attackType": null,
      "ability": null,
      "isInvalidKilled": false,
      "overrideKillCntInfos": {},
      "hideInHandbook": false,
      "hideInStage": true,
      "abilityList": [
        {
          "text": "处于黑夜笼罩的地块时，拥有100%物理和法术闪避",
          "textFormat": "NORMAL"
        },
        {
          "text": "【瞬时性伤痕】对全场生命上限最低的干员造成高额物理伤害，被击倒的目标再部署时间大幅延长；连续三次命中同一目标后使其失去视野",
          "textFormat": "NORMAL"
        },
        {
          "text": "【消解性空间】受到晕眩、寒冷、冻结、恐惧、诱导状态或失衡时，立即解除，回复一定生命值并免疫上述状态数秒",
          "textFormat": "NORMAL"
        },
        {
          "text": "首次被击倒后，返回战场并改变行动方式：处于我方视野时立即移动到黑夜笼罩的地块并停止移动（移动路线中无友方单位）；施放【瞬时性伤痕】后或找不到目标时继续移动",
          "textFormat": "NORMAL"
        },
        {
          "text": "【弥散性裂变】攻击和【瞬时性伤痕】施加持续法术伤害，持续期间内退场的目标再部署时间大幅延长",
          "textFormat": "NORMAL"
        }
      ],
      "linkEnemies": [],
      "damageType": [
        "PHYSIC",
        "MAGIC"
      ],
      "invisibleDetail": false
    },
    "enemy_8016_misery_1": {
      "enemyId": "enemy_8016_misery_1",
      "enemyIndex": "SFR12",
      "enemyTags": null,
      "sortId": 1656,
      "name": "“Misery”，静默之刃",
      "enemyLevel": "BOSS",
      "description": "以Misery的战力极限为模本构拟的突破训练官。\n擅长空间源石技艺的潜行者，他悠闲把玩手中匕首的姿态亦是牵制对手注意力的策略之一。注意，他不太喜欢“刺客”这个称呼。",
      "attackType": null,
      "ability": null,
      "isInvalidKilled": false,
      "overrideKillCntInfos": {},
      "hideInHandbook": true,
      "hideInStage": false,
      "abilityList": [
        {
          "text": "处于黑夜笼罩的地块时，拥有100%物理和法术闪避",
          "textFormat": "NORMAL"
        },
        {
          "text": "【瞬时性伤痕】对全场生命上限最低的干员造成高额物理伤害，被击倒的目标再部署时间大幅延长；连续三次命中同一目标后使其失去视野",
          "textFormat": "NORMAL"
        },
        {
          "text": "【消解性空间】受到晕眩、寒冷、冻结、恐惧、诱导状态或失衡时，立即解除，回复一定生命值并免疫上述状态数秒",
          "textFormat": "NORMAL"
        }
      ],
      "linkEnemies": [],
      "damageType": [
        "PHYSIC"
      ],
      "invisibleDetail": false
    },
