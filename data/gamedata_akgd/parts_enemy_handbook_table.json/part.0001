      "abilityList": [
        {
          "text": "生命值降至一半以下时攻击力大幅度提升",
          "textFormat": "NORMAL"
        },
        {
          "text": "【冲锋】锁定前方路径范围内的一名目标，一定时间内移动速度大幅提升",
          "textFormat": "NORMAL"
        },
        {
          "text": "首次被击倒后重生，恢复一半生命值",
          "textFormat": "NORMAL"
        }
      ],
