    "enemy_6004_pleslm": {
      "enemyId": "enemy_6004_pleslm",
      "enemyIndex": "DL4",
      "enemyTags": null,
      "sortId": 1583,
      "name": "“米兰”",
      "enemyLevel": "BOSS",
      "description": "逃入荒野的家养源石虫，在地层高压环境下产生了变异。体型巨大，背部结晶厚实，攻击性不强且极为擅长与人类“互动”。它对于人类的看法还停留在曾经的家养时光中，从前的玩乐举动，如今随着体型变化，变成了真真切切的破坏活动。",
      "attackType": null,
      "ability": null,
      "isInvalidKilled": false,
      "overrideKillCntInfos": {},
      "hideInHandbook": false,
      "hideInStage": true,
      "abilityList": [
        {
          "text": "生命值低于一半时攻击力大幅提升、受到的法术与物理伤害降低",
          "textFormat": "NORMAL"
        },
        {
          "text": "往待部署区加入一张污染晶石(最多一张)",
          "textFormat": "NORMAL"
        },
        {
          "text": "往预备区加入一张聚热晶簇(被调度时对全场我方单位造成真实伤害并<$ba.stun>晕眩</>数秒）",
          "textFormat": "NORMAL"
