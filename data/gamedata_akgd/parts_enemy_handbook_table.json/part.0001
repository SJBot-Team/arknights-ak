    "enemy_6019_escort": {
      "enemyId": "enemy_6019_escort",
      "enemyIndex": "DL19",
      "enemyTags": null,
      "sortId": 1598,
      "name": "播种无人机",
      "enemyLevel": "NORMAL",
      "description": "用于播种的农业无人机，集成了播种、灌溉、施肥多项功能。它为自己承担的职责而自豪，更以体内的纯天然肥料发酵系统为傲。“任何人都无法拒绝热腾腾的优质肥料。”",
      "attackType": null,
      "ability": null,
      "isInvalidKilled": false,
      "overrideKillCntInfos": {},
      "hideInHandbook": false,
      "hideInStage": true,
      "abilityList": [
        {
          "text": "每攻击2次，下次攻击使我方干员<$ba.stun>晕眩</>数秒",
