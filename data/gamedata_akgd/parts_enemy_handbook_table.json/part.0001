      ],
      "invisibleDetail": false
    },
    "enemy_2119_dyshhj": {
      "enemyId": "enemy_2119_dyshhj",
      "enemyIndex": "SUI",
      "enemyTags": null,
      "sortId": 1556,
      "name": "“岁”",
      "enemyLevel": "BOSS",
      "description": "大炎最后射落的神明半梦半醒间显现的样貌。一位代理人替换了其中的意义，以身代岁，似要令其完全苏醒。",
      "attackType": null,
      "ability": null,
      "isInvalidKilled": false,
      "overrideKillCntInfos": {},
      "hideInHandbook": false,
      "hideInStage": true,
      "abilityList": [
        {
          "text": "常态不存在于场上，周期性锁定身边我方单位数最多的我方目标，发动【不寐】并停留在场上一段时间",
          "textFormat": "NORMAL"
        },
        {
          "text": "【不寐】使目标和周围8格的我方单位强制撤退，生成封印的地面并持续一段时间",
          "textFormat": "NORMAL"
        },
        {
          "text": "【撼山河】发动【不寐】后，拍击地面三次，对全场所有我方单位造成三次无视迷彩的高额物理伤害",
          "textFormat": "NORMAL"
        },
        {
          "text": "生命值低于一定比例时，立即发动一次使全场单位强制撤退的【不寐】",
          "textFormat": "NORMAL"
        },
        {
          "text": "战斗经过较长时间后，发动一次【不寐】后退场，并扣除50点目标生命",
          "textFormat": "NORMAL"
        }
      ],
      "linkEnemies": [],
      "damageType": [
        "PHYSIC"
      ],
      "invisibleDetail": false
    },
    "enemy_2119_dyshhj_2": {
      "enemyId": "enemy_2119_dyshhj_2",
      "enemyIndex": "SQ",
      "enemyTags": null,
      "sortId": 1557,
      "name": "“岁躯”",
      "enemyLevel": "BOSS",
      "description": "由缠墨岁雕所化，隐逸云间，伺机而动，誓要将人的烛火吹灭。",
      "attackType": null,
      "ability": null,
      "isInvalidKilled": false,
      "overrideKillCntInfos": {},
      "hideInHandbook": true,
      "hideInStage": true,
      "abilityList": [
        {
          "text": "常态不存在于场上，锁定身边人数最多的我方目标，发动【不寐】",
          "textFormat": "NORMAL"
        },
        {
          "text": "【不寐】使目标和周围8格的干员强制撤退，生成封印的地面并持续一段时间",
          "textFormat": "NORMAL"
        },
        {
          "text": "发动【不寐】并停留在场上一段时间后退场，不扣除目标生命",
          "textFormat": "NORMAL"
        }
      ],
      "linkEnemies": [],
