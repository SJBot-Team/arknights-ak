    "enemy_1537_mhrors": {
      "enemyId": "enemy_1537_mhrors",
      "enemyIndex": "6935",
      "enemyTags": null,
      "sortId": 1433,
      "name": "火龙",
      "enemyLevel": "BOSS",
      "description": "身覆赤色甲壳，掌控火焰的火龙，具备飞龙种优秀的飞行能力，以空中突袭和火球吐息的配合压制诸多生物。由于其统治天空的惊人实力，它也被誉为“天空王者”。",
      "attackType": null,
      "ability": null,
      "isInvalidKilled": false,
      "overrideKillCntInfos": {},
      "hideInHandbook": false,
      "hideInStage": true,
      "abilityList": [
        {
          "text": "只能被阻挡数大于等于3的单位阻挡",
          "textFormat": "NORMAL"
        },
        {
          "text": "陆行姿态",
          "textFormat": "TITLE"
        },
        {
          "text": "从背后攻击陆行姿态下的火龙可以将其尾巴切断",
          "textFormat": "NORMAL"
        },
        {
          "text": "【咆哮】使所有友方单位眩晕",
          "textFormat": "NORMAL"
        },
        {
          "text": "【甩尾】对背面半圆范围的目标造成物理伤害",
          "textFormat": "NORMAL"
        },
        {
          "text": "【火球】对我方目标造成法术伤害",
          "textFormat": "NORMAL"
        },
        {
          "text": "【凌空凶焰】对面前造成法术伤害，切换为空中姿态",
          "textFormat": "NORMAL"
        },
        {
          "text": "飞行姿态",
          "textFormat": "TITLE"
        },
        {
          "text": "眩光手雷可以击坠飞行姿态的火龙",
          "textFormat": "NORMAL"
        },
        {
          "text": "【空中爪攻击】对周围圆形范围的目标造成物理伤害",
          "textFormat": "NORMAL"
        },
        {
          "text": "【爆炎吐息】对前方喷出扇形火焰，造成法术伤害",
          "textFormat": "NORMAL"
        },
        {
          "text": "【烈火扫射】沿直线扫出一道火柱，对前方最近三排的所有目标造成法术伤害",
          "textFormat": "NORMAL"
        },
        {
          "text": "返巢阶段",
          "textFormat": "TITLE"
        },
        {
          "text": "【返巢】未在第一波击败火龙时，火龙会移至巢穴",
          "textFormat": "NORMAL"
        }
      ],
      "linkEnemies": [],
      "damageType": [
        "PHYSIC",
        "MAGIC"
      ],
      "invisibleDetail": false
    },
    "enemy_1539_reid": {
      "enemyId": "enemy_1539_reid",
      "enemyIndex": "A15",
      "enemyTags": null,
      "sortId": 1434,
      "name": "“复仇者”",
      "enemyLevel": "BOSS",
      "description": "曾经遭遇过的整合运动干部，使用令人印象深刻的炙热长刀进行攻击。那个曾在59区废墟被你击败的劲敌，将重新出现在你面前，划出复仇的烈焰。",
      "attackType": null,
      "ability": null,
      "isInvalidKilled": false,
