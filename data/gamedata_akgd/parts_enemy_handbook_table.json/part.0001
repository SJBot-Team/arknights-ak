    "enemy_7051_xbcas": {
      "enemyId": "enemy_7051_xbcas",
      "enemyIndex": "SD44",
      "enemyTags": null,
      "sortId": 1681,
      "name": "拟南兽",
      "enemyLevel": "ELITE",
      "description": "长满了拟南苗的奇妙苔生兽。拟南苗是阿尔萨兰特有的气象指示植物，结构十分简单，但对环境变化非常敏感。与拟南苗共生的拟南兽则利用这一点来判断天气变化。",
      "attackType": null,
      "ability": null,
      "isInvalidKilled": false,
      "overrideKillCntInfos": {},
      "hideInHandbook": false,
      "hideInStage": true,
      "abilityList": [
        {
          "text": "异兽",
          "textFormat": "NORMAL"
        },
        {
          "text": "在<雷暴><阵雷>时，雷暴总是会在拟南兽经过的地块出现且自身免疫雷暴伤害",
          "textFormat": "NORMAL"
        },
        {
          "text": "在<烈阳天><骄阳天>时，攻击附带攻击力一定比例的<$ba.dt.burning>灼燃损伤</>且一定距离的我方单位<$ba.dt.burning>灼燃损伤</>爆发时额外受到伤害",
          "textFormat": "NORMAL"
        },
        {
          "text": "在<大沙尘暴><沙尘暴>时，获得<$ba.invisible>隐匿</>，攻击范围扩大",
          "textFormat": "NORMAL"
        }
      ],
      "linkEnemies": [],
      "damageType": [
        "MAGIC"
      ],
      "invisibleDetail": false
    },
    "enemy_7053_xbcasz": {
