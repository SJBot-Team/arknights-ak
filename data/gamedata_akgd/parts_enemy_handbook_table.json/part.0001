    "enemy_2145_cadejo": {
      "enemyId": "enemy_2145_cadejo",
      "enemyIndex": "CDJ",
      "enemyTags": null,
      "sortId": 1570,
      "name": "卡德霍，黑流之源",
      "enemyLevel": "BOSS",
      "description": "犬之主，其身躯即是黑流树海本身。祂的血液滋养了玻利瓦尔的土地，以及在此繁衍生息的一代代生命。而一场邪恶的图谋将其洞穿，空虚的痛楚唤起永恒的饥渴——索取这片大地的生命，去填补那已变成黑色孔洞的太阳。",
      "attackType": null,
      "ability": null,
      "isInvalidKilled": false,
      "overrideKillCntInfos": {},
      "hideInHandbook": false,
      "hideInStage": true,
      "abilityList": [
        {
          "text": "优先攻击阻挡数最高的目标",
          "textFormat": "NORMAL"
        },
        {
          "text": "【痛吼】对攻击范围内所有单位造成一次物理伤害，该伤害由攻击范围内所有单位平均分担；如果攻击范围内没有目标则改为<$ba.stun>晕眩</>全场我方单位，并造成物理伤害",
          "textFormat": "NORMAL"
        },
        {
          "text": "【行于荒原】传送到下个位置，对路径上所有单位造成法术伤害，并使其在20秒内攻击速度大幅降低",
          "textFormat": "NORMAL"
        },
        {
          "text": "【湮灭】战斗经过较长时间后，离场并扣除30点目标生命",
          "textFormat": "NORMAL"
        },
        {
          "text": "被击倒后召唤大量<猎犬proto>，全部击倒后依次召唤3个<痛楚化身>",
          "textFormat": "NORMAL"
        }
      ],
      "linkEnemies": [
        "enemy_2137_shsdgo",
        "enemy_2146_cadesd"
      ],
      "damageType": [
        "PHYSIC"
      ],
      "invisibleDetail": false
    },
