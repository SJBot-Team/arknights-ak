    "enemy_10211_murad": {
      "enemyId": "enemy_10211_murad",
      "enemyIndex": "ES20",
      "enemyTags": null,
      "sortId": 1188,
      "name": "泄漏源",
      "enemyLevel": "NORMAL",
      "description": "起初，人们发热不退，身边的亲友会牵来牙兽，让其对着病人吠叫——他们相信动物的叫声能够吓走那些附在病人身上的鬼怪，直到牙兽也开始发热。",
      "attackType": null,
      "ability": null,
      "isInvalidKilled": true,
      "overrideKillCntInfos": {},
      "hideInHandbook": false,
      "hideInStage": true,
      "abilityList": [
        {
          "text": "无法被攻击",
          "textFormat": "NORMAL"
        },
        {
          "text": "常态不可见，显形后攻击力提升",
          "textFormat": "NORMAL"
        },
        {
          "text": "每过一段时间，发射一圈射线，使首个击中的我方单位在一定时间内持续受到真实伤害，且距离越近受到的伤害越频繁、越高；射线击中目标时，加速自身主动显形",
          "textFormat": "NORMAL"
        },
        {
          "text": "一定时间后主动显形，发射射线的数量与频率提升；显形一段时间后退场",
          "textFormat": "NORMAL"
        },
        {
          "text": "所在格及周围四格部署干员时显形，期间射线仅影响附近最早部署的干员，持续一定时间后退场并使所有我方干员获得技力",
          "textFormat": "NORMAL"
        }
      ],
      "linkEnemies": [],
      "damageType": [
        "NO_DAMAGE"
      ],
      "invisibleDetail": false
    },
    "enemy_10221_agporc": {
