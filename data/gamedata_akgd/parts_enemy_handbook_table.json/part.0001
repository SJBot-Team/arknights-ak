    "enemy_7054_xbsmi": {
      "enemyId": "enemy_7054_xbsmi",
      "enemyIndex": "SD46",
      "enemyTags": null,
      "sortId": 1683,
      "name": "香草翼兽",
      "enemyLevel": "BOSS",
      "description": "以播撒香草籽为乐的香草翼兽。它所到之处，香草籽随风落下，为布满战争伤痕的阿尔萨兰，带来一抹复苏的气息。",
      "attackType": null,
      "ability": null,
      "isInvalidKilled": false,
      "overrideKillCntInfos": {},
      "hideInHandbook": false,
      "hideInStage": true,
      "abilityList": [
        {
          "text": "异兽，飞行单位",
          "textFormat": "NORMAL"
        },
        {
          "text": "移动途径的地块变为播撒状态，播撒地块上的敌人攻击速度提升",
          "textFormat": "NORMAL"
        },
        {
          "text": "每损失一定生命值，播撒自身周围地块并对周围所有我方单位造成一定比例的法术伤害，然后受到的物理和法术伤害减少，持续一段时间",
          "textFormat": "NORMAL"
        },
        {
          "text": "生命值低于一定值后，不再攻击和释放技能转而向终点飞行，到达后消失并移动至其他关卡",
          "textFormat": "NORMAL"
        },
        {
          "text": "【草籽疯长】周期性选择数名干员（优先选择播撒地块内的）造成攻击力一定比例的法术溅射伤害，目标被击倒则再部署时间大幅延长",
          "textFormat": "NORMAL"
        },
        {
          "text": "【播撒生命】陌域难度6获得能力：播撒地块上的敌人被击倒时自爆，对周围我方单位造成该敌人一定攻击力的法术伤害和数秒<$ba.stun>晕眩</>",
          "textFormat": "NORMAL"
        }
      ],
      "linkEnemies": [],
      "damageType": [
        "MAGIC"
      ],
      "invisibleDetail": false
    },
