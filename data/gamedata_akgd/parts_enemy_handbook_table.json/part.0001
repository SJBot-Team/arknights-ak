    "enemy_6014_crzgas": {
      "enemyId": "enemy_6014_crzgas",
      "enemyIndex": "DL14",
      "enemyTags": null,
      "sortId": 1593,
      "name": "“毒瘤”",
      "enemyLevel": "BOSS",
      "description": "无论从何种角度来说都是名副其实的荒野暴徒。原本只是在荒野流浪，在看到雷神工业正在处理气体泄漏的测试平台后，决定铤而走险大干一场，占领一整个平台发家致富指日可待。",
      "attackType": null,
      "ability": null,
      "isInvalidKilled": false,
      "overrideKillCntInfos": {},
