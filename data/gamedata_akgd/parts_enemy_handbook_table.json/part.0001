    },
    "enemy_2120_dywqgs": {
      "enemyId": "enemy_2120_dywqgs",
      "enemyIndex": "WAN",
      "enemyTags": null,
      "sortId": 1558,
      "name": "“望”",
      "enemyLevel": "BOSS",
      "description": "谋臣、罪人，于岁陵置下的一手。",
      "attackType": null,
      "ability": null,
      "isInvalidKilled": false,
      "overrideKillCntInfos": {},
      "hideInHandbook": false,
      "hideInStage": true,
      "abilityList": [
        {
          "text": "初始形态",
          "textFormat": "TITLE"
        },
        {
          "text": "【落】每次部署单位时，在该单位周围4格的可部署位置部署一枚“瑕”",
          "textFormat": "NORMAL"
        },
        {
          "text": "【落】每隔一段时间，随机选择我方单位周围四格不存在单位的可部署格子，部署一枚“瑕”",
          "textFormat": "NORMAL"
        },
        {
          "text": "第一形态",
          "textFormat": "TITLE"
        },
        {
          "text": "自身周围的“瑕”每秒回复一定比例的生命值，且会攻击周围的我方目标并使其眩晕",
          "textFormat": "NORMAL"
        },
        {
          "text": "自身周围每有一枚“瑕”，受到的物理和法术伤害降低，受到的控制效果时间减少",
          "textFormat": "NORMAL"
        },
        {
          "text": "【征】场上有目标“失气”时，进入全图攻击模式，优先选择被包围的目标，最多同时攻击三名目标",
          "textFormat": "NORMAL"
        },
        {
          "text": "第二形态",
          "textFormat": "TITLE"
        },
        {
          "text": "进入第二形态时，连续部署多枚“瑕”，若被“瑕”围住的可部署地块没有部署单位，则该地块开始不断生成敌人",
          "textFormat": "NORMAL"
        },
        {
          "text": "复活后，同时在我方单位周围的可部署地块部署一枚“瑕”",
          "textFormat": "NORMAL"
        },
        {
          "text": "当场上最后一枚“瑕”被击退时，自身同时退场",
          "textFormat": "NORMAL"
        }
      ],
      "linkEnemies": [],
      "damageType": [
        "MAGIC"
      ],
      "invisibleDetail": false
    },
    "enemy_2123_dyjsww": {
      "enemyId": "enemy_2123_dyjsww",
      "enemyIndex": "HOU",
      "enemyTags": null,
      "sortId": 1559,
      "name": "后兽",
      "enemyLevel": "BOSS",
      "description": "与地同形，与山同齐，万类难及，以后名之。",
      "attackType": null,
      "ability": null,
      "isInvalidKilled": false,
      "overrideKillCntInfos": {},
      "hideInHandbook": false,
      "hideInStage": true,
      "abilityList": [
        {
          "text": "第一形态",
          "textFormat": "TITLE"
        },
        {
          "text": "【无为】无法被攻击，<矩兽>被击倒或退场，以及战斗经过一定时间后进入第二形态并激活场上所有的古雕伥",
          "textFormat": "NORMAL"
        },
        {
          "text": "【时移】每隔一段时间，将自己转移至指定地块，并使场上所有部署方向与自身移动方向相反的我方单位攻击速度降低，使移动方向与自身相同的敌方单位移动速度增加",
          "textFormat": "NORMAL"
        },
        {
          "text": "【自化】除<矩兽>以外的敌人触碰到自身时，使其退场并扣除1点目标生命，对全场我方单位造成法术伤害且自身攻击力永久增加",
          "textFormat": "NORMAL"
        },
        {
          "text": "【并济】每隔一段时间，锁定与自身平行的一位我方干员进行一次直线攻击，对命中的首个干员造成法术溅射伤害并在其附近可通行地面上部署一个古雕伥",
          "textFormat": "NORMAL"
        },
        {
          "text": "第二形态",
          "textFormat": "TITLE"
        },
        {
          "text": "【自化】使场上除<矩兽>以外的敌人以自身为目标点移动，直到自身被击倒或退场，除<矩兽>以外的敌人触碰到自身时，使其退场并扣除1点目标生命，对全场我方单位造成法术伤害且自身攻击力永久增加",
          "textFormat": "NORMAL"
        },
        {
          "text": "【时移】每隔一段时间，使场上所有部署方向与自身移动方向相反的我方单位攻击速度降低，使移动方向与自身相同的敌方单位移动速度增加",
          "textFormat": "NORMAL"
        },
        {
          "text": "战斗经过较长时间后，消失，并扣除50点目标生命",
          "textFormat": "NORMAL"
        }
      ],
      "linkEnemies": [
        "enemy_2124_dyjsfg"
      ],
      "damageType": [
        "MAGIC"
      ],
      "invisibleDetail": false
    },
    "enemy_2124_dyjsfg": {
      "enemyId": "enemy_2124_dyjsfg",
      "enemyIndex": "JU",
      "enemyTags": null,
      "sortId": 1560,
      "name": "矩兽",
      "enemyLevel": "BOSS",
      "description": "溯合制序，止攻泯灾，刚而难曲，以矩名之。",
      "attackType": null,
      "ability": null,
      "isInvalidKilled": false,
      "overrideKillCntInfos": {},
      "hideInHandbook": false,
      "hideInStage": true,
      "abilityList": [
        {
          "text": "【明力】晕眩、寒冷、冻结等异常状态的持续时间大幅降低，受到的物理与法术伤害大幅降低，被阻挡或停止移动时伤害降低效果减少",
          "textFormat": "NORMAL"
        },
        {
          "text": "【尚同】持续对周围造成物理伤害，每次被阻挡时对周围额外造成一次高额物理伤害",
          "textFormat": "NORMAL"
        },
        {
          "text": "【非命】生命值首次低于50%时，自身占用阻挡数、攻击力与移动速度提升",
          "textFormat": "NORMAL"
        },
        {
          "text": "【兼爱】自身被击倒或退场时，使场上除<后兽>以外的所有敌人退场，对场上所有友方单位造成一次无视隐匿的高额物理伤害",
          "textFormat": "NORMAL"
        }
      ],
      "linkEnemies": [
        "enemy_2123_dyjsww"
      ],
      "damageType": [
        "PHYSIC"
      ],
      "invisibleDetail": false
    },
    "enemy_2128_dysuib": {
      "enemyId": "enemy_2128_dysuib",
      "enemyIndex": "WQH",
      "enemyTags": null,
      "sortId": 1561,
      "name": "身形",
      "enemyLevel": "BOSS",
      "description": "祂最不似人的部分。",
      "attackType": null,
      "ability": null,
      "isInvalidKilled": false,
      "overrideKillCntInfos": {},
      "hideInHandbook": false,
