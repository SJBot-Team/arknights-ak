    "enemy_1542_wdslm": {
      "enemyId": "enemy_1542_wdslm",
      "enemyIndex": "DC1",
      "enemyTags": null,
      "sortId": 1437,
      "name": "“变形者集群”",
      "enemyLevel": "BOSS",
      "description": "游离于萨卡兹王庭之外的长生者。见证了种族的兴衰，体验了生命的迭代，但“变形者集群”依然没有找到“何为生存”的答案。",
      "attackType": null,
      "ability": null,
      "isInvalidKilled": false,
      "overrideKillCntInfos": {},
      "hideInHandbook": false,
      "hideInStage": true,
      "abilityList": [
        {
          "text": "密探",
          "textFormat": "NORMAL"
        },
        {
          "text": "每损失一定比例生命值召唤潜伏于地图或干员中的同构碎片，自身与同构碎片共享生命值；",
          "textFormat": "NORMAL"
        },
        {
          "text": "每出现一个同构碎片，自身与同构碎片获得一定比例的物理与法术减伤",
          "textFormat": "NORMAL"
        },
        {
          "text": "自身或同构碎片未显露真身时，获得无敌",
          "textFormat": "NORMAL"
        },
        {
          "text": "攻击造成<$ba.dt.erosion>侵蚀损伤</>",
          "textFormat": "NORMAL"
        },
        {
          "text": "第一形态",
          "textFormat": "TITLE"
        },
        {
          "text": "周期性释放【次生迭代】自身与所有同构碎片同时对某一单位造成物理伤害",
          "textFormat": "NORMAL"
        },
        {
          "text": "首次被击倒后重生，重生阶段时，自身及同构碎片周围所有单位受到持续法术伤害",
          "textFormat": "NORMAL"
        },
        {
          "text": "第二形态",
          "textFormat": "TITLE"
        },
        {
          "text": "周期性释放【命脉勃发】锁定场上所有友方单位，一段时间后，对其及其周围四格所有单位造成法术伤害并在其位置召唤<解构畸变体>",
          "textFormat": "NORMAL"
        },
        {
          "text": "二阶段生命值首次低于一定比例时，召唤潜伏于干员中的同构碎片，召唤后该干员将无法上场，优先选择周围没有友方干员的目标",
          "textFormat": "NORMAL"
        }
      ],
      "linkEnemies": [
        "enemy_1323_wdbshd"
      ],
      "damageType": [
        "PHYSIC"
      ],
      "invisibleDetail": false
    },
    "enemy_1543_cstlrs": {
      "enemyId": "enemy_1543_cstlrs",
      "enemyIndex": "KW",
      "enemyTags": null,
      "sortId": 1438,
      "name": "克丽斯腾",
      "enemyLevel": "BOSS",
      "description": "自私者。背叛者。求道者。独行者。先驱者。\n晚安，泰拉。",
      "attackType": null,
      "ability": null,
      "isInvalidKilled": false,
      "overrideKillCntInfos": {},
      "hideInHandbook": false,
      "hideInStage": true,
      "abilityList": [
        {
          "text": "每一个“星环”使<克丽斯腾>占用阻挡数+1，受到的伤害减少",
          "textFormat": "NORMAL"
        },
        {
          "text": "第一形态",
          "textFormat": "TITLE"
        },
        {
          "text": "免疫控制且受到“行星碎屑”的伤害减少",
          "textFormat": "NORMAL"
        },
        {
          "text": "周期性夺取最远的“行星碎屑”将其化为“星环”（周围8格我方单位受到法术伤害并降低攻速）",
          "textFormat": "NORMAL"
        },
        {
          "text": "【热寂】生命值降为0时，引爆场上所有“星环”对全场我方单位造成法术伤害",
          "textFormat": "NORMAL"
        },
        {
          "text": "第二形态",
          "textFormat": "TITLE"
        },
        {
          "text": "进入第二形态时立即夺取所有“行星碎屑”",
          "textFormat": "NORMAL"
        },
        {
          "text": "攻击力提升，额外攻击1个目标",
          "textFormat": "NORMAL"
        },
        {
          "text": "自身不再夺取“行星碎屑”，但每个“星环”被击破时，对全场我方造成法术伤害，并增加全体敌人移动速度",
          "textFormat": "NORMAL"
        },
        {
          "text": "【热寂】生命值降为0时，引爆场上所有“星环”对全场我方单位造成高额法术伤害",
          "textFormat": "SILENCE"
        }
      ],
      "linkEnemies": [],
      "damageType": [
        "MAGIC"
      ],
      "invisibleDetail": false
    },
    "enemy_1544_cledub": {
      "enemyId": "enemy_1544_cledub",
      "enemyIndex": "CD",
      "enemyTags": null,
      "sortId": 1439,
      "name": "“花匠”",
      "enemyLevel": "BOSS",
      "description": "最平凡的花匠，克莱芒·杜波瓦。双手捧起的是泥土，可土壤太贫瘠，曾一度在此绽放的花已无力生长。",
      "attackType": null,
      "ability": null,
      "isInvalidKilled": false,
      "overrideKillCntInfos": {},
      "hideInHandbook": false,
      "hideInStage": true,
      "abilityList": [
        {
          "text": "无法被阻挡，永久无敌",
          "textFormat": "NORMAL"
        },
        {
          "text": "第一形态",
          "textFormat": "TITLE"
        },
        {
          "text": "【宣讲】在地面放置一个标记“回答”，引导<修道院居民>前往，居民到达标记位置后恐慌降低且一段时间内不再上升",
          "textFormat": "NORMAL"
        },
        {
          "text": "【质疑】周期性激活场上塌落的墙垣",
          "textFormat": "NORMAL"
        },
        {
          "text": "【责问】周期性对全场我方单位施加永久生效的异常状态，每次释放切换一个状态，依次为：攻速下降，阻挡数减少，生命上限下降",
          "textFormat": "NORMAL"
        },
        {
          "text": "第二形态",
          "textFormat": "TITLE"
        },
        {
          "text": "进入第二形态时，关闭已激活的塌落的墙垣，并激活余下的塌落的墙垣",
          "textFormat": "NORMAL"
        },
        {
          "text": "【质疑】变为随机召唤额外的敌人或<修道院居民>",
          "textFormat": "NORMAL"
        },
        {
          "text": "【责问】的异常状态效果增强",
          "textFormat": "NORMAL"
        }
      ],
      "linkEnemies": [
        "enemy_3005_lpeopl"
      ],
      "damageType": [
        "NO_DAMAGE"
      ],
      "invisibleDetail": false
    },
    "enemy_1545_shpkg": {
      "enemyId": "enemy_1545_shpkg",
      "enemyIndex": "DLY",
      "enemyTags": null,
      "sortId": 1440,
      "name": "多利，“羊之主”",
      "enemyLevel": "BOSS",
      "description": "羊之主，游历于荒野之中，非常喜欢在岩浆里冲浪。他平等地观察着每个人，并乐于在大地上为他们留下“记号”。现在，是时候陪他尽兴地玩一场了！",
      "attackType": null,
      "ability": null,
      "isInvalidKilled": false,
      "overrideKillCntInfos": {},
      "hideInHandbook": false,
      "hideInStage": true,
      "abilityList": [
        {
          "text": "<$ba.float>近地悬浮</>，无法被阻挡",
          "textFormat": "NORMAL"
        },
        {
          "text": "【绒毛屏障】拥有绒毛屏障时受到的物理及法术伤害大幅降低，绒毛屏障值为0时，多利失去屏障并掉落至地面，无法攻击且失去<$ba.float>近地悬浮</>",
          "textFormat": "NORMAL"
        },
        {
          "text": "水汽汽水瓶爆炸能使绒毛屏障值大幅降低",
          "textFormat": "NORMAL"
        },
        {
          "text": "多利每次受到处于景观喷泉周围的干员攻击时，绒毛屏障值降低",
          "textFormat": "NORMAL"
        },
        {
          "text": "轻飘飘的多利",
          "textFormat": "TITLE"
        },
        {
          "text": "优先攻击地面单位，并使攻击目标所在地块产生洋红蒸汽",
          "textFormat": "NORMAL"
        },
        {
          "text": "【欢快地喷火】锁定场上一个单位，随后从上至下对其所在位置的所有纵向地块喷火，对处于地块上的单位造成法术伤害，并使所有地块产生洋红蒸汽",
          "textFormat": "NORMAL"
        },
        {
          "text": "【不小心爆炸】停止攻击，蓄力一段时间后，从右至左依次引爆所有洋红蒸汽，造成范围法术伤害及<$ba.dt.burning>灼燃损伤</>",
          "textFormat": "NORMAL"
        },
        {
          "text": "急匆匆的多利",
          "textFormat": "TITLE"
        },
        {
          "text": "无法攻击，使经过地块产生洋红蒸汽",
          "textFormat": "NORMAL"
        },
        {
          "text": "对撞击到的单位造成法术伤害及<$ba.dt.burning>灼燃损伤</>",
          "textFormat": "NORMAL"
        },
        {
          "text": "不再释放【欢快地喷火】，多利只会掉落至地面后再释放【不小心爆炸】",
          "textFormat": "NORMAL"
        }
      ],
      "linkEnemies": [],
      "damageType": [
        "MAGIC"
      ],
      "invisibleDetail": false
    },
    "enemy_1546_cliff": {
      "enemyId": "enemy_1546_cliff",
      "enemyIndex": "BSC",
      "enemyTags": null,
      "sortId": 1441,
      "name": "“桥夹”克里夫",
      "enemyLevel": "BOSS",
      "description": "传奇佣兵，黑钢国际的创始人。战火将他摧毁，亦将他重塑。",
      "attackType": null,
      "ability": null,
      "isInvalidKilled": false,
      "overrideKillCntInfos": {},
      "hideInHandbook": false,
      "hideInStage": true,
      "abilityList": [
        {
          "text": "攻击使数秒内目标防御力减少，该效果可叠加",
          "textFormat": "NORMAL"
        },
        {
          "text": "受到废热喷口的伤害时攻击力和防御力大幅降低",
          "textFormat": "NORMAL"
        },
        {
          "text": "第一形态",
          "textFormat": "TITLE"
        },
        {
          "text": "【闪电之手】晕眩目标和相邻单位，随后连续攻击3次",
          "textFormat": "NORMAL"
        },
        {
          "text": "第二形态",
          "textFormat": "TITLE"
        },
        {
          "text": "进入第二形态时立即清空场上所有废热喷口的技力",
          "textFormat": "NORMAL"
        },
        {
          "text": "攻击力和防御力提升，攻击速度大幅增加",
          "textFormat": "NORMAL"
        },
        {
          "text": "【雷霆之手】晕眩目标和相邻单位，随后连续攻击6次，若目标撤退或被击倒，快速穿过一段距离并刷新此技能",
          "textFormat": "NORMAL"
        }
      ],
      "linkEnemies": [],
      "damageType": [
        "PHYSIC"
      ],
      "invisibleDetail": false
    },
    "enemy_1547_blord": {
      "enemyId": "enemy_1547_blord",
      "enemyIndex": "PB",
      "enemyTags": null,
      "sortId": 1442,
      "name": "杜卡雷，“君主之红”",
      "enemyLevel": "BOSS",
      "description": "鲜血王庭的主宰者，所有血裔的君王。一滴提卡兹的血曾在他的身体中流淌，如今，最后的纯粹已被奉还给世间。现在他又把自己的目光投向了“魔王”。他微笑着宣称，他曾杀死过一位魔王，也将送别最后一位。",
      "attackType": null,
      "ability": null,
      "isInvalidKilled": false,
      "overrideKillCntInfos": {},
      "hideInHandbook": false,
      "hideInStage": true,
      "abilityList": [
        {
          "text": "第一形态",
          "textFormat": "TITLE"
        },
        {
          "text": "【血霭遮月】以目标为中心释放血雾，对笼罩的我方单位造成越来越高的法术伤害并降低攻击速度并使其再部署时间延长，被血雾笼罩的血珀会转化成新生血裔",
          "textFormat": "NORMAL"
        },
        {
          "text": "【血涌濯身】被击倒时会释放4次该技能，每次选择一名目标（优先选择未打击过的目标），对目标与周围四格的单位造成法术伤害并使其晕眩",
          "textFormat": "NORMAL"
        },
        {
          "text": "被击倒后，返回沥血王座，一段时间后回归战场",
          "textFormat": "NORMAL"
        },
        {
          "text": "当沥血王座被摧毁时进入第二形态",
          "textFormat": "NORMAL"
        },
        {
          "text": "第二形态",
          "textFormat": "TITLE"
        },
        {
          "text": "受到的物理和法术伤害大幅降低，周围其他敌方单位生命恢复速度增加（被<反巫术变位炸弹>击中后失去此特性一段时间）",
          "textFormat": "NORMAL"
        },
        {
          "text": "【坏血】攻击造成越来越高的持续法术伤害，若目标在持续期间内退场则再部署时间大幅增加",
          "textFormat": "NORMAL"
        },
        {
          "text": "【殷红敕令】一段时间内持续在身边生成<血珀>，结束时以自身为中心释放血雾",
          "textFormat": "NORMAL"
        },
        {
          "text": "【沉沦之殁】被<反巫术变位炸弹>击中后会释放，摧毁对应的炸弹载荷点，并释放2次【血涌濯身】",
          "textFormat": "NORMAL"
        }
      ],
      "linkEnemies": [
        "enemy_1367_dseed"
      ],
      "damageType": [
        "MAGIC"
      ],
      "invisibleDetail": false
    },
    "enemy_1548_ltniak": {
      "enemyId": "enemy_1548_ltniak",
      "enemyIndex": "HH",
      "enemyTags": null,
      "sortId": 1443,
      "name": "赫尔昏佐伦，“巫王”",
      "enemyLevel": "BOSS",
      "description": "漫长的噩梦即将苏醒，创造的幻夜迎来黎明。上前来，见证君王之死，见证造物之始源如何灭亡。",
      "attackType": null,
      "ability": null,
      "isInvalidKilled": false,
      "overrideKillCntInfos": {},
      "hideInHandbook": false,
      "hideInStage": true,
      "abilityList": [
        {
          "text": "无法被阻挡，攻击造成溅射伤害",
          "textFormat": "NORMAL"
        },
        {
          "text": "【造物灭亡】战斗经过较长时间后，对全场我方单位造成法术溅射伤害, 并扣除所有目标生命",
          "textFormat": "NORMAL"
        },
        {
          "text": "第一形态",
          "textFormat": "TITLE"
        },
        {
          "text": "每隔一段时间瞬移至下一个检查点",
          "textFormat": "NORMAL"
        },
        {
          "text": "【痴愚惩戒】每损失一定比例生命值，吞噬两名我方干员并随机选择两个位置再部署",
          "textFormat": "NORMAL"
        },
        {
          "text": "【慵钝惩戒】周期性锁定攻击范围内两名我方干员打上“慵钝之印”（需要5次伤害击破），使其无法攻击、释放技能，且更容易受到敌人攻击。下一次释放该技能时，将强制击倒场上已被附着“慵钝之印”的干员，并对其周围4格造成法术溅射伤害",
          "textFormat": "NORMAL"
        },
        {
          "text": "首次被击倒后重生，对全场我方单位造成法术溅射伤害，并释放【痴愚惩戒】，重生结束后切换至第二形态，并重置【造物灭亡】计时",
          "textFormat": "NORMAL"
        },
        {
          "text": "第二形态",
          "textFormat": "TITLE"
        },
        {
          "text": "无法移动，生成一个单向防御护盾，抵挡来源于盾侧的物理和法术伤害",
          "textFormat": "NORMAL"
        },
        {
          "text": "攻击范围扩大至整个战场，攻击力大幅降低，攻击溅射范围扩大，防御力大幅提升",
          "textFormat": "NORMAL"
        },
        {
          "text": "夺取指挥权，使场上所有的“调谐节点”失效",
          "textFormat": "NORMAL"
        },
        {
          "text": "【君王诏制】周期性控制变奏；变奏期间强化敌人属性并持续检测乐团节奏，受到<$ba.stun>晕眩</>未跟上巫王节奏的敌人将被打上印记，变奏结束时受到高额法术伤害惩戒",
          "textFormat": "NORMAL"
        },
        {
          "text": "【慵钝惩戒】变为只选择一个目标释放",
          "textFormat": "NORMAL"
        }
      ],
      "linkEnemies": [],
      "damageType": [
        "MAGIC"
      ],
      "invisibleDetail": false
    },
    "enemy_1549_windoc": {
      "enemyId": "enemy_1549_windoc",
      "enemyIndex": "HC",
      "enemyTags": null,
      "sortId": 1444,
      "name": "哈洛德·克雷加文",
      "enemyLevel": "BOSS",
      "description": "来自维多利亚的“访客”，既见证了维多利亚的兴衰，又将塑造谢拉格的未来。他站在这里，究竟是代表公爵，代表帝国，还是代表他自己？",
      "attackType": null,
      "ability": null,
      "isInvalidKilled": false,
      "overrideKillCntInfos": {},
      "hideInHandbook": false,
      "hideInStage": true,
      "abilityList": [
        {
          "text": "优先攻击“紧急供暖器”右侧的目标",
          "textFormat": "NORMAL"
        },
        {
          "text": "每一个未点燃的“紧急供暖器”使<哈洛德·克雷加文>受到的物理或法术伤害降低",
          "textFormat": "NORMAL"
        },
        {
          "text": "相持姿态",
          "textFormat": "TITLE"
        },
        {
          "text": "【惩戒之触】周期性熄灭最近的1个“紧急供暖器”并对其十字范围内的目标造成伤害；进入突破姿态后，额外熄灭1个“紧急供暖器”",
          "textFormat": "NORMAL"
        },
        {
          "text": "【临战激励】治疗并强化其他敌人",
          "textFormat": "NORMAL"
        },
        {
          "text": "突破姿态",
          "textFormat": "TITLE"
        },
        {
          "text": "进入突破姿态时，攻击力大幅提升",
          "textFormat": "NORMAL"
        },
        {
          "text": "进入突破姿态时，立刻熄灭周围大范围内的“紧急供暖器”",
          "textFormat": "NORMAL"
        },
        {
          "text": "【落气弹雨】每损失一定比例生命值对全场目标造成伤害。每一个未点燃的“紧急供暖器”使该技能的伤害次数增加",
          "textFormat": "NORMAL"
        }
      ],
      "linkEnemies": [],
      "damageType": [
        "MAGIC"
      ],
      "invisibleDetail": false
    },
    "enemy_1550_dhnzzh": {
      "enemyId": "enemy_1550_dhnzzh",
      "enemyIndex": "SUI",
      "enemyTags": null,
      "sortId": 1445,
      "name": "“祟”",
      "enemyLevel": "BOSS",
      "description": "自苏醒的巨兽之心中诞生的化物。岁月千载，阴影虬结，岁的代理人们并不孤独，因有恐惧常伴左右；是静候无涯之混沌，还是穿针引线，寻求那一线明识？",
      "attackType": null,
      "ability": null,
      "isInvalidKilled": false,
      "overrideKillCntInfos": {},
      "hideInHandbook": false,
      "hideInStage": true,
      "abilityList": [
        {
          "text": "混沌",
          "textFormat": "TITLE"
        },
        {
          "text": "每受到一定次数的伤害蜕皮，对所在田地造成病害污染，自身攻击力、防御力、法术抗性、重量降低，移动速度增加",
          "textFormat": "NORMAL"
        },
        {
          "text": "生命值首次降为0时，化入水中，持续召唤敌人，重生后进入明识形态",
          "textFormat": "NORMAL"
        },
        {
          "text": "明识",
          "textFormat": "TITLE"
        },
        {
          "text": "属性改变，攻击变为物理二连击，免疫大部分控制效果",
          "textFormat": "NORMAL"
        },
        {
          "text": "标记所有攻击过“祟”的我方单位，被标记单位离场时，对“祟”所在田地造成极严重的病害污染",
          "textFormat": "NORMAL"
        },
        {
          "text": "【如梭】所在田地病害程度超过阈值时，持续吸收病害并凝聚成一把长枪，优先对被标记干员投掷，造成大量法术伤害",
          "textFormat": "NORMAL"
        },
        {
          "text": "在无病害的田地里，或是被无病害的水流冲刷时，“祟”的防御力、法术抗性、移动速度降低",
          "textFormat": "NORMAL"
        }
      ],
      "linkEnemies": [],
      "damageType": [
        "PHYSIC"
      ],
      "invisibleDetail": false
    },
    "enemy_1551_bolicp": {
      "enemyId": "enemy_1551_bolicp",
      "enemyIndex": "EC",
      "enemyTags": null,
      "sortId": 1446,
      "name": "马特奥上尉",
      "enemyLevel": "BOSS",
      "description": "联合政府军队上尉马特奥。他不愿承认自己已经穷途末路，为此用暴力对待每个提醒他这一点的人。",
      "attackType": null,
      "ability": null,
      "isInvalidKilled": false,
      "overrideKillCntInfos": {},
      "hideInHandbook": false,
      "hideInStage": true,
      "abilityList": [
        {
          "text": "第一形态",
          "textFormat": "TITLE"
        },
        {
          "text": "与我方处于同一直线上时进行直击：向目标方向发射10支弩箭，最后一支弩箭使目标的防御永久下降",
          "textFormat": "NORMAL"
        },
        {
          "text": "生命值首次降为0时，空降至另一位置并进入第二形态",
          "textFormat": "NORMAL"
        },
        {
          "text": "第二形态",
          "textFormat": "TITLE"
        },
        {
          "text": "【“熄灯！”】受到伤害时，向前方释放3颗烟雾弹，使其中的敌人<$ba.invisible>隐匿</>，烟雾持续30秒（初始可使用次数：1）",
          "textFormat": "NORMAL"
        },
        {
          "text": "【“稍息！”】攻击时使目标<$ba.stun>晕眩</>6秒（初始可使用次数：6）",
          "textFormat": "NORMAL"
        },
        {
          "text": "【“集合！”】呼叫场上所有<马特奥的亲卫>到自身当前位置，使其在此位置等待30秒",
          "textFormat": "NORMAL"
        }
      ],
      "linkEnemies": [
        "enemy_1409_bdguad_3"
      ],
      "damageType": [
        "PHYSIC"
      ],
      "invisibleDetail": false
    },
    "enemy_1552_mmamiy": {
      "enemyId": "enemy_1552_mmamiy",
      "enemyIndex": "THA2",
      "enemyTags": null,
      "sortId": 1447,
      "name": "“阿米娅”",
      "enemyLevel": "BOSS",
      "description": "这是......阿米娅？",
      "attackType": null,
      "ability": null,
      "isInvalidKilled": false,
      "overrideKillCntInfos": {},
      "hideInHandbook": false,
      "hideInStage": true,
      "abilityList": [
        {
          "text": "永久无敌",
          "textFormat": "NORMAL"
        },
        {
          "text": "【幽影重重】操纵<幽影门扉>进行战斗，<幽影门扉>会对一定距离内的我方单位每秒造成法术伤害，并治疗敌方单位",
          "textFormat": "NORMAL"
        },
        {
          "text": "【幽影闪烁】周期性使场上的<幽影门扉>旋转，改变攻击方向",
          "textFormat": "NORMAL"
        },
        {
          "text": "每个<幽影门扉>被击杀时，自身都会流失生命",
          "textFormat": "NORMAL"
        },
        {
          "text": "【枯竭期许】以自身为中心，周期性朝8个方向发射“微尘”，“微尘”不造成任何伤害但会使干员的攻击速度大幅降低，持续一段时间",
          "textFormat": "NORMAL"
        }
      ],
      "linkEnemies": [],
      "damageType": [
        "NO_DAMAGE"
      ],
      "invisibleDetail": true
    },
    "enemy_1553_lrdead": {
      "enemyId": "enemy_1553_lrdead",
      "enemyIndex": "DS",
      "enemyTags": null,
      "sortId": 1448,
      "name": "引火的死魂灵",
      "enemyLevel": "BOSS",
      "description": "以自我为柴薪，以仇恨为火种，愤怒的烈焰永不熄灭。",
      "attackType": null,
      "ability": null,
      "isInvalidKilled": false,
      "overrideKillCntInfos": {},
      "hideInHandbook": false,
      "hideInStage": true,
      "abilityList": [
        {
          "text": "战斗经过较长时间后扣除所有目标生命",
          "textFormat": "NORMAL"
        },
        {
          "text": "第一形态",
          "textFormat": "TITLE"
        },
        {
          "text": "【灵魂激荡】操纵<洪流束激发器>对其左侧大范围造成持续伤害，<核心增幅器>被破坏后停止",
          "textFormat": "NORMAL"
        },
        {
          "text": "使<核心增幅器>可以捕获魂灵涡流，捕获魂灵涡流时，使下一次释放的【灵魂激荡】造成伤害提升",
          "textFormat": "NORMAL"
        },
        {
          "text": "寄宿于<核心增幅器>中，无法被攻击。所有<核心增幅器>被破坏后进入第二形态",
          "textFormat": "NORMAL"
        },
        {
          "text": "第二形态",
          "textFormat": "TITLE"
        },
        {
          "text": "【灵魂怒潮】对自身右侧大范围造成持续伤害，多次释放时伤害提升",
          "textFormat": "NORMAL"
        },
        {
          "text": "每损失一定生命值，立即释放一次【灵魂怒潮】",
          "textFormat": "NORMAL"
        }
      ],
      "linkEnemies": [
        "enemy_1428_lrsoul"
      ],
      "damageType": [
        "MAGIC"
      ],
      "invisibleDetail": false
    },
    "enemy_1554_lrtsia": {
      "enemyId": "enemy_1554_lrtsia",
      "enemyIndex": "THA3",
      "enemyTags": null,
      "sortId": 1449,
      "name": "特蕾西娅",
      "enemyLevel": "BOSS",
      "description": "早已逝去之人，早已宽恕之罪。",
      "attackType": null,
      "ability": null,
      "isInvalidKilled": false,
      "overrideKillCntInfos": {},
      "hideInHandbook": false,
      "hideInStage": true,
      "abilityList": [
        {
          "text": "可以捕获魂灵涡流，捕获魂灵涡流时，恢复自身一定生命值",
          "textFormat": "NORMAL"
        },
        {
          "text": "拥有<永恒尘埃>环绕自身，大幅度降低来源于环绕侧的伤害",
          "textFormat": "NORMAL"
        },
        {
          "text": "场上<茧笼>数量到达一定程度后扣除所有目标生命",
          "textFormat": "NORMAL"
        },
        {
          "text": "第一形态",
          "textFormat": "TITLE"
        },
        {
          "text": "【禁制】每损失一定生命值时释放，立即在自身周围八格我方单位所在地块生成<茧笼>（使所在地块我方单位无法攻击、阻挡和撤退。可被攻击，被单位击破时转移到对应单位的所在地块）",
          "textFormat": "NORMAL"
        },
        {
          "text": "【编织茧笼】战斗经过较长时间后释放，使场上所有<茧笼>向周围扩散",
          "textFormat": "NORMAL"
        },
        {
          "text": "第二形态",
          "textFormat": "TITLE"
        },
        {
          "text": "自身防御力提升，法术抗性降低",
          "textFormat": "NORMAL"
        },
        {
          "text": "拥有更多的<永恒尘埃>环绕自身",
          "textFormat": "NORMAL"
        },
        {
          "text": "【编织茧笼】使场上所有<茧笼>向周围扩散",
          "textFormat": "NORMAL"
        },
        {
          "text": "每损失一定生命值，立即释放一次【编织茧笼】",
          "textFormat": "NORMAL"
        }
      ],
      "linkEnemies": [
        "enemy_1428_lrsoul"
      ],
      "damageType": [
        "MAGIC"
      ],
      "invisibleDetail": false
    },
    "enemy_1556_dsbish": {
      "enemyId": "enemy_1556_dsbish",
      "enemyIndex": "MSB",
      "enemyTags": null,
      "sortId": 1450,
      "name": "玛利图斯，“海嗣”",
      "enemyLevel": "BOSS",
      "description": "玛利图斯，先哲，叛徒，伟人，罪人。他的诸多身份注定相互矛盾，但它只自视为“海嗣”。海洋原本属于阿戈尔，直到玛利图斯将之用作哺育生机的养料。深蓝的残迹于是成了海的子嗣。",
      "attackType": null,
      "ability": null,
      "isInvalidKilled": false,
      "overrideKillCntInfos": {},
      "hideInHandbook": false,
      "hideInStage": true,
      "abilityList": [
        {
          "text": "不攻击，永久无敌",
          "textFormat": "NORMAL"
        },
        {
          "text": "周期性于自身位置召唤2个<单核掠食者>或<异光体掠食者>",
          "textFormat": "NORMAL"
        },
        {
          "text": "第一形态",
          "textFormat": "TITLE"
        },
        {
          "text": "【引导演化】周期性选择场上1个当前生命值最高的海怪使其进化：攻击力和生命值大幅度提升，攻击额外造成<$ba.dt.neural>神经损伤</>；其被击倒时自身流失一定比例的生命值",
          "textFormat": "NORMAL"
        },
        {
          "text": "第二形态",
          "textFormat": "TITLE"
        },
        {
          "text": "每有一个海怪被击倒时，自身流失一定比例的生命值",
          "textFormat": "NORMAL"
        },
        {
          "text": "每隔一段时间使所有海怪攻击力提升（可叠加）",
          "textFormat": "NORMAL"
        },
        {
          "text": "【哺育生机】一段时间内持续引导与所有海怪进行连接，每秒流失一定比例的最大生命值，期间使所有海怪敌人受到致命伤时不死亡，转而进入<$ba.sleep>沉睡</>且每秒回复一定比例的最大生命值。",
          "textFormat": "NORMAL"
        },
        {
          "text": "【人性之囚】选取一名我方干员，使其获得“生命值未满时不断流失生命值”和“所有技能自动开启”效果，持续一段时间；该干员撤退或被击倒时，所在地块及其周围四格变为不可部署",
          "textFormat": "NORMAL"
        }
      ],
      "linkEnemies": [
        "enemy_1433_dsbasi",
        "enemy_1433_dsbasi_2"
      ],
      "damageType": [
        "NO_DAMAGE"
      ],
      "invisibleDetail": false
    },
    "enemy_1557_trcerb": {
      "enemyId": "enemy_1557_trcerb",
      "enemyIndex": "DT",
      "enemyTags": null,
      "sortId": 1451,
      "name": "“三头犬”",
      "enemyLevel": "BOSS",
      "description": "饥肠辘辘的“三头犬”终于出现在了你的面前，每张嘴都等着吃顿饱饭，每张嘴都偏好不一样的口味。可别糊弄它！",
      "attackType": null,
      "ability": null,
      "isInvalidKilled": false,
      "overrideKillCntInfos": {},
      "hideInHandbook": false,
      "hideInStage": true,
      "abilityList": [
        {
          "text": "【挑剔食客】每个阶段开始时会清空<很大的锅>的食材，并且只有击败指定敌人才能添加食材，开饭可以直接满足它并跳过对应阶段",
          "textFormat": "NORMAL"
        },
        {
          "text": "未被打服而到达<很大的锅>时，若未做好饭，扣除一点目标生命",
          "textFormat": "NORMAL"
        },
        {
          "text": "根据<很大的锅>的食材量，使受到的物理与法术伤害减少，食材越少，受到的伤害越少",
          "textFormat": "NORMAL"
        },
        {
          "text": "生命值低于一半时狂暴，攻击力、移动速度大幅提升，且免疫大部分控制效果",
          "textFormat": "NORMAL"
        },
        {
          "text": "强行在锅中放入特殊食材，会生气且不再接受这顿饭，立即狂暴且受到的物理与法术伤害减少",
          "textFormat": "NORMAL"
        },
        {
          "text": "“要吃这个！”",
          "textFormat": "TITLE"
        },
        {
          "text": "【掠食】数次攻击后，下一次攻击造成更高物理伤害并减少目标防御力",
          "textFormat": "NORMAL"
        },
        {
          "text": "“要吃那个！”",
          "textFormat": "TITLE"
        },
        {
          "text": "【饥饿怒吼】大声吼叫，<$ba.stun>晕眩</>周围我方单位，且会立即惊醒全场<浆果虫>与<硕果虫>",
          "textFormat": "NORMAL"
        },
        {
          "text": "“开饭时刻到！”",
          "textFormat": "TITLE"
        },
        {
          "text": "【贪食之焰】对指定目标持续喷射火焰，造成越来越高的法术伤害，若目标在期间离场，则引发爆炸对目标周围造成大量法术伤害",
          "textFormat": "NORMAL"
        }
      ],
      "linkEnemies": [],
      "damageType": [
        "PHYSIC",
        "MAGIC"
      ],
      "invisibleDetail": false
    },
    "enemy_1558_sgactr": {
      "enemyId": "enemy_1558_sgactr",
      "enemyIndex": "ZYA",
      "enemyTags": null,
      "sortId": 1452,
      "name": "祖巴伊达姆，从往昔来",
      "enemyLevel": "BOSS",
      "description": "他代表过去站在这里，而他的背后就是未来的可能性。",
      "attackType": null,
      "ability": null,
      "isInvalidKilled": false,
      "overrideKillCntInfos": {},
      "hideInHandbook": false,
      "hideInStage": true,
      "abilityList": [
        {
          "text": "【晶体共振】位于结晶上时，受到的物理及法术伤害大幅降低",
          "textFormat": "NORMAL"
        },
        {
          "text": "第一形态",
          "textFormat": "TITLE"
        },
        {
          "text": "【晶格聚焦】周期性锁定场上至多三名友方单位，对其造成十字法术溅射伤害，并在周围四格的地块上生成结晶",
          "textFormat": "NORMAL"
        },
        {
          "text": "【晶体过载】周期性以自身为中心向四方向发射贯穿光线，对路径上所有友方单位造成法术伤害，并在沿途的地块上生成结晶",
          "textFormat": "NORMAL"
        },
        {
          "text": "第二形态",
          "textFormat": "TITLE"
        },
        {
          "text": "【全面防御】一段时间内持续施法，吸收场上至多15颗结晶的力量，施法完成时根据吸收结晶的数量，获得相当于自身最大生命值一定比例的物理法术屏障",
          "textFormat": "NORMAL"
        },
        {
          "text": "【坏点聚焦】一段时间内持续施法，吸收场上至多15颗结晶的力量，施法完成时根据吸收结晶的数量，锁定场上至多三名友方单位，对其造成十字法术溅射伤害",
          "textFormat": "NORMAL"
        }
      ],
      "linkEnemies": [],
      "damageType": [
        "MAGIC"
      ],
      "invisibleDetail": false
    },
    "enemy_1559_vtlionk": {
      "enemyId": "enemy_1559_vtlionk",
      "enemyIndex": "ALS",
      "enemyTags": null,
      "sortId": 1453,
      "name": "阿利斯泰尔，帝国余晖",
      "enemyLevel": "BOSS",
      "description": "帝国最后的余晖，生锈冠冕下的幽灵。反驳他，反驳维多利亚无上的荣光与权力，他会审视，他可以宽恕。",
      "attackType": null,
      "ability": null,
      "isInvalidKilled": false,
      "overrideKillCntInfos": {},
      "hideInHandbook": false,
      "hideInStage": true,
      "abilityList": [
        {
          "text": "生命值降至一半及以下时，防御力及法术抗性提升，【莫非王土】每次活化两件装备",
          "textFormat": "NORMAL"
        },
        {
          "text": "【斥退】战斗经过较长时间后，对全场我方单位造成法术溅射伤害, 并扣除所有目标生命",
          "textFormat": "NORMAL"
        },
        {
          "text": "【王权号令】锁定一个我方单位及其周围四格，对范围内目标造成一次高额物理伤害并在此范围内的地块上生成随机装备",
          "textFormat": "NORMAL"
        },
        {
          "text": "【莫非王土】场上存在装备时，使一件装备活化，不同的装备将产生不同效果。",
          "textFormat": "NORMAL"
        }
      ],
      "linkEnemies": [
        "enemy_10028_vtswd",
        "enemy_10029_vtshld",
        "enemy_10030_vtwand"
      ],
      "damageType": [
        "PHYSIC"
      ],
      "invisibleDetail": false
    },
    "enemy_1560_cnvlap": {
      "enemyId": "enemy_1560_cnvlap",
      "enemyIndex": "LOM",
      "enemyTags": null,
      "sortId": 1454,
      "name": "“狂欢之主”",
      "enemyLevel": "BOSS",
      "description": "狂欢之主终于登场，这场混乱的狂欢由她而始，也将由她亲手引领至高潮。漫长的狂欢，荒芜的玩笑。",
      "attackType": null,
      "ability": null,
      "isInvalidKilled": false,
      "overrideKillCntInfos": {},
      "hideInHandbook": false,
      "hideInStage": true,
      "abilityList": [
        {
          "text": "无法被阻挡，站在陆行舰上时视为空中单位，只受对空攻击影响；可操作浮游单元造成法术伤害",
          "textFormat": "NORMAL"
        },
        {
          "text": "平时优先攻击我方单位，对敌方单位伤害大幅度降低；狂欢时刻优先攻击敌方单位，对敌方单位伤害大幅度提升",
          "textFormat": "NORMAL"
        },
        {
          "text": "受到的物理和法术伤害大幅降低，狂欢结束时若击杀数低于我方则减伤失效一段时间",
          "textFormat": "NORMAL"
        },
        {
          "text": "第一形态",
          "textFormat": "TITLE"
        },
        {
          "text": "不移动，攻击造成法术伤害",
          "textFormat": "NORMAL"
        },
        {
          "text": "【与狼同舞】使浮游单元攻击范围扩大到全场，攻击力降低，锁定一个目标攻击，持续一段时间",
          "textFormat": "NORMAL"
        },
        {
          "text": "【焦点观众】蓄力一段时间后对目标及其周围所有单位造成大量法术伤害",
          "textFormat": "NORMAL"
        },
        {
          "text": "生命值首次降为0时，重生后进入第二形态，空降至地面，并加速点燃烟花发射器，若已经点燃则使其生命值回满",
          "textFormat": "NORMAL"
        },
        {
          "text": "第二形态",
          "textFormat": "TITLE"
        },
        {
          "text": "攻击造成物理伤害，可同时攻击2个目标",
          "textFormat": "NORMAL"
        },
        {
          "text": "狂欢时刻使所有我方干员与敌方单位血量大幅度上升，但防御力变为0",
          "textFormat": "NORMAL"
        },
        {
          "text": "【再登台】瞬移至下一个检查点，并对周围所有我方与敌方单位造成物理伤害；狂欢时刻瞬移间隔缩短",
          "textFormat": "NORMAL"
        },
        {
          "text": "【“观戏不语”】使攻击范围内2个我方单位无法开启技能，持续一段时间",
          "textFormat": "NORMAL"
        }
      ],
      "linkEnemies": [],
      "damageType": [
        "PHYSIC",
        "MAGIC"
      ],
      "invisibleDetail": false
    },
    "enemy_1561_crzjdg": {
      "enemyId": "enemy_1561_crzjdg",
      "enemyIndex": "AR",
      "enemyTags": null,
      "sortId": 1455,
      "name": "安纳斯塔西奥，赎罪者",
      "enemyLevel": "BOSS",
      "description": "安纳斯塔西奥二度复生，为的是活着赎清根植于他生命本质的罪。\n他羡慕无罪之人可以活着，也羡慕有罪之人可以死去。唯独他，既不得坦荡地活着，也不能安然地死去。",
      "attackType": null,
      "ability": null,
      "isInvalidKilled": false,
      "overrideKillCntInfos": {},
      "hideInHandbook": false,
      "hideInStage": true,
      "abilityList": [
        {
          "text": "未被阻挡时进行远程攻击，对目标及其周围八格内的所有我方单位造成物理伤害",
          "textFormat": "NORMAL"
        },
        {
          "text": "【福音泼洒】在攻击范围内快速轰击10次，对目标及其周围我方单位造成物理伤害和<$ba.dt.erosion>侵蚀损伤</>，优先攻击<$ba.dt.erosion>侵蚀损伤</>积累最少的我方单位",
          "textFormat": "NORMAL"
        },
        {
          "text": "第一形态",
          "textFormat": "TITLE"
        },
        {
          "text": "免疫盐漠影响，位于<盐坨子炮>周围八格时受到的物理与法术伤害大幅降低",
          "textFormat": "NORMAL"
        },
        {
          "text": "【寻觅罪孽】使攻击范围内一门<盐坨子炮>被强化，溅射范围扩大，持续一定时间",
          "textFormat": "NORMAL"
        },
        {
          "text": "生命值首次降为0时，跳至预定位置进入第二形态，并召唤<盐坨子炮>协助作战",
          "textFormat": "NORMAL"
        },
        {
          "text": "第二形态",
          "textFormat": "TITLE"
        },
        {
          "text": "免疫<$ba.stun>晕眩</>，移动速度提升，攻击速度提升",
          "textFormat": "NORMAL"
        },
        {
          "text": "其他敌人出场时，攻击力提升但每秒流失生命，持续一段时间",
          "textFormat": "NORMAL"
        },
        {
          "text": "未被阻挡时受到的物理与法术伤害大幅降低；被阻挡时，将场上所有<盐坨子炮>的轰炸中心移动到阻挡自身的目标所在位置",
          "textFormat": "NORMAL"
        },
        {
          "text": "【穿心救赎】每损失一定生命值时，能够穿过一次阻挡其的单位并对沿途目标造成物理伤害",
          "textFormat": "NORMAL"
        }
      ],
      "linkEnemies": [],
      "damageType": [
        "PHYSIC"
      ],
      "invisibleDetail": false
    },
    "enemy_1562_cjtaot": {
      "enemyId": "enemy_1562_cjtaot",
      "enemyIndex": "WY",
      "enemyTags": null,
      "sortId": 1456,
      "name": "无餍",
      "enemyLevel": "BOSS",
      "description": "自如梦方醒的岁的代理人心中诞生的化物，大口吞噬着失意之情。相聚是滋味，思念何尝不是？欢愉是滋味，悲切何尝不是？得意是滋味，悔恨何尝不是？",
      "attackType": null,
      "ability": null,
      "isInvalidKilled": false,
      "overrideKillCntInfos": {},
      "hideInHandbook": false,
      "hideInStage": true,
      "abilityList": [
        {
          "text": "【铜皮铁骨】受到的物理及法术伤害降低，进入暴食之欲形态后效果增强；自身受到<人间烟火>伤害后失去该效果一段时间，进入暴食之欲形态后失去效果的时间缩短",
          "textFormat": "NORMAL"
        },
        {
          "text": "【来者不拒】吸收所有附近的<饮啄>和<无谓>并为自身增加技力",
          "textFormat": "NORMAL"
        },
        {
          "text": "【嗜欲无穷】技力满时召唤<饮露餐风>对所有我方单位造成真实伤害",
          "textFormat": "NORMAL"
        },
        {
          "text": "忍饥之怒",
          "textFormat": "TITLE"
        },
        {
          "text": "【暴取豪夺】对范围内的1个我方单位喷吐酸液，酸液内的所有我方单位持续受到法术伤害",
          "textFormat": "NORMAL"
        },
        {
          "text": "【欲不可足】额外召唤<无谓>协助作战，进入暴食之欲形态后效果增强",
          "textFormat": "NORMAL"
        },
        {
          "text": "【贪念】生命值降为0时，召唤大量<无谓>协助作战，一段时间后进入暴食之欲形态",
          "textFormat": "NORMAL"
        },
        {
          "text": "暴食之欲",
          "textFormat": "TITLE"
        },
        {
          "text": "攻击力、攻击速度、防御力提升，变为远程攻击",
          "textFormat": "NORMAL"
        },
        {
          "text": "【聚敛无厌】将场上所有的<饮啄>都转化为<无谓>，每隔一段时间将场上所有的<无谓>吸向自己，技能期间免疫控制效果且每吸入1个<无谓>都会为自身回复生命值",
          "textFormat": "NORMAL"
        },
        {
          "text": "【吞山吐海】召唤<湮没之口>和<造化之口>协助作战",
          "textFormat": "NORMAL"
        }
      ],
      "linkEnemies": [
        "enemy_10060_cjbfod",
        "enemy_10059_cjgfod",
        "enemy_10063_cjdoor",
        "enemy_10063_cjdoor_2",
        "enemy_10062_cjblon"
      ],
      "damageType": [
        "MAGIC"
      ],
      "invisibleDetail": false
    },
    "enemy_1563_fthlgj": {
      "enemyId": "enemy_1563_fthlgj",
      "enemyIndex": "DR",
      "enemyTags": null,
      "sortId": 1457,
      "name": "“万火归一”",
      "enemyLevel": "BOSS",
      "description": "盘踞于原野之上，永不离去的红龙先祖，抑或只是众心所向的还火之地。新火不断被抛掷于旧火之上，一切终结，同时一切诞生。",
      "attackType": null,
      "ability": null,
      "isInvalidKilled": false,
      "overrideKillCntInfos": {},
      "hideInHandbook": false,
      "hideInStage": true,
      "abilityList": [
        {
          "text": "可对地块释放【炽心】，使位于其中的我方单位每秒受到法术伤害和<$ba.dt.burning>灼燃损伤</>",
          "textFormat": "NORMAL"
        },
        {
          "text": "【渴盼】不在我方单位攻击范围时，攻击速度提升",
          "textFormat": "NORMAL"
        },
        {
          "text": "【归来】处于【炽心】中时，受到的物理及法术伤害大幅降低",
          "textFormat": "NORMAL"
        },
        {
          "text": "旋转",
          "textFormat": "TITLE"
        },
        {
          "text": "【赐火】攻击数次后，下一次对目标和周围的所有我方单位造成法术伤害和<$ba.dt.burning>灼燃损伤</>，并对受到影响的地块释放【炽心】，优先选择不处于【炽心】中的我方单位",
          "textFormat": "NORMAL"
        },
        {
          "text": "【焚光】使场上攻击力最高的干员<$ba.stun>晕眩</>并丢失视野，并在其周围8格召唤<旧日之火>",
          "textFormat": "NORMAL"
        },
        {
          "text": "生命值降为0时，进入慢步形态",
          "textFormat": "NORMAL"
        },
        {
          "text": "慢步",
          "textFormat": "TITLE"
        },
        {
          "text": "在周围召唤<旧日之火>并持续恢复生命值，若生命值恢复满时场上不存在任何<旧日之火>，则进入最后一舞形态；否则，消灭所有<旧日之火>并回到旋转形态",
          "textFormat": "NORMAL"
        },
        {
          "text": "最后一舞",
          "textFormat": "TITLE"
        },
        {
          "text": "飞行单位，攻击力提升",
          "textFormat": "NORMAL"
        },
        {
          "text": "【炽焰燃烧】周期性起飞，锁定最多两名处在【炽心】中的我方干员，对其最近三排的所有我方单位造成法术伤害和<$ba.dt.burning>灼燃损伤</>，并对受到影响的地块释放【炽心】",
          "textFormat": "NORMAL"
        }
      ],
      "linkEnemies": [],
      "damageType": [
        "MAGIC"
      ],
      "invisibleDetail": false
    },
    "enemy_1564_mpprts": {
      "enemyId": "enemy_1564_mpprts",
      "enemyIndex": "RI1",
      "enemyTags": null,
      "sortId": 1458,
      "name": "PRTS，“源代码”",
      "enemyLevel": "BOSS",
      "description": "PRTS的原始代码覆写了权限，它开始抹除你们在罗德岛上留存的一切痕迹。",
      "attackType": null,
      "ability": null,
      "isInvalidKilled": false,
      "overrideKillCntInfos": {},
      "hideInHandbook": false,
      "hideInStage": true,
      "abilityList": [
        {
          "text": "【安全待机模式】未击倒场上的<拟态机械>时，<PRTS，“源代码”>不可被攻击。",
          "textFormat": "NORMAL"
        },
        {
          "text": "【危机响应模式】<拟态机械>倒地复原期间，<PRTS，“源代码”>每受到一次伤害，<拟态机械>的复原时间缩短1秒",
          "textFormat": "NORMAL"
        },
        {
          "text": "【热重启模式】<拟态机械>被击倒时，部署费用的回复速度大幅提高",
          "textFormat": "NORMAL"
        },
        {
          "text": "【清除协议】<PRTS，“源代码”>在场上存在较长时间后，扣除所有目标生命值",
          "textFormat": "NORMAL"
        }
      ],
      "linkEnemies": [
        "enemy_1565_mpprme"
      ],
      "damageType": [
        "MAGIC"
      ],
      "invisibleDetail": false
    },
    "enemy_1565_mpprme": {
      "enemyId": "enemy_1565_mpprme",
      "enemyIndex": "RI2",
      "enemyTags": null,
      "sortId": 1459,
      "name": "拟态机械",
      "enemyLevel": "BOSS",
      "description": "PRTS将存储数据中罗德岛的熟悉之物变成了实体的威胁，绝对理性的机械不会理解何为恐惧。",
      "attackType": null,
      "ability": null,
      "isInvalidKilled": false,
      "overrideKillCntInfos": {},
      "hideInHandbook": false,
      "hideInStage": true,
      "abilityList": [
        {
          "text": "【“重构”】<PRTS，“源代码”>未被击败时，<拟态机械>每次被击倒后都会复原，并且每次复原后攻击力会提升，最多提升5次",
          "textFormat": "NORMAL"
        },
        {
          "text": "【限制写入】出场后封锁我方待部署区部署费用最高的4名干员一段时间。第一次复原后将获得强化，封锁更多功能",
          "textFormat": "NORMAL"
        },
        {
          "text": "【重离子弹性反冲】选择距离自身最近的单位为目标，发射一枚光球向目标缓慢飞行，命中目标后造成法术溅射伤害；光球飞行时间越久，造成的伤害越低、溅射范围越小",
          "textFormat": "NORMAL"
        },
        {
          "text": "【动态部署】被<PRTS，“源代码”>抓取转化为<$ba.float>近地悬浮</>，攻击范围扩大，攻击间隔缩短，并且同时攻击两个目标；<拟态机械>受到一定伤害后会被提前击落。第一次复原后将获得强化",
          "textFormat": "NORMAL"
        },
        {
          "text": "【链式反应】第一次复原后可以释放；被<PRTS，“源代码”>抓取转化为<$ba.float>近地悬浮</>，选择场上所有处于中立或者被PRTS激活的弱化节点为目标发射一束光线，对光线路径上的单位造成伤害；<拟态机械>受到一定伤害后会被提前击落",
          "textFormat": "NORMAL"
        }
      ],
      "linkEnemies": [
        "enemy_1564_mpprts"
      ],
      "damageType": [
        "MAGIC"
      ],
      "invisibleDetail": false
    },
    "enemy_1566_mpascl": {
      "enemyId": "enemy_1566_mpascl",
      "enemyIndex": "AC",
      "enemyTags": null,
      "sortId": 1460,
      "name": "“阿斯卡纶”",
      "enemyLevel": "BOSS",
      "description": "“弑君之刀剑，诛王之枪矛”？不，你只是我记忆中那个她。",
      "attackType": null,
      "ability": null,
      "isInvalidKilled": false,
