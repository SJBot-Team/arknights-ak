    "enemy_2126_dycyue": {
      "enemyId": "enemy_2126_dycyue",
      "enemyIndex": "SQ",
      "enemyTags": null,
      "sortId": 1562,
      "name": "朔壳",
      "enemyLevel": "BOSS",
      "description": "一具被生生夺走，用以隐藏所有恶意与怨愤的躯壳。它原来的主人已陷入永眠，取而代之的是——",
      "attackType": null,
      "ability": null,
      "isInvalidKilled": false,
      "overrideKillCntInfos": {},
      "hideInHandbook": false,
      "hideInStage": true,
      "abilityList": [
        {
          "text": "【暴武】有一定概率闪避非自身阻挡单位的物理和法术伤害。待部署区每有一张“宿傲”，自身攻击力提升",
          "textFormat": "NORMAL"
        },
        {
          "text": "【醉生】往待部署区加入一张“宿傲”",
          "textFormat": "NORMAL"
        },
        {
          "text": "【溯律】在自身所在位置生成“敛傲”。待部署区每有一张“宿傲”， 额外生成一枚“敛傲”",
          "textFormat": "NORMAL"
        },
        {
          "text": "【描躯】在场上召唤一节“身形”，使位于其上的目标单位强制撤退。“身形”在场时，自身无法被攻击",
          "textFormat": "NORMAL"
        }
      ],
      "linkEnemies": [
        "enemy_2130_dyswrd",
        "enemy_2128_dysuib"
      ],
      "damageType": [
        "PHYSIC"
      ],
      "invisibleDetail": false
    },
    "enemy_2127_dysuih": {
      "enemyId": "enemy_2127_dysuih",
      "enemyIndex": "WQH",
      "enemyTags": null,
      "sortId": 1563,
      "name": "妄躯",
      "enemyLevel": "BOSS",
      "description": "——苏醒的祂。",
      "attackType": null,
      "ability": null,
      "isInvalidKilled": false,
      "overrideKillCntInfos": {},
      "hideInHandbook": false,
      "hideInStage": true,
      "abilityList": [
        {
          "text": "【知意】场上每存在一节“身形”，自身受到的物理与法术伤害降低50％",
          "textFormat": "NORMAL"
        },
        {
          "text": "【谋炎】往待部署区加入一张“宿怒”",
          "textFormat": "NORMAL"
        },
        {
          "text": "【筑基】在场上召唤一节“身形”；每损失一定生命值，在场上召唤“身形”",
          "textFormat": "NORMAL"
        },
        {
          "text": "【灸灼】在自身所在位置生成“愠怒”。待部署区每有一张“宿怒”， 额外生成一枚“愠怒”",
          "textFormat": "NORMAL"
        },
        {
          "text": "【织牢】持续施法，生成多枚“愠怒”攻击目标",
          "textFormat": "NORMAL"
        },
        {
          "text": "战斗经过较长时间后，退场并扣除50点目标生命",
          "textFormat": "NORMAL"
        }
      ],
      "linkEnemies": [
        "enemy_2131_dyfire",
        "enemy_2128_dysuib"
      ],
      "damageType": [
        "MAGIC"
      ],
      "invisibleDetail": false
    },
    "enemy_2138_shdbjg": {
      "enemyId": "enemy_2138_shdbjg",
      "enemyIndex": "JC",
      "enemyTags": null,
      "sortId": 1564,
      "name": "汉科",
      "enemyLevel": "BOSS",
      "description": "他的暴力与他的统治不容置疑，他就是玻利瓦尔。他容许所有异见者站到他的面前，然后告诉他们这一事实。如今，人们不再记得曾有这样一名短暂地击败一切并团结一切的将军，只有黑流树海记得。",
      "attackType": null,
      "ability": null,
      "isInvalidKilled": false,
      "overrideKillCntInfos": {},
      "hideInHandbook": false,
      "hideInStage": true,
      "abilityList": [
        {
          "text": "出场时，在数个地块释放烟雾，烟雾中的全体单位获得<$ba.invisible>隐匿</>，自身攻击无视<$ba.invisible>隐匿</>或<$ba.camou>迷彩</>",
          "textFormat": "NORMAL"
        },
        {
          "text": "周期性发射照明弹造成群体物理伤害，照明弹会暂时驱散所在烟雾，并使其中所有单位的<$ba.invisible>隐匿</>和<$ba.camou>迷彩</>失效",
          "textFormat": "NORMAL"
        },
        {
          "text": "被阻挡时可以快速移动至其身后",
          "textFormat": "SILENCE"
        }
      ],
      "linkEnemies": [],
      "damageType": [
        "PHYSIC"
      ],
      "invisibleDetail": false
    },
    "enemy_2139_shdbj2": {
      "enemyId": "enemy_2139_shdbj2",
      "enemyIndex": "CDL",
      "enemyTags": null,
      "sortId": 1565,
      "name": "“大总统”汉科",
      "enemyLevel": "BOSS",
      "description": "他的荣耀与他的妥协皆是为了玻利瓦尔，在他的意志中没有一丝虚假与谎言。而他也终将遭受背叛，又或许他自己正是那名最可耻的背叛者。谁才有资格来裁定这件事？",
      "attackType": null,
      "ability": null,
      "isInvalidKilled": false,
      "overrideKillCntInfos": {},
      "hideInHandbook": false,
      "hideInStage": true,
      "abilityList": [
        {
          "text": "出场时，在数个地块释放烟雾，烟雾中的全体单位获得<$ba.invisible>隐匿</>，自身攻击无视<$ba.invisible>隐匿</>或<$ba.camou>迷彩</>",
          "textFormat": "NORMAL"
        },
        {
          "text": "周期性发射照明弹造成群体物理伤害，照明弹会暂时驱散所在烟雾，并使其中所有单位的<$ba.invisible>隐匿</>和<$ba.camou>迷彩</>失效",
          "textFormat": "NORMAL"
        },
        {
          "text": "被阻挡时可以快速移动至其身后，冷却时间更短",
          "textFormat": "SILENCE"
        }
      ],
      "linkEnemies": [],
      "damageType": [
        "PHYSIC"
      ],
      "invisibleDetail": false
    },
    "enemy_2140_shsgzd": {
      "enemyId": "enemy_2140_shsgzd",
      "enemyIndex": "DLN",
      "enemyTags": null,
      "sortId": 1566,
      "name": "德莱昂",
      "enemyLevel": "BOSS",
      "description": "“发现”玻利瓦尔之人。他给这片土地带来了许多稀奇的商品，却只是运走了“一些”对这里的人们无用的赤金和蔗糖，开创了富庶的黄金时代。遗憾的是，玻利瓦尔人并不会永远记得他的功绩，只有黑流树海记得。",
      "attackType": null,
      "ability": null,
      "isInvalidKilled": false,
      "overrideKillCntInfos": {},
      "hideInHandbook": false,
      "hideInStage": true,
      "abilityList": [
        {
          "text": "受到伤害时飞行一段时间，移动速度提升",
          "textFormat": "NORMAL"
        },
        {
          "text": "处于近地悬浮时，会持续轰炸造成群体物理伤害",
          "textFormat": "NORMAL"
        },
        {
          "text": "接触赤金条时将其夺取，自身离场",
          "textFormat": "NORMAL"
        },
        {
          "text": "赤金条不在场时，自身免疫<$ba.stun>晕眩</>、<$ba.frozen>冻结</>、<$ba.fear>恐惧</>，攻击力提升，能够更频繁地起飞",
          "textFormat": "NORMAL"
        }
      ],
      "linkEnemies": [
        "enemy_2142_shsggd"
      ],
      "damageType": [
        "PHYSIC"
      ],
      "invisibleDetail": false
    },
    "enemy_2141_shsgz2": {
      "enemyId": "enemy_2141_shsgz2",
      "enemyIndex": "RCS",
      "enemyTags": null,
      "sortId": 1567,
      "name": "“征服者”德莱昂",
      "enemyLevel": "BOSS",
      "description": "我们都知道他与萨尔贡的贝亚德帕夏一同开创了一条铺满黄金的商路，让伊比利亚与萨尔贡变得越发熠熠生辉。只是我们未尝知晓，他在这片沃土上究竟“征服”了怎样的困难艰险。",
