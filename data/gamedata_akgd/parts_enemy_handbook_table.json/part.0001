    "enemy_6020_orang": {
      "enemyId": "enemy_6020_orang",
      "enemyIndex": "DL20",
      "enemyTags": null,
      "sortId": 1599,
      "name": "“烈酒金刚”",
      "enemyLevel": "BOSS",
      "description": "由烈酒协会集众工程师之力研发的“真正终极自走机械”，拥有“能同时捏瘪十个酒罐”的惊人力量。遵从与阿卡胡拉的环保约定，身上的护甲用回收的酒罐制成。它被认为是本届赛事最具实力的冠军争夺者，但由于决赛前开的香槟渗入了控制芯片中，上场后它彻底陷入疯狂。",
      "attackType": null,
      "ability": null,
      "isInvalidKilled": false,
      "overrideKillCntInfos": {},
      "hideInHandbook": false,
      "hideInStage": true,
      "abilityList": [
        {
          "text": "免疫<$ba.stun>晕眩</>、<$ba.frozen>冻结</>、<$ba.levitate>浮空</>、<$ba.sleep>沉睡</>；受到<蜜酿万岁！>影响后以上免疫效果失效一段时间",
          "textFormat": "NORMAL"
        },
        {
          "text": "每次攻击后攻击力提升（有层数上限），连续一段时间不攻击则重置",
          "textFormat": "NORMAL"
        },
        {
          "text": "【桶陈蜜酿】每损失一定比例生命值，选择一名我方干员向其投掷一份<桶陈蜜酿>，<桶陈蜜酿>存在时该干员始终<$ba.stun>晕眩</>。<桶陈蜜酿>可被我方攻击并在被击倒后变为<蜜酿万岁！>加入待部署区",
          "textFormat": "NORMAL"
        },
        {
          "text": "每隔一段时间选择一个我方单位，较长延迟后对目标投掷易拉罐，造成物理溅射伤害和<$ba.stun>晕眩</>",
          "textFormat": "NORMAL"
        }
      ],
      "linkEnemies": [
        "enemy_6021_cask"
      ],
      "damageType": [
        "PHYSIC"
      ],
      "invisibleDetail": false
    },
    "enemy_6021_cask": {
      "enemyId": "enemy_6021_cask",
      "enemyIndex": "DL21",
      "enemyTags": null,
      "sortId": 1600,
      "name": "桶陈蜜酿",
      "enemyLevel": "NORMAL",
      "description": "在木桶中存放超过十年的优质蜜酿，花香馥郁。烈酒协会当年将其盗走是为了打击蜜酿协会的势力，没想到却导致部分成员叛变，掀起了一阵腥风血雨。现在，它们成了烈酒协会报复的武器。",
      "attackType": null,
      "ability": null,
      "isInvalidKilled": false,
      "overrideKillCntInfos": {},
      "hideInHandbook": false,
      "hideInStage": true,
      "abilityList": [
        {
          "text": "更容易受到攻击，在场时使目标干员始终<$ba.stun>晕眩</>；被击倒后变为<蜜酿万岁！>加入待部署区",
          "textFormat": "NORMAL"
        }
      ],
      "linkEnemies": [
        "enemy_6020_orang"
      ],
