dslb.com/bfs/new_dyn/e6d3e6d177c0e9aed9a9e4b5adf46ed5374873950.jpg"],"publish_time":1746296293,"ctime":1746333932,"mtime":1746544262,"stats":{"view":10444,"favorite":135,"like":318,"dislike":0,"reply":55,"share":1,"coin":12,"dynamic":0},"attributes":128,"words":2590,"origin_image_urls":["https://i0.hdslb.com/bfs/new_dyn/e6d3e6d177c0e9aed9a9e4b5adf46ed5374873950.jpg"],"list":null,"is_like":false,"media":{"score":0,"media_id":0,"title":"","cover":"","area":"","type_id":0,"type_name":"","spoiler":0},"apply_time":"","check_time":"","original":1,"act_id":0,"dispute":null,"authenMark":null,"cover_avid":0,"top_video_info":null,"type":3,"check_state":0,"origin_template_id":4},{"id":40096251,"category":{"id":8,"parent_id":1,"name":"手机游戏"},"categories":[{"id":1,"parent_id":0,"name":"游戏"},{"id":8,"parent_id":1,"name":"手机游戏"}],"title":"三笙仙术杯温蒂推大特哪里出了错？logos为何推完打不到？数据化详解磕墙这回事","summary":"在昨天的仙术杯比赛中，选手三笙将温蒂推至墙边，从而让高台的logos可以打到大特，以及使温蒂站在围墙位和水泡完成并排双推索敌。推到墙边的怪可以被打到，这是一个大众已经习以为常的现象。但是奇怪的是，在温蒂第二次双推之后，logos不再能打到大特了。要解释这个问题，我们需要深入的，精确的去分析，\"磕墙\"和\"能打到\"究竟是怎么一回事。一:碰撞箱的种类，功能，形状虽然碰撞箱一词经常被人挂在嘴边，在推拉磕墙和敌人被攻击的时候都会提到这个概念。但是实际上，两个行为是由不同的碰撞箱完成的。(特别强调阻挡和碰撞箱无关)碰","banner_url":"","template_id":4,"state":0,"author":{"mid":374873950,"name":"神祇读神奇","face":"https://i1.hdslb.com/bfs/face/2421b44f43bc4101920130469607d095f4c2b452.jpg","pendant":{"pid":0,"name":"","image":"","expire":0},"official_verify":{"type":-1,"desc":""},"nameplate":{"nid":0,"name":"","image":"","image_small":"","level":"","condition":""},"vip":{"type":2,"status":1,"due_date":0,"vip_pay_type":0,"theme_type":0,"label":{"path":"http://i0.hdslb.com/bfs/vip/label_annual.png","text":"年度大会员","label_theme":"annual_vip"},"avatar_subscript":1,"nickname_color":"#FB7299"}},"reprint":1,"image_urls":["https://i0.hdslb.com/bfs/new_dyn/eb1e02078cca71565372d5c73de5c125374873950.png"],"publish_time":1734210814,"ctime":1734210814,"mtime":1734248197,"stats":{"view":33517,"favorite":453,"like":1151,"dislike":0,"reply":67,"share":139,"coin":29,"dynamic":0}